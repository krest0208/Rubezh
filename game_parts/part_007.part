bjective": "Einen Durchbruch zur Feldkreuzung verhindern.", "tip": "Flächenfeuer mit Panzerabwehr kombinieren. Beschädigte Stellungen zwischen den Wellen reparieren; bezahlte Unterstützung ist nicht erforderlich.", "outro": "Die Linie hält. Eine weitere gehaltene Straße wird im Kompaniebuch vermerkt. Feldkreuzung · D-167.", "letter": "Feldkreuzung · D-167. Below sagt, eine gute Stellung beginne mit der Sorge um die nächste Bedienung.", "waves": 40, "id": 766, "rank": 24.91992, "firstReward": 364, "repeatReward": 173, "layoutSeed": 38342, "original": false, "legacyId": null, "sector": 8, "orderInChapter": 167, "pressure": 2.545 }, { "title": "Draht durch den Wald · D-168", "place": "Raum Kyjiw", "date": "November 1943", "chapter": 3, "theme": "ruins", "map": 20, "weather": "rain", "trait": "convoy", "base": "Draht durch den Wald", "quote": "", "story": "Die Kompanie kehrt auf vertrauten Wegen zurück. Alte Straßen müssen erneut geräumt und gegen Gegenangriffe gesichert werden. Die Nachbarkompanie bittet darum, den Durchgang noch etwas länger zu halten. Below stellt Reservekisten neben die Geschütze und mahnt, nicht zu früh zu schießen. Abschnitt D-168. Abschnittsbefehl: Das Verlegen einer neuen Telefonleitung decken.", "objective": "Das Verlegen einer neuen Telefonleitung decken.", "tip": "Flächenfeuer mit Panzerabwehr kombinieren. Beschädigte Stellungen zwischen den Wellen reparieren; bezahlte Unterstützung ist nicht erforderlich.", "outro": "Die Linie hält. Eine weitere gehaltene Straße wird im Kompaniebuch vermerkt. Draht durch den Wald · D-168.", "letter": "Draht durch den Wald · D-168. Below sagt, eine gute Stellung beginne mit der Sorge um die nächste Bedienung.", "waves": 38, "id": 767, "rank": 24.95245, "firstReward": 356, "repeatReward": 169, "layoutSeed": 38379, "original": false, "legacyId": null, "sector": 8, "orderInChapter": 168, "pressure": 2.547 }, { "title": "Pionierpatrouille · D-169", "place": "Raum Kyjiw", "date": "November 1943", "chapter": 3, "th