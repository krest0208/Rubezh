nal": false, "legacyId": null, "sector": 6, "orderInChapter": 135, "pressure": 2.884 }, { "title": "Holzkolonne · E-136", "place": "Oderabschnitt", "date": "April 1945", "chapter": 4, "theme": "mud", "map": 6, "weather": "rain", "trait": "scouts", "base": "Holzkolonne", "quote": "", "story": "Der Postsack wird leichter, doch die Kolonnen brauchen weiterhin eine sichere Straße. Die Kompanie hält ihr Versprechen vom ersten Tag. Eine kleine Brücke hat unter der Last nachgegeben. Below lässt einen Reparaturtrupp dort. Die Bedienungen besetzen ihre vertrauten Stellungen. Jeder kennt seinen Straßenabschnitt. Abschnitt E-136. Abschnittsbefehl: Baumaterial durch eine gefährliche Kurve geleiten.", "objective": "Baumaterial durch eine gefährliche Kurve geleiten.", "tip": "Flächenfeuer mit Panzerabwehr kombinieren. Beschädigte Stellungen zwischen den Wellen reparieren; bezahlte Unterstützung ist nicht erforderlich.", "outro": "Die Linie hält. Pioniere räumen die Sperren für die eigenen Fahrzeuge. Holzkolonne · E-136.", "letter": "Holzkolonne · E-136. Below sagt, eine gute Stellung beginne mit der Sorge um die nächste Bedienung.", "waves": 44, "id": 935, "rank": 30.41792, "firstReward": 409, "repeatReward": 196, "layoutSeed": 44595, "original": false, "legacyId": null, "sector": 6, "orderInChapter": 136, "pressure": 2.886 }, { "title": "Kurierroute · E-137", "place": "Oderabschnitt", "date": "April 1945", "chapter": 4, "theme": "mud", "map": 16, "weather": "rain", "trait": "supplies", "base": "Kurierroute", "quote": "", "story": "Der Postsack wird leichter, doch die Kolonnen brauchen weiterhin eine sichere Straße. Die Kompanie hält ihr Versprechen vom ersten Tag. Eine kleine Brücke hat unter der Last nachgegeben. Below lässt einen Reparaturtrupp dort. Die Bedienungen besetzen ihre vertrauten Stellungen. Jeder kennt seinen Straßenabschnitt. Abschnitt E-137. Abschnittsbefehl: Den Weg für Kuriere und Feldpost offen halten.", "objective": "Den Weg für Kuriere und Feldpost offen halten.", "tip": "Flächenfeuer mit Panzerabwehr kombinieren. Beschädigte Stellungen zwischen den Wellen reparieren; bezahlte Unterstützung ist nicht erforderlich.", "outro": "Die Linie hält. Hinter der Kurve hupt der letzte Lastwagen. Kurierroute · E-137.", "letter": "Kurierroute · E-137. Below sagt, eine gute Stellung beginne mit der Sorge um die nächste Bedienung.", "waves": 44, "id": 936, "rank": 30.45045, "firstReward": 409, "repeatReward": 196, "layoutSeed": 44632, "original": false, "legacyId": null, "sector": 6, "orderInChapter": 137, "pressure": 2.888 }, { "title": "Die steinerne Überführung", "place": "Oderabschnitt", "date": "April 1945", "chapter": 4, "theme": "autumn", "map": 11, "weather": "rain", "trait": "elite", "base": "Halte die Straße vor der Überführung", "quote": "„Wir halten nicht für ein Zeichen auf der Karte.“", "story": "Unter der Überführung fahren Trosswagen hindurch. Below wählt Stellungen, die den engen Durchgang abschirmen. Hinter der Linie brauchen Menschen Ruhe und Zeit. Vor ihr liegt eine Straße, die nicht offen bleiben darf.", "objective": "Halte die Straße vor der Überführung.", "tip": "Du beginnst mit mehr Nachschub. Decke erst mehrere Abschnitte ab und verbessere dann Stellungen.", "outro": "Die Bedienungen ziehen erst nach dem Abschlusssignal ab. Below markiert „Die steinerne Überführung“ auf ihrer Wegkarte.", "letter": "„Die steinerne Überführung.“ Ich werde nicht den Kampflärm erinnern, sondern die Scheinwerfer des Wagens, der unsere Linie passierte.", "waves": 50, "id": 937, "rank": 30.48298, "firstReward": 433, "repeatReward": 208, "legacyId": 140, "layoutSeed": 140, "original": true, "sector": 6, "orderInChapter": 138, "pressure": 2.89 }, { "title": "Reparaturhof · E-139", "place": "Oderabschnitt", "date": "April 1945", "chapter": 4, "theme": "autumn", "map": 12, "weather": "rain", "trait": "armor", "base": "Reparaturhof", "quote": "", "story": "Der Postsack wird leichter, doch die Kolonnen brauchen weiterhin eine sichere Stra