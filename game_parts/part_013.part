        settings: '<circle cx="12" cy="12" r="4"/><path d="m9 3 1-1h4l1 3 3 1 3 2-1 4 1 3-3 3-3 1-1 3h-4l-1-3-3-1-3-3 1-3-1-3 3-3z"/>',
        eye: '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
        medal: '<path d="m7 2 5 7 5-7M4 2l5 10m11-10-5 10"/><circle cx="12" cy="15" r="6"/><path d="m12 12 1 2 2 1-2 1-1 2-1-2-2-1 2-1z"/>',
        shield: '<path d="M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6z"/><path d="m8 12 3 3 5-6"/>',
        pause: '<path d="M8 5v14M16 5v14" stroke-width="4"/>',
        play: '<path d="m8 5 11 7-11 7z" fill="currentColor" stroke="none"/>',
        back: '<path d="m14 5-7 7 7 7M7 12h14"/>',
        cross: '<path d="m6 6 12 12M18 6 6 18"/>',
        sound: '<path d="M4 9h4l5-4v14l-5-4H4zM17 8c2 2 2 6 0 8M20 5c4 4 4 10 0 14"/>',
        mute: '<path d="M4 9h4l5-4v14l-5-4H4zM17 9l5 6m0-6-5 6"/>',
        shell: '<path d="m8 18 10-10c2-2 2-5 2-5s-3 0-5 2L5 15zM5 15l-2 5 5-2M12 8l4 4"/><path d="M14 20h7M19 15v7"/>',
        wrench: '<path d="M14 5a6 6 0 0 0-7 7l-4 6a2 2 0 0 0 3 3l6-5a6 6 0 0 0 7-7l-4 3-3-3z"/>',
        flag: '<path d="M5 22V3m0 1c5-4 8 4 15 0v10c-7 4-10-4-15 0"/>',
        star: '<path d="m12 2 3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z"/>',
        crate: '<path d="M3 7h18v14H3zM3 7l9-4 9 4M8 7v14M16 7v14M3 12h18"/>',
        signal: '<path d="M12 12v10M7 22h10M8 8a6 6 0 0 0 0 8m8-8a6 6 0 0 1 0 8M4 4a11 11 0 0 0 0 16m16-16a11 11 0 0 1 0 16"/><circle cx="12" cy="12" r="2"/>',
        book: '<path d="M3 4h7l2 2 2-2h7v15h-7l-2 2-2-2H3zM12 6v15"/>',
        heart: '<path d="M12 21 3 12C-2 4 8 0 12 7c4-7 14-3 9 5z"/>'
    };
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (paths[name] || paths.shield) + '</svg>';
}
const TOWERS = [
    { id: 'mg', name: L('Пулемёт'), cost: 90, range: 151, damage: 10, rate: .19, pen: .02, unlock: 0, desc: L('Частый огонь по пехоте. Почти не пробивает тяжёлую броню.') },
    { id: 'rifle', name: L('Стрелки'), cost: 120, range: 200, damage: 49, rate: 1.05, pen: .18, unlock: 0, desc: L('Дальний прицельный огонь. В первую очередь перехватывают быстрые цели.') },
