const MISSIONS = selectedCampaign.missions, CHAPTERS = selectedCampaign.chapters;
const SCALE_STRINGS = { "ru": { "sector": "Участок", "mission": "Миссия", "chapter": "Глава", "page": "Лист карты", "previous": "Назад", "next": "Далее", "go": "К текущей миссии", "completed": "Пройдено", "open": "В бой", "locked": "Закрыто", "campaignNote": "200 миссий в главе. На одном листе — 20. Новые участки открываются по мере побед.", "migrated": "Прогресс перенесён. Старые победы, монеты и улучшения сохранены; добавленные миссии можно пройти отдельно.", "briefScale": "Сила наступления", "enemyPressure": "Давление", "optional": "Постоянные навыки и платная поддержка необязательны.", "chapters": ["Рота ещё учится держать дорогу в часы отступления. За каждым оставленным перекрёстком остаются люди, которым нужно время.", "Теперь расчёты действуют сообща. Каждая новая позиция должна дать соседнему подразделению возможность закрепиться.", "Путь снабжения стал тонкой нитью между передовой и тылом. Даже небольшой обходной участок нельзя оставлять без защиты.", "Рота возвращается по знакомым направлениям. Старые дороги приходится расчищать заново и удерживать от встречных ударов.", "Почтовая сумка становится легче, но колоннам всё ещё нужна безопасная дорога. Рота доводит до конца обещание первого дня."], "names": ["Молчание эфира", "Госпитальный поворот", "Ящики у дороги", "Лесовозная колонна", "Курьерский маршрут", "Водокачка", "Ремонтный двор", "Полевой перекрёсток", "Провод через лес", "Сапёрный дозор", "Мельничный тракт", "Пункт сбора", "Наблюдательный пост", "Машина с деталями", "Продовольственный склад", "Подход к переправе", "Укрытие у дороги", "Полевая кухня", "Промежуточная база", "Расчистка завала"], "tasks": ["Прикрыть связистов, пока они восстанавливают радиопост.", "Удержать дорогу для санитарных машин.", "Защитить разгрузку боеприпасов у просёлка.", "Провести колонну со стройматериалами через опасный поворот.", "Сохранить проход для курьеров и полевой почты.", "Дать водовозам закончить загрузку у водокачки.", "Оборонять ремонтную площадку до выхода последней машины.", "Не допустить прорыва к полевому перекрёстку.", "Прикрыть прокладку нового телефонного провода.", "Удержать дорогу, пока сапёры проверяют следующий участок.", "Защитить подвоз муки и продовольствия.", "Сохранить путь от пункта сбора к тылу.", "Оборонять подходы к наблюдательному посту.", "Прикрыть грузовик с запасными частями.", "Удержать дорогу к продовольственному складу.", "Защитить подход к переправе от встречного удара.", "Прикрыть временное укрытие у дороги.", "Не дать перерезать путь к полевой кухне.", "Защитить промежуточную базу снабжения.", "Выиграть время для расчистки завала на дороге."], "incidents": ["Разведка обнаружила движение на соседнем просёлке: обходной путь больше не безопасен.", "Передняя машина остановилась с поломкой, и колонна растянулась у поворота.", "Провод оборван. До восстановления связи расчёты ориентируются по сигнальным флажкам.", "Ночной дозор принёс схему нового подхода противника к дороге.", "В тыл уходит группа раненых; торопить её нельзя.", "Один из мостков просел под грузом. Белов оставляет у него ремонтную группу.", "На карте этот поворот отмечен неверно. Разведчики уточняют маршрут прямо перед боем.", "Последний грузовик ещё не пришёл, и отходить с позиции рано.", "Водители меняют колесо на обочине, прикрывая фонари плащ-палатками.", "Дежурный слышит двигатели за рощей. Времени на перенос грузов уже не остаётся.", "Из соседней роты приходит просьба удержать проход ещё немного.", "Запасной путь оказался завален. Весь поток придётся пропустить через этот рубеж."], "actors": ["Соколов распределяет сектора огня, а Белов проверяет укрытия расчётов.", "Нина отмечает безопасные повороты на карте и передаёт короткий приказ.", "Белов ставит запасные ящики рядом с орудиями и напоминает не открывать огонь слишком рано.", "Соколов оставляет резерв снабжения на ремонт и проверяет последний поворот.", "Нина убирает письма в непромокаемый чехол: сегодня им снова нужно выиграть дорогу.", "Расчёты занимают проверенные позиции. На этот раз каждый знает, какую часть дороги он прикрывает."], "ending": ["Колонна проходит участок без остановки.", "Связисты докладывают: маршрут снова работает.", "Сапёры убирают заграждения для своих машин.", "За поворотом слышен сигнал последнего грузовика.", "В журнале появляется ещё одна отметка об удержанной дороге."], "letter": ["Сегодня мы охраняли не точку на карте, а чужую возможность добраться домой.", "Белов говорит, что хорошая позиция начинается с заботы о соседнем расчёте.", "Нина снова пересчитала письма. Ни одно не осталось на дороге.", "Усталость приходит после боя. Пока за спиной движется колонна, её почти не замечаешь.", "Мы учимся беречь не только снабжение, но и время друг друга."], "order": "Задача участка", "result": "Рубеж удержан.", "tip": "Сочетайте огонь по площади с противотанковыми орудиями. Между волнами чините повреждённые позиции; платная поддержка не обязательна." }, "en": { "sector": "Sector", "mission": "Mission", "chapter": "Chapter", "page": "Map sheet", "previous": "Back", "next": "Next", "go": "Current mission", "completed": "Completed", "open": "Deploy", "locked": "Locked", "campaignNote": "200 missions per chapter. Each map sheet shows 20. Advance by completing missions.", "migrated": "Progress transferred. Previous victories, coins and upgrades are preserved; new missions remain available to play.", "briefScale": "Assault strength", "enemyPressure": "Pressure", "optional": "Permanent skills and paid support are optional.", "chapters": ["The company is still learning to hold a road during a retreat. Behind every crossroads are people who need more time.", "The crews now work together. Every new position must give the neighbouring unit a chance to dig in.", "The supply route has become a thin thread between the front and the rear. Even a small detour cannot be left unguarded.", "The company is returning along familiar routes. Old roads must be cleared again and protected against counterattacks.", "The mailbag is growing lighter, but the convoys still need a safe road. The company is keeping the promise made on the first day."], "names": ["Radio Silence", "Hospital Bend", "Roadside Crates", "Timber Convoy", "Courier Route", "Water Pump", "Repair Yard", "Field Crossroads", "Wire through the Woods", "Sapper Patrol", "Mill Road", "Assembly Point", "Observation Post", "Spare Parts Truck", "Rations Depot", "Bridge Approach", "Roadside Shelter", "Field Kitchen", "Supply Relay", "Clearing the Road"], "tasks": ["Cover the signal crews while they restore the radio post.", "Hold the road for the ambulances.", "Protect ammunition unloading beside the track.", "Escort building supplies through a dangerous bend.", "Keep the route open for couriers and field mail.", "Let the water trucks finish loading at the pump.", "Defend the repair yard until the last vehicle departs.", "Prevent a breakthrough to the field crossroads.", "Cover the laying of a new telephone line.", "Hold the road while sappers check the next section.", "Protect the delivery of flour and provisions.", "Keep the route from the assembly point to the rear open.", "Defend the approaches to the observation post.", "Cover the truck carrying spare parts.", "Hold the road to the rations depot.", "Protect the bridge approach against a counterattack.", "Cover the temporary roadside shelter.", "Keep the route to the field kitchen open.", "Defend the intermediate supply base.", "Buy time to clear the roadblock."], "incidents": ["Scouts have spotted movement on a nearby track: the detour is no longer safe.", "The leading vehicle has broken down, leaving the convoy stretched around a bend.", "The wire is cut. Until communications return, the crews must follow signal flags.", "The night patrol has brought a sketch of a new enemy approach.", "A group of wounded is moving to the rear; they cannot be hurried.", "A small bridge has sagged under the load. Belov leaves a repair team beside it.", "This bend is marked incorrectly on the map. Scouts check the route just before the battle.", "The last truck has not arrived, so it is too early to leave the position.", "Drivers are changing a roadside wheel with their lamps covered.", "The sentry hears engines beyond the trees. There is no time left to move the cargo.", "A neighbouring company asks for the passage to be held a little longer.", "The reserve route is blocked. All traffic must pass through this line."], "actors": ["Sokolov assigns firing sectors while Belov checks the crew shelters.", "Nina marks the safe bends on her map and transmits a short order.", "Belov places spare crates beside the guns and reminds the crews not to fire too early.", "Sokolov reserves supplies for repairs and checks the last bend.", "Nina puts the letters in a waterproof cover: today they need a safe road again.", "The crews take their familiar positions. Each knows which part of the road to cover."], "ending": ["The convoy passes the sector without stopping.", "The signallers report that the route is working again.", "Sappers remove the barriers to let friendly vehicles through.", "The last truck sounds its horn beyond the bend.", "Another defended road is recorded in the company journal."], "letter": ["Today we guarded not a point on a map, but someone’s chance to get home.", "Belov says a good position begins with looking after the next crew.", "Nina counted the letters again. Not one was left on the road.", "Weariness comes after battle. While the convoy moves behind us, we hardly notice it.", "We are learning to save not only supplies, but each other’s time."], "order": "Sector orders", "result": "The line holds.", "tip": "Combine area fire with anti-tank guns. Repair damaged positions between waves; paid support is not required." }, "de": { "sector": "Abschnitt", "mission": "Mission", "chapter": "Kapitel", "page": "Kartenblatt", "previous": "Zurück", "next": "Weiter", "go": "Aktuelle Mission", "completed": "Abgeschlossen", "open": "Ins Gefecht", "locked": "Gesperrt", "campaignNote": "200 Missionen pro Kapitel. Jedes Kartenblatt zeigt 20. Siege öffnen den weiteren Weg.", "migrated": "Fortschritt übertragen. Bisherige Siege, Münzen und Verbesserungen bleiben erhalten; neue Missionen können separat gespielt werden.", "briefScale": "Angriffsstärke", "enemyPressure": "Druck", "optional": "Dauerhafte Fähigkeiten und bezahlte Unterstützung sind optional.", "chapters": ["Die Kompanie lernt noch, beim Rückzug eine Straße zu halten. Hinter jeder Kreuzung warten Menschen, die Zeit brauchen.", "Die Bedienungen arbeiten nun zusammen. Jede neue Stellung soll der Nachbareinheit Zeit zum Eingraben verschaffen.", "Die Versorgungsstraße ist ein dünner Faden zwischen Front und Hinterland. Auch ein kleiner Umweg darf nicht unbewacht bleiben.", "Die Kompanie kehrt auf vertrauten Wegen zurück. Alte Straßen müssen erneut geräumt und gegen Gegenangriffe gesichert werden.", "Der Postsack wird leichter, doch die Kolonnen brauchen weiterhin eine sichere Straße. Die Kompanie hält ihr Versprechen vom ersten Tag."], "names": ["Funkstille", "Lazarettkurve", "Kisten am Weg", "Holzkolonne", "Kurierroute", "Wasserpumpe", "Reparaturhof", "Feldkreuzung", "Draht durch den Wald", "Pionierpatrouille", "Mühlenweg", "Sammelstelle", "Beobachtungsposten", "Ersatzteillaster", "Verpflegungsdepot", "Brückenzufahrt", "Unterstand am Weg", "Feldküche", "Versorgungsstation", "Straßenräumung"], "tasks": ["Die Funker decken, während sie den Funkposten wiederherstellen.", "Die Straße für die Sanitätswagen halten.", "Das Entladen der Munition am Feldweg schützen.", "Baumaterial durch eine gefährliche Kurve geleiten.", "Den Weg für Kuriere und Feldpost offen halten.", "Das Beladen der Wasserwagen an der Pumpe ermöglichen.", "Den Reparaturhof bis zur Abfahrt des letzten Fahrzeugs verteidigen.", "Einen Durchbruch zur Feldkreuzung verhindern.", "Das Verlegen einer neuen Telefonleitung decken.", "Die Straße halten, während Pioniere den nächsten Abschnitt prüfen.", "Die Anlieferung von Mehl und Proviant schützen.", "Den Weg von der Sammelstelle ins Hinterland offen halten.", "Die Zugänge zum Beobachtungsposten verteidigen.", "Den Lastwagen mit Ersatzteilen decken.", "Die Straße zum Verpflegungsdepot halten.", "Die Brückenzufahrt vor einem Gegenangriff schützen.", "Den provisorischen Unterstand am Weg decken.", "Den Zugang zur Feldküche offen halten.", "Die vorgeschobene Versorgungsbasis verteidigen.", "Zeit zum Räumen der Straßensperre gewinnen."], "incidents": ["Späher melden Bewegung auf einem nahen Feldweg: Der Umweg ist nicht mehr sicher.", "Das erste Fahrzeug ist liegen geblieben, und die Kolonne steht bis hinter die Kurve.", "Der Draht ist gerissen. Bis die Verbindung steht, richten sich die Bedienungen nach Signalflaggen.", "Die Nachtpatrouille bringt eine Skizze eines neuen feindlichen Anmarschwegs.", "Eine Gruppe Verwundeter zieht ins Hinterland; sie kann nicht schneller gehen.", "Eine kleine Brücke hat unter der Last nachgegeben. Below lässt einen Reparaturtrupp dort.", "Diese Kurve ist auf der Karte falsch eingezeichnet. Späher prüfen den Weg kurz vor dem Gefecht.", "Der letzte Lastwagen ist noch nicht da. Die Stellung darf nicht verlassen werden.", "Die Fahrer wechseln am Straßenrand ein Rad und verdecken dabei ihre Lampen.", "Der Posten hört Motoren hinter den Bäumen. Für das Umladen bleibt keine Zeit.", "Die Nachbarkompanie bittet darum, den Durchgang noch etwas länger zu halten.", "Der Ersatzweg ist versperrt. Der gesamte Verkehr muss diese Linie passieren."], "actors": ["Sokolow teilt die Feuerbereiche ein, während Below die Unterstände prüft.", "Nina markiert sichere Kurven auf der Karte und funkt einen kurzen Befehl.", "Below stellt Reservekisten neben die Geschütze und mahnt, nicht zu früh zu schießen.", "Sokolow hält Nachschub für Reparaturen zurück und prüft die letzte Kurve.", "Nina verpackt die Briefe wasserdicht: Heute brauchen sie wieder einen sicheren Weg.", "Die Bedienungen besetzen ihre vertrauten Stellungen. Jeder kennt seinen Straßenabschnitt."], "ending": ["Die Kolonne passiert den Abschnitt ohne Halt.", "Die Funker melden: Die Route funktioniert wieder.", "Pioniere räumen die Sperren für die eigenen Fahrzeuge.", "Hinter der Kurve hupt der letzte Lastwagen.", "Eine weitere gehaltene Straße wird im Kompaniebuch vermerkt."], "letter": ["Heute bewachten wir keinen Kartenpunkt, sondern die Hoffnung eines Menschen auf Heimkehr.", "Below sagt, eine gute Stellung beginne mit der Sorge um die nächste Bedienung.", "Nina hat die Briefe wieder gezählt. Keiner blieb auf der Straße zurück.", "Die Müdigkeit kommt nach dem Kampf. Solange die Kolonne hinter uns fährt, spüren wir sie kaum.", "Wir lernen, nicht nur Nachschub, sondern auch die Zeit der anderen zu bewahren."], "order": "Abschnittsbefehl", "result": "Die Linie hält.", "tip": "Flächenfeuer mit Panzerabwehr kombinieren. Beschädigte Stellungen zwischen den Wellen reparieren; bezahlte Unterstützung ist nicht erforderlich." }, "fr": { "sector": "Secteur", "mission": "Mission", "chapter": "Chapitre", "page": "Feuille de carte", "previous": "Retour", "next": "Suivant", "go": "Mission en cours", "completed": "Terminées", "open": "Au combat", "locked": "Verrouillée", "campaignNote": "200 missions par chapitre, 20 par feuille de carte. Les victoires ouvrent la suite du parcours.", "migrated": "Progression transférée. Vos victoires, pièces et améliorations sont conservées ; les nouvelles missions restent à jouer.", "briefScale": "Puissance de l'assaut", "enemyPressure": "Pression", "optional": "Les compétences permanentes et le soutien payant sont facultatifs.", "chapters": ["La compagnie apprend encore à tenir une route pendant la retraite. Derrière chaque carrefour, des gens ont besoin de temps.", "Les servants travaillent désormais ensemble. Chaque nouvelle position doit permettre à l'unité voisine de se retrancher.", "La route du ravitaillement est devenue un fil entre le front et l'arrière. Même un petit détour doit être gardé.", "La compagnie revient sur des itinéraires familiers. Les anciennes routes doivent être déblayées et protégées des contre-attaques.", "Le sac postal s'allège, mais les convois ont toujours besoin d'une route sûre. La compagnie tient sa promesse du premier jour."], "names": ["Silence radio", "Virage du poste médical", "Caisses au bord du chemin", "Convoi de bois", "Itinéraire des courriers", "Pompe à eau", "Atelier de réparation", "Carrefour des champs", "Fil à travers le bois", "Patrouille de sapeurs", "Route du moulin", "Point de rassemblement", "Poste d'observation", "Camion de pièces", "Dépôt de vivres", "Accès au pont", "Abri au bord du chemin", "Cuisine de campagne", "Relais du ravitaillement", "Route à dégager"], "tasks": ["Couvrir les transmetteurs pendant la remise en état du poste radio.", "Tenir la route pour les ambulances.", "Protéger le déchargement des munitions près du chemin.", "Faire passer les matériaux de construction dans un virage dangereux.", "Garder le passage ouvert aux courriers et à la poste de campagne.", "Laisser les camions-citernes terminer leur chargement à la pompe.", "Défendre l'atelier jusqu'au départ du dernier véhicule.", "Empêcher une percée vers le carrefour des champs.", "Couvrir la pose d'une nouvelle ligne téléphonique.", "Tenir la route pendant que les sapeurs vérifient le prochain tronçon.", "Protéger la livraison de farine et de provisions.", "Garder ouvert le passage du point de rassemblement vers l'arrière.", "Défendre les accès au poste d'observation.", "Couvrir le camion chargé de pièces détachées.", "Tenir la route du dépôt de vivres.", "Protéger l'accès au pont contre une contre-attaque.", "Couvrir l'abri provisoire au bord de la route.", "Garder le chemin de la cuisine de campagne ouvert.", "Défendre la base intermédiaire de ravitaillement.", "Gagner du temps pour dégager la route."], "incidents": ["Les éclaireurs ont vu du mouvement sur un chemin voisin : le détour n'est plus sûr.", "Le premier véhicule est en panne et le convoi s'étire dans le virage.", "Le fil est coupé. En attendant le retour des communications, les servants suivent les fanions.", "La patrouille de nuit rapporte un croquis d'une nouvelle approche ennemie.", "Un groupe de blessés rejoint l'arrière ; impossible de le presser.", "Un petit pont a cédé sous la charge. Belov y laisse une équipe de réparation.", "Ce virage est mal indiqué sur la carte. Les éclaireurs vérifient la route juste avant le combat.", "Le dernier camion n'est pas encore arrivé : il est trop tôt pour quitter la position.", "Les conducteurs changent une roue sur le bas-côté en masquant leurs lampes.", "La sentinelle entend des moteurs derrière les arbres. Il ne reste plus de temps pour déplacer le chargement.", "La compagnie voisine demande de tenir le passage encore un moment.", "L'itinéraire de secours est bloqué. Tout le trafic devra franchir cette ligne."], "actors": ["Sokolov répartit les secteurs de tir tandis que Belov vérifie les abris.", "Nina marque les virages sûrs sur sa carte et transmet un ordre bref.", "Belov place des caisses près des canons et rappelle de ne pas tirer trop tôt.", "Sokolov garde du ravitaillement pour les réparations et vérifie le dernier virage.", "Nina range les lettres dans une housse étanche : elles ont encore besoin d'une route sûre.", "Les servants occupent leurs positions familières. Chacun connaît le tronçon à couvrir."], "ending": ["Le convoi traverse le secteur sans s'arrêter.", "Les transmetteurs annoncent que l'itinéraire fonctionne à nouveau.", "Les sapeurs retirent les obstacles pour laisser passer les véhicules amis.", "Le dernier camion klaxonne derrière le virage.", "Une route défendue de plus est notée dans le journal de la compagnie."], "letter": ["Aujourd'hui, nous gardions non pas un point sur une carte, mais la chance de quelqu'un de rentrer chez lui.", "Belov dit qu'une bonne position commence par le souci de l'équipe voisine.", "Nina a encore compté les lettres. Aucune n'est restée sur la route.", "La fatigue vient après le combat. Tant que le convoi passe derrière nous, nous la sentons à peine.", "Nous apprenons à économiser le ravitaillement, mais aussi le temps des autres."], "order": "Ordres du secteur", "result": "La ligne tient.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable." }, "zh": { "sector": "防区", "mission": "任务", "chapter": "章节", "page": "地图页", "previous": "上一页", "next": "下一页", "go": "当前任务", "completed": "已完成", "open": "出战", "locked": "未解锁", "campaignNote": "每章200个任务，每页显示20个。完成任务后继续推进。", "migrated": "进度已迁移。原有胜利、金币和升级均已保留，新增任务可以另行完成。", "briefScale": "攻势强度", "enemyPressure": "压力", "optional": "永久技能和付费支援并非通关必需。", "chapters": ["连队仍在学习如何在撤退中守住道路。每个路口后面，都有人需要更多时间。", "各炮组已能协同行动。每处新阵地都要为友邻部队争取构筑工事的时间。", "补给线成了连接前线与后方的细线。哪怕一条小小的绕行路也不能无人守卫。", "连队沿熟悉的方向返回。旧路需要重新清理，也需要防备反击。", "邮袋越来越轻，但车队仍需要安全通道。连队继续履行第一天许下的承诺。"], "names": ["无线电静默", "医疗站弯道", "路边的木箱", "木材车队", "信使路线", "取水站", "维修场", "田野路口", "林间电话线", "工兵巡逻", "磨坊小路", "集合点", "观察哨", "零件卡车", "口粮仓库", "桥头通道", "路边掩蔽所", "野战炊事点", "补给中转站", "清理路障"], "tasks": ["掩护通信兵修复无线电站。", "为救护车守住道路。", "保护小路旁的弹药卸载。", "掩护建筑材料车队通过危险弯道。", "为信使和战地邮件保持通道畅通。", "为运水车完成装载争取时间。", "守住维修场，直到最后一辆车离开。", "阻止敌军突破田野路口。", "掩护新的电话线铺设。", "守住道路，等待工兵检查下一路段。", "保护面粉与食品运输。", "保持集合点到后方的道路畅通。", "守卫观察哨的入口。", "掩护运送备用零件的卡车。", "守住通往口粮仓库的道路。", "保护桥头通道，抵御反击。", "掩护路边的临时掩蔽所。", "保持通往野战炊事点的道路畅通。", "防守补给中转基地。", "为清理道路障碍争取时间。"], "incidents": ["侦察兵在邻近小路发现动静，绕行路线已不再安全。", "头车发生故障，车队在弯道附近排成长队。", "电话线断了。通信恢复前，炮组只能依靠信号旗。", "夜间巡逻队带回一张敌军新接近路线的草图。", "一队伤员正在撤往后方，他们无法走得更快。", "一座小桥被货物压塌，别洛夫留下一支抢修队。", "地图上的弯道位置有误，侦察兵在战斗前重新确认路线。", "最后一辆卡车还没到，此时不能离开阵地。", "司机在路边换轮胎，用雨布遮住灯光。", "哨兵听见树林后的引擎声，已经来不及转移货物。", "邻近连队请求再守住通道一会儿。", "备用路线被堵住，所有车辆都必须经过这道防线。"], "actors": ["索科洛夫分配火力区，别洛夫检查炮组的掩体。", "妮娜在地图上标出安全弯道，传达简短命令。", "别洛夫把备用弹药箱放在火炮旁，提醒大家不要过早开火。", "索科洛夫预留维修补给，检查最后一个弯道。", "妮娜把信件装进防水袋，今天它们仍需要一条安全的路。", "炮组进入熟悉的阵地，每个人都知道自己要掩护哪段道路。"], "ending": ["车队顺利通过防区。", "通信兵报告，路线已恢复运转。", "工兵移开障碍，让己方车辆通行。", "最后一辆卡车在弯道后鸣笛。", "连队日志上又记下一条守住的道路。"], "letter": ["今天我们守的不是地图上的一个点，而是某个人回家的机会。", "别洛夫说，好的阵地首先要照顾旁边的炮组。", "妮娜又数了一遍信件，没有一封落在路上。", "疲倦总在战斗结束后到来。只要身后的车队还在前进，我们几乎察觉不到。", "我们学着节约的不只是补给，还有彼此的时间。"], "order": "防区命令", "result": "防线守住了。", "tip": "将范围火力与反坦克炮搭配使用。在波次间修理受损阵地，付费支援并非必需。" }, "ja": { "sector": "区画", "mission": "任務", "chapter": "章", "page": "地図ページ", "previous": "前へ", "next": "次へ", "go": "現在の任務", "completed": "完了", "open": "出撃", "locked": "未解放", "campaignNote": "各章200任務、1ページに20任務を表示。勝利すると先へ進めます。", "migrated": "進行状況を移行しました。以前の勝利、コイン、強化は保持され、新しい任務は別にプレイできます。", "briefScale": "攻撃規模", "enemyPressure": "圧力", "optional": "永久スキルと有料支援は必須ではありません。", "chapters": ["中隊は撤退の中で道を守る方法を学んでいる。どの交差点の向こうにも、時間を必要とする人々がいる。", "砲班は連携して動くようになった。新しい陣地は、隣の部隊が防備を整える時間を生まなければならない。", "補給路は前線と後方を結ぶ細い糸になった。小さな迂回路でも無防備にはできない。", "中隊は見覚えのある道を戻っていく。古い道を再び片づけ、反撃から守る必要がある。", "郵便袋は軽くなったが、車列にはまだ安全な道が必要だ。中隊は初日に交わした約束を果たし続ける。"], "names": ["無線の沈黙", "救護所の曲がり角", "道端の木箱", "木材輸送隊", "伝令の道", "給水所", "修理場", "野原の交差点", "森を渡る電話線", "工兵の巡回", "水車小屋への道", "集合地点", "観測所", "部品輸送車", "糧食倉庫", "橋への進入路", "道端の避難所", "野戦炊事場", "補給中継地", "道路の片づけ"], "tasks": ["無線所を復旧する通信兵を援護する。", "救急車のために道を守る。", "脇道での弾薬の荷下ろしを守る。", "建設資材の車列を危険な曲がり角から通す。", "伝令と野戦郵便の通路を維持する。", "給水車が積み込みを終えるまで守る。", "最後の車両が出発するまで修理場を防衛する。", "野原の交差点への突破を阻止する。", "新しい電話線の敷設を援護する。", "工兵が次の区間を調べる間、道を守る。", "小麦粉と食料の輸送を守る。", "集合地点から後方への道を開けておく。", "観測所への接近路を防衛する。", "予備部品を積んだトラックを援護する。", "糧食倉庫への道を守る。", "橋への進入路を反撃から守る。", "道端の仮設避難所を援護する。", "野戦炊事場への道を維持する。", "補給中継基地を防衛する。", "道路の障害物を除く時間を稼ぐ。"], "incidents": ["斥候が隣の小道に動きを発見した。迂回路はもう安全ではない。", "先頭車両が故障し、車列が曲がり角まで伸びている。", "電話線が切れた。通信が戻るまでは信号旗に従うしかない。", "夜の巡回隊が、敵の新たな接近路を描いた略図を持ち帰った。", "負傷者の一団が後方へ向かっている。急がせることはできない。", "小さな橋が荷重で沈み、ベロフは修理班を残した。", "この曲がり角は地図の位置と違う。斥候は戦闘直前に道を確かめる。", "最後のトラックがまだ来ない。陣地を離れるには早すぎる。", "運転手たちは灯りを覆い、路肩で車輪を交換している。", "歩哨が木立の向こうにエンジン音を聞いた。荷を動かす時間はもうない。", "隣の中隊から、もう少し通路を守ってほしいと要請が来た。", "予備の道が塞がれた。すべての車両がこの防衛線を通らなければならない。"], "actors": ["ソコロフが射界を割り当て、ベロフが砲班の掩体を点検する。", "ニーナは安全な曲がり角を地図に記し、短い命令を伝える。", "ベロフは砲のそばに予備の箱を置き、早撃ちしないよう念を押す。", "ソコロフは修理用の補給を残し、最後の曲がり角を確認する。", "ニーナは手紙を防水の包みにしまう。今日も安全な道が必要だ。", "砲班は慣れた陣地に就く。誰もが自分の守る区間を知っている。"], "ending": ["車列は止まることなく区画を通過した。", "通信兵が、輸送路の復旧を報告する。", "工兵は味方の車両を通すために障害物を取り除いた。", "曲がり角の向こうで最後のトラックが警笛を鳴らす。", "中隊の日誌に、守り抜いた道がまた一つ記された。"], "letter": ["今日は地図の一点ではなく、誰かが家へ帰る機会を守った。", "良い陣地は隣の砲班を気にかけるところから始まる、とベロフは言う。", "ニーナはまた手紙を数えた。一通も道に残していない。", "疲れは戦いの後に来る。背後で車列が進む間はほとんど感じない。", "節約するのは補給だけではない。互いの時間も大切にしている。"], "order": "区画の命令", "result": "防衛線を守った。", "tip": "範囲攻撃と対戦車砲を組み合わせましょう。波の合間に陣地を修理すれば、有料支援は不要です。" } };
const $ = id => document.getElementById(id);
const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
const lerp = (a, b, t) => a + (b - a) * t;
const TAU = Math.PI * 2, WORLD_W = 1200, WORLD_H = 600;
const CHAPTER_SIZE = 200, MISSIONS_PER_PAGE = 20, CAMPAIGN_SIZE = 1000;
function legacyMissionId(id) { return Math.floor(id / 30) * CHAPTER_SIZE + Math.round((id % 30) * 199 / 29); }
function campaignOpenLimit() { return clamp(Math.floor(SAVE.unlockedMission || 0), 0, MISSIONS.length - 1); }
function canOpenMission(id) { return Number.isInteger(id) && id >= 0 && id < MISSIONS.length && (id <= campaignOpenLimit() || SAVE.stars[id] > 0); }
function recordMissionWin(id) {
    SAVE.unlockedMission = Math.max(campaignOpenLimit(), Math.min(MISSIONS.length - 1, id + 1));
    SAVE.resumeMission = Math.min(MISSIONS.length - 1, id + 1);
    SAVE.campaignSize = CAMPAIGN_SIZE;
}
const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
function rng(seed) { let a = seed >>> 0; return () => { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }
function circle(c, x, y, r, fill, stroke) { c.beginPath(); c.arc(x, y, r, 0, TAU); if (fill) {
    c.fillStyle = fill;
    c.fill();
} if (stroke) {
    c.strokeStyle = stroke;
    c.stroke();
} }
function line(c, pts, color, width = 1) { c.beginPath(); pts.forEach((p, i) => { var _a, _b, _c, _d; return i ? c.lineTo((_a = p.x) !== null && _a !== void 0 ? _a : p[0], (_b = p.y) !== null && _b !== void 0 ? _b : p[1]) : c.moveTo((_c = p.x) !== null && _c !== void 0 ? _c : p[0], (_d = p.y) !== null && _d !== void 0 ? _d : p[1]); }); c.strokeStyle = color; c.lineWidth = width; c.lineJoin = 'round'; c.lineCap = 'round'; c.stroke(); }
function rr(c, x, y, w, h, r, fill, stroke) { r = Math.min(r, w / 2, h / 2); c.beginPath(); c.moveTo(x + r, y); c.arcTo(x + w, y, x + w, y + h, r); c.arcTo(x + w, y + h, x, y + h, r); c.arcTo(x, y + h, x, y, r); c.arcTo(x, y, x + w, y, r); if (fill) {
    c.fillStyle = fill;
    c.fill();
} if (stroke) {
    c.strokeStyle = stroke;
    c.lineWidth = 1;
    c.stroke();
} }
function poly(c, pts, fill, stroke) { c.beginPath(); pts.forEach((p, i) => i ? c.lineTo(p[0], p[1]) : c.moveTo(p[0], p[1])); c.closePath(); if (fill) {
    c.fillStyle = fill;
    c.fill();
} if (stroke) {
    c.strokeStyle = stroke;
    c.stroke();
} }
function icon(name) {
    const paths = {
        coin: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><path d="M12 8v8"/>',
        gem: '<path d="m7 3-5 6 10 13L22 9l-5-6zM2 9h20M7 3l5 6 5-6M12 9v13"/>',
