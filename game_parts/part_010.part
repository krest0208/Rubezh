firstReward": 201, "repeatReward": 91, "layoutSeed": 18991, "original": false, "legacyId": null, "sector": 2, "orderInChapter": 44, "pressure": 1.49 }, { "title": "Point de rassemblement · B-045", "place": "Secteur de Volokolamsk", "date": "Novembre 1941", "chapter": 1, "theme": "snow", "map": 14, "weather": "snow", "trait": "fog", "base": "Point de rassemblement", "quote": "", "story": "Les servants travaillent désormais ensemble. Chaque nouvelle position doit permettre à l'unité voisine de se retrancher. Le dernier camion n'est pas encore arrivé : il est trop tôt pour quitter la position. Nina marque les virages sûrs sur sa carte et transmet un ordre bref. Secteur B-045. Ordres du secteur: Garder ouvert le passage du point de rassemblement vers l'arrière.", "objective": "Garder ouvert le passage du point de rassemblement vers l'arrière.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Les sapeurs retirent les obstacles pour laisser passer les véhicules amis. Point de rassemblement · B-045.", "letter": "Point de rassemblement · B-045. Nous apprenons à économiser le ravitaillement, mais aussi le temps des autres.", "waves": 19, "id": 244, "rank": 7.93794, "firstReward": 190, "repeatReward": 85, "layoutSeed": 19028, "original": false, "legacyId": null, "sector": 2, "orderInChapter": 45, "pressure": 1.492 }, { "title": "Poste d'observation · B-046", "place": "Secteur de Volokolamsk", "date": "Novembre 1941", "chapter": 1, "theme": "snow", "map": 0, "weather": "snow", "trait": "frost", "base": "Poste d'observation", "quote": "", "story": "Les servants travaillent désormais ensemble. Chaque nouvelle position doit permettre à l'unité voisine de se retrancher. Les conducteurs changent une roue sur le bas-côté en masquant leurs lampes. Nina marque les virages sûrs sur sa carte et transmet un ordre bref. Secteur B-046. Ordres du secteur: Défendre les accès au poste d'observation.", "objective": "Défendre les accès au poste d'observation.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Les sapeurs retirent les obstacles pour laisser passer les véhicules amis. Poste d'observation · B-046.", "letter": "Poste d'observation · B-046. Aujourd'hui, nous gardions non pas un point sur une carte, mais la chance de quelqu'un de rentrer chez lui.", "waves": 19, "id": 245, "rank": 7.97047, "firstReward": 190, "repeatReward": 85, "layoutSeed": 19065, "original": false, "legacyId": null, "sector": 2, "orderInChapter": 46, "pressure": 1.494 }, { "title": "Camion de pièces · B-047", "place": "Secteur de Volokolamsk", "date": "Novembre 1941", "chapter": 1, "theme": "snow", "map": 10, "weather": "snow", "trait": "scarcity", "base": "Camion de pièces", "quote": "", "story": "Les servants travaillent désormais ensemble. Chaque nouvelle position doit permettre à l'unité voisine de se retrancher. Les conducteurs changent une roue sur le bas-côté en masquant leurs lampes. Nina marque les virages sûrs sur sa carte et transmet un ordre bref. Secteur B-047. Ordres du secteur: Couvrir le camion chargé de pièces détachées.", "objective": "Couvrir le camion chargé de pièces détachées.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Les sapeurs retirent les obstacles pour laisser passer les véhicules amis. Camion de pièces · B-047.", "letter": "Camion de pièces · B-047. Aujourd'hui, nous gardions non pas un point sur une carte, mais la chance de quelqu'un de rentrer chez lui.", "waves": 21, "id": 246, "rank": 8.003, "firstReward": 198, "repeatReward": 89, "layoutSeed": 19102, "original": false, "legacyId": null, "sector": 2, "orderInChapter": 47, "pressure": 1.496 }, { "title": "Dépôt de vivres · B-048", "place": "Secteur de Volokolamsk", "date": "Novembre 1941", "chapter": 1, "theme": "snow", "map": 20, "weather": "snow", "trait": "none", "base": "Dépôt de vivres", "quote": "", "story": "Les servants travaillent désormais ensemble. Chaque nouvelle position doit permettre à l'unité voisine de se retrancher. Les conducteurs changent une roue sur le bas-côté en masquant leurs lampes. Nina marque les virages sûrs sur sa carte et transmet un ordre bref. Secteur B-048. Ordres du secteur: Tenir la route du dépôt de vivres.", "objective": "Tenir la route du dépôt de vivres.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Les sapeurs retirent les obstacles pour laisser passer les véhicules amis. Dépôt de vivres · B-048.", "letter": "Dépôt de vivres · B-048. Aujourd'hui, nous gardions non pas un point sur une carte, mais la chance de quelqu'un de rentrer chez lui.", "waves": 21, "id": 247, "rank": 8.03554, "firstReward": 198, "repeatReward": 89, "layoutSeed": 19139, "original": false, "legacyId": null, "sector": 2, "orderInChapter": 48, "pressure": 1.498 }, { "title": "La lanterne du garde-voie", "place": "Secteur de Volokolamsk", "date": "Novembre 1941", "chapter": 1, "theme": "snow", "map": 2, "weather": "snow", "trait": "supplies", "base": "Protéger le poste du garde-voie", "quote": "« Une bonne position économise plus d'obus qu'une caisse pleine. »", "story": "Le garde-voie revient d'un poste éloigné avec un relevé des dégâts. Sa lanterne sert désormais de signal à toute la compagnie. Sokolov choisit les positions, Nina établit les liaisons et Belov répartit les munitions.", "objective": "Protéger le poste du garde-voie.", "tip": "Mitrailleuses et mortiers retiennent les groupes serrés. Placez-les près d'un long virage.", "outro": "La ligne tient. Le journal indique : « La lanterne du garde-voie — mission accomplie. » Nina le range près du sac postal.", "letter": "« La lanterne du garde-voie. » Belov dit qu'une route se souvient de ceux qui l'ont réparée. J'espère qu'elle se souvient aussi des sauvés.", "waves": 23, "id": 248, "rank": 8.06807, "firstReward": 206, "repeatReward": 93, "legacyId": 37, "layoutSeed": 37, "original": true, "sector": 2, "orderInChapter": 49, "pressure": 1.5 }, { "title": "Abri au bord du chemin · B-050", "place": "Secteur de Volokolamsk", "date": "Novembre 1941", "chapter": 1, "theme": "snow", "map": 16, "weather": "snow", "trait": "scouts", "base": "Abri au bord du chemin", "quote": "", "story": "Les servants travaillent désormais ensemble. Chaque nouvelle position doit permettre à l'unité voisine de se retrancher. La sentinelle entend des moteurs derrière les arbres. Il ne reste plus de temps pour déplacer le chargement. Belov place des caisses près des canons et rappelle de ne pas tirer trop tôt. Secteur B-050. Ordres du secteur: Couvrir l'abri provisoire au bord de la route.", "objective": "Couvrir l'abri provisoire au bord de la route.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Le dernier camion klaxonne derrière le virage. Abri au bord du chemin · B-050.", "letter": "Abri au bord du chemin · B-050. Aujourd'hui, nous gardions non pas un point sur une carte, mais la chance de quelqu'un de rentrer chez lui.", "waves": 23, "id": 249, "rank": 8.1006, "firstReward": 206, "repeatReward": 93, "layoutSeed": 19213, "original": false, "legacyId": null, "sector": 2, "orderInChapter": 50, "pressure": 1.502 }, { "title": "Cuisine de campagne · B-051", "place": "Secteur de Volokolamsk", "date": "Novembre 1941", "chapter": 1, "theme": "snow", "map": 2, "weather": "snow", "trait": "supplies", "base": "Cuisine de campagne", "quote": "", "story": "Les servants travaillent désormais ensemble. Chaque nouvelle position doit permettre à l'unité voisine de se retrancher. La sentinelle entend des moteurs derrière les arbres. Il ne reste plus de temps pour déplacer le chargement. Belov place des caisses près des canons et rappelle de ne pas tirer trop tôt. Secteur B-051. Ordres du secteur: Garder le chemin de la cuisine de campagne ouvert.", "objective": "Garder le chemin de la cuisine de campagne ouvert.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Le dernier camion klaxonne derrière le virage. Cuisine de campagne · B-051.", "letter": "Cuisine de campagne · B-051. Belov dit qu'une bonne position commence par le souci de l'équipe voisine.", "waves": 20, "id": 250, "rank": 8.13313, "firstReward": 195, "repeatReward": 87, "layoutSeed": 19250, "original": false, "legacyId": null, "sector": 2, "orderInChapter": 51, "pressure": 1.504 }, { "title": "Relais du ravitaillement · B-052", "place": "Secteur de Volokolamsk", "date": "Novembre 1941", "chapter": 1, "theme": "snow", "map": 12, "weather": "snow", "trait": "fog", "base": "Relais du ravitaillement", "quote": "", "story": "Les servants travaillent désormais ensemble. Chaque nouvelle position doit permettre à l'unité voisine de se retrancher. La compagnie voisine demande de tenir le passage encore un moment. Belov place des caisses près des canons et rappelle de ne pas tirer trop tôt. Secteur B-052. Ordres du secteur: Défendre la base intermédiaire de ravitaillement.", "objective": "Défendre la base intermédiaire de ravitaillement.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Le dernier camion klaxonne derrière le virage. Relais du ravitaillement · B-052.", "letter": "Relais du ravitaillement · B-052. Belov dit qu'une bonne position commence par le souci de l'équipe voisine.", "waves": 20, "id": 251, "rank": 8.16567, "firstReward": 195, "repeatReward": 88, "layoutSeed": 19287, "original": false, "legacyId": null, "sector": 2, "orderInChapter": 52, "pressure": 1.506 }, { "title": "Route à dégager · B-053", "place": "Secteur de Volokolamsk", "date": "Novembre 1941", "chapter": 1, "theme": "snow", "map": 22, "weather": "snow", "trait": "none", "base": "Route à dégager", "quote": "", "story": "Les servants travaillent désormais ensemble. Chaque nouvelle position doit permettre à l'unité voisine de se retrancher. La compagnie voisine demande de tenir le passage encore un moment. Belov place des caisses près des canons et rappelle de ne pas tirer trop tôt. Secteur B-053. Ordres du secteur: Gagner du temps pour dégager la route.", "objective": "Gagner du temps pour dégager la route.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Une route défendue de plus est notée dans le journal de la compagnie. Route à dégager · B-053.", "letter": "Route à dégager · B-053. Belov dit qu'une bonne position commence par le souci de l'équipe voisine.", "waves": 22, "id": 252, "rank": 8.1982, "firstReward": 203, "repeatReward": 92, "layoutSeed": 19324, "original": false, "legacyId": null, "sector": 2, "orderInChapter": 53, "pressure": 1.508 }, { "title": "Silence radio · B-054", "place": "Secteur de Volokolamsk", "date": "Novembre 1941", "chapter": 1, "theme": "snow", "map": 20, "weather": "snow", "trait": "scarcity", "base": "Silence radio", "quote": "", "story": "Les servants travaillent désormais ensemble. Chaque nouvelle position doit permettre à l'unité voisine de se retrancher. La compagnie voisine demande de tenir le passage encore un moment. Belov place des caisses près des canons et rappelle de ne pas tirer trop tôt. Secteur B-054. Ordres du secteur: Couvrir les transmetteurs pendant la remise en état du poste radio.", "objective": "Couvrir les transmetteurs pendant la remise en état du poste radio.", 