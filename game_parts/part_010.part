ssure": 1.539 }, { "title": "Accès au pont · B-069", "place": "Secteur de Volokolamsk", "date": "Novembre 1941", "chapter": 1, "theme": "snow", "map": 3, "weather": "snow", "trait": "none", "base": "Accès au pont", "quote": "", "story": "Les servants travaillent désormais ensemble. Chaque nouvelle position doit permettre à l'unité voisine de se retrancher. La patrouille de nuit rapporte un croquis d'une nouvelle approche ennemie. Nina range les lettres dans une housse étanche : elles ont encore besoin d'une route sûre. Secteur B-069. Ordres du secteur: Protéger l'accès au pont contre une contre-attaque.", "objective": "Protéger l'accès au pont contre une contre-attaque.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Le dernier camion klaxonne derrière le virage. Accès au pont · B-069.", "letter": "Accès au pont · B-069. Nous apprenons à économiser le ravitaillement, mais aussi le temps des autres.", "waves": 24, "id": 268, "rank": 8.71872, "firstReward": 214, "repeatReward": 97, "layoutSeed": 19916, "original": false, "legacyId": null, "sector": 3, "orderInChapter": 69, "pressure": 1.541 }, { "title": "Huit roues en état", "place": "Secteur de Volokolamsk", "date": "Novembre 1941", "chapter": 1, "theme": "village", "map": 11, "weather": "snow", "trait": "elite", "base": "Protéger l'abri des mécaniciens", "quote": "« Nous ne tenons pas pour un point sur la carte. »", "story": "Les mécaniciens assemblent deux véhicules à partir de plusieurs épaves. L'ennemi approche de leur abri de réparation. Derrière, des gens ont besoin de calme et de temps. Devant, une route ne doit pas rester ouverte.", "objective": "Protéger l'abri des mécaniciens.", "tip": "Croisez les zones de tir. Gardez une place pour les sapeurs près du virage chargé.", "outro": "Le dernier véhicule passe le virage. Au dos de la carte, Belov écrit le nom de cette journée : « Huit roues en état ».", "letter": "« Huit roues en état. » Je me souviendrai non du combat, mais des phares du véhicule qui a franchi notre ligne.", "waves": 21, "id": 269, "rank": 8.75125, "firstReward": 202, "repeatReward": 91, "legacyId": 40, "layoutSeed": 40, "original": true, "sector": 3, "orderInChapter": 70, "pressure": 1.543 }, { "title": "Cuisine de campagne · B-071", "place": "Secteur de Volokolamsk", "date": "Novembre 1941", "chapter": 1, "theme": "village", "map": 23, "weather": "snow", "trait": "supplies", "base": "Cuisine de campagne", "quote": "", "story": "Les servants travaillent désormais ensemble. Chaque nouvelle position doit permettre à l'unité voisine de se retrancher. Un groupe de blessés rejoint l'arrière ; impossible de le presser. Les servants occupent leurs positions familières. Chacun connaît le tronçon à couvrir. Secteur B-071. Ordres du secteur: Garder le chemin de la cuisine de campagne ouvert.", "objective": "Garder le chemin de la cuisine de campagne ouvert.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Le dernier camion klaxonne derrière le virage. Cuisine de campagne · B-071.", "letter": "Cuisine de campagne · B-071. Aujourd'hui, nous gardions non pas un point sur une carte, mais la chance de quelqu'un de rentrer chez lui.", "waves": 21, "id": 270, "rank": 8.78378, "firstReward": 202, "repeatReward": 91, "layoutSeed": 19990, "original": false, "legacyId": null, "sector": 3, "orderInChapter": 71, "pressure": 1.545 }, { "title": "Relais du ravitaillement · B-072", "place": "Secteur de Volokolamsk", "date": "Novembre 1941", "chapter": 1, "theme": "village", "map": 9, "weather": "snow", "trait": "fog", "base": "Relais du ravitaillement", "quote": "", "story": "Les servants travaillent désormais ensemble. Chaque nouvelle position doit permettre à l'unité voisine de se retrancher. Un groupe de blessés rejoint l'arrière ; impossible de le presser. Les servants occupent leurs positions familières. Chacun connaît le tronçon à couvrir. Secteur B-072. Ordres du secteur: Défendre la base intermédiaire de ravitaillement.", "objective": "Défendre la base intermédiaire de ravitaillement.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Le dernier camion klaxonne derrière le virage. Relais du ravitaillement · B-072.", "letter": "Relais du ravitaillement · B-072. Aujourd'hui, nous gardions non pas un point sur une carte, mais la chance de quelqu'un de rentrer chez lui.", "waves": 23, "id": 271, "rank": 8.81632, "firstReward": 210, "repeatReward": 95, "layoutSeed": 20027, "original": false, "legacyId": null, "sector": 3, "orderInChapter": 72, "pressure": 1.547 }, { "title": "Route à dégager · B-073", "place": "Secteur de Volokolamsk", "date": "Novembre 1941", "chapter": 1, "theme": "village", "map": 19, "weather": "snow", "trait": "none", "base": "Route à dégager", "quote": "", "story": "Les servants travaillent désormais ensemble. Chaque nouvelle position doit permettre à l'unité voisine de se retrancher. Un petit pont a cédé sous la charge. Belov y laisse une équipe de réparation. Les servants occupent leurs positions familières. Chacun connaît le tronçon à couvrir. Secteur B-073. Ordres du secteur: Gagner du temps pour dégager la route.", "objective": "Gagner du temps pour dégager la route.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Une route défendue de plus est notée dans le journal de la compagnie. Route à dégager · B-073.", "letter": "Route à dégager · B-073. Aujourd'hui, nous gardions non pas un point sur une carte, mais la chance de quelqu'un de rentrer chez lui.", "waves": 23, "id": 272, "rank": 8.84885, "firstReward": 210, "repeatReward": 95, "layoutSeed": 20064, "original": false, "legacyId": null, "sector": 3, "orderInChapter": 73, "pressure": 1.549 }, { "title": "Silence radio · B-074", "place": "Secteur de Volokolamsk", "date": "Novembre 1941", "chapter": 1, "theme": "village", "map": 17, "weather": "snow", "trait": "scarcity", "base": "Silence radio", "quote": "", "story": "Les servants travaillent désormais ensemble. Chaque nouvelle position doit permettre à l'unité voisine de se retrancher. Un petit pont a cédé sous la charge. Belov y laisse une équipe de réparation. Les servants occupent leurs positions familières. Chacun connaît le tronçon à couvrir. Secteur B-074. Ordres du secteur: Couvrir les transmetteurs pendant la remise en état du poste radio.", "objective": "Couvrir les transmetteurs pendant la remise en état du poste radio.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Une route défendue de plus est notée dans le journal de la compagnie. Silence radio · B-074.", "letter": "Silence radio · B-074. Aujourd'hui, nous gardions non pas un point sur une carte, mais la chance de quelqu'un de rentrer chez lui.", "waves": 20, "id": 273, "rank": 8.88138, "firstReward": 199, "repeatReward": 89, "layoutSeed": 20101, "original": false, "legacyId": null, "sector": 3, "orderInChapter": 74, "pressure": 1.551 }, { "title": "Virage du poste médical · B-075", "place": "Secteur de Volokolamsk", "date": "Novembre 1941", "chapter": 1, "theme": "village", "map": 3, "weather": "snow", "trait": "bridgehead", "base": "Virage du poste médical", "quote": "", "story": "Les servants travaillent désormais ensemble. Chaque nouvelle position doit permettre à l'unité voisine de se retrancher. Un petit pont a cédé sous la charge. Belov y laisse une équipe de réparation. Les servants occupent leurs positions familières. Chacun connaît le tronçon à couvrir. Secteur B-075. Ordres du secteur: Tenir la