202 }, { "title": "Lazarettkurve · A-102", "place": "Vor Smolensk", "date": "Juli 1941", "chapter": 0, "theme": "marsh", "map": 15, "weather": "dust", "trait": "convoy", "base": "Lazarettkurve", "quote": "", "story": "Die Kompanie lernt noch, beim Rückzug eine Straße zu halten. Hinter jeder Kreuzung warten Menschen, die Zeit brauchen. Der Posten hört Motoren hinter den Bäumen. Für das Umladen bleibt keine Zeit. Below stellt Reservekisten neben die Geschütze und mahnt, nicht zu früh zu schießen. Abschnitt A-102. Abschnittsbefehl: Die Straße für die Sanitätswagen halten.", "objective": "Die Straße für die Sanitätswagen halten.", "tip": "Flächenfeuer mit Panzerabwehr kombinieren. Beschädigte Stellungen zwischen den Wellen reparieren; bezahlte Unterstützung ist nicht erforderlich.", "outro": "Die Linie hält. Die Kolonne passiert den Abschnitt ohne Halt. Lazarettkurve · A-102.", "letter": "Lazarettkurve · A-102. Heute bewachten wir keinen Kartenpunkt, sondern die Hoffnung eines Menschen auf Heimkehr.", "waves": 14, "id": 101, "rank": 3.28579, "firstReward": 145, "repeatReward": 62, "layoutSeed": 13737, "original": false, "legacyId": null, "sector": 5, "orderInChapter": 102, "pressure": 1.204 }, { "title": "Kisten am Weg · A-103", "place": "Vor Smolensk", "date": "Juli 1941", "chapter": 0, "theme": "marsh", "map": 1, "weather": "dust", "trait": "fog", "base": "Kisten am Weg", "quote": "", "story": "Die Kompanie lernt noch, beim Rückzug eine Straße zu halten. Hinter jeder Kreuzung warten Menschen, die Zeit brauchen. Die Nachbarkompanie bittet darum, den Durchgang noch etwas länger zu halten. Below stellt Reservekisten neben die Geschütze und mahnt, nicht zu früh zu schießen. Abschnitt A-103. Abschnittsbefehl: Das Entladen der Munition am Feldweg schützen.", "objective": "Das Entladen der Munition am Feldweg schützen.", "tip": "Flächenfeuer mit Panzerabwehr kombinieren. Beschädigte Stellungen zwischen den Wellen reparieren; bezahlte Unterstützung ist nicht erforderlich.", "outro": "Die Linie hält. Die Kolonne passiert den Abschnitt ohne Halt. Kisten am Weg · A-103.", "letter": "Kisten am Weg · A-103. Heute bewachten wir keinen Kartenpunkt, sondern die Hoffnung eines Menschen auf Heimkehr.", "waves": 15, "id": 102, "rank": 3.31832, "firstReward": 149, "repeatReward": 64, "layoutSeed": 13774, "original": false, "legacyId": null, "sector": 5, "orderInChapter": 103, "pressure": 1.206 }, { "title": "Zwei Leuchtraketen", "place": "Vor Smolensk", "date": "Juli 1941", "chapter": 0, "theme": "river", "map": 8, "weather": "dust", "trait": "convoy", "base": "Halte den Nachrichtenposten am Übergang", "quote": "„Wir halten nicht für ein Zeichen auf der Karte.“", "story": "Am anderen Ufer wartet man auf das vereinbarte Signal. Nina muss die Reihenfolge der Fahrzeuge fehlerfrei übermitteln. Hinter der Linie brauchen Menschen Ruhe und Zeit. Vor ihr liegt eine Straße, die nicht offen bleiben darf.", "objective": "Halte den Nachrichtenposten am Übergang.", "tip": "Lastwagen halten mehr aus als Infanterie. Schützen und Panzerabwehrkanonen stoppen sie.", "outro": "Sokolow erhält die Bestätigung: Menschen und Ladung sind sicher. Nina ergänzt die Geschichte der Kompanie um „Zwei Leuchtraketen“.", "letter": "„Zwei Leuchtraketen.“ Ich werde nicht den Kampflärm erinnern, sondern die Scheinwerfer des Wagens, der unsere Linie passierte.", "waves": 15, "id": 103, "rank": 3.35085, "firstReward": 149, "repeatReward": 65, "legacyId": 15, "layoutSeed": 15, "original": true, "sector": 5, "orderInChapter": 104, "pressure": 1.208 }, { "title": "Kurierroute · A-105", "place": "Vor Smolensk", "date": "Juli 1941", "chapter": 0, "theme": "river", "map": 21, "weather": "dust", "trait": "scarcity", "base": "Kurierroute", "quote": "", "story": "Die Kompanie lernt noch, beim Rückzug eine Straße zu halten. Hinter jeder Kreuzung warten Menschen, die Zeit brauchen. Die Nachbarkompanie bittet darum, den Durchgang noch etwas länger zu halten. Below stellt Reservekisten neben die Ge