 }, { "title": "Lazarettkurve · A-062", "place": "Waldstraße", "date": "Juni 1941", "chapter": 0, "theme": "village", "map": 23, "weather": "rain", "trait": "convoy", "base": "Lazarettkurve", "quote": "", "story": "Die Kompanie lernt noch, beim Rückzug eine Straße zu halten. Hinter jeder Kreuzung warten Menschen, die Zeit brauchen. Die Fahrer wechseln am Straßenrand ein Rad und verdecken dabei ihre Lampen. Below stellt Reservekisten neben die Geschütze und mahnt, nicht zu früh zu schießen. Abschnitt A-062. Abschnittsbefehl: Die Straße für die Sanitätswagen halten.", "objective": "Die Straße für die Sanitätswagen halten.", "tip": "Flächenfeuer mit Panzerabwehr kombinieren. Beschädigte Stellungen zwischen den Wellen reparieren; bezahlte Unterstützung ist nicht erforderlich.", "outro": "Die Linie hält. Die Kolonne passiert den Abschnitt ohne Halt. Lazarettkurve · A-062.", "letter": "Lazarettkurve · A-062. Nina hat die Briefe wieder gezählt. Keiner blieb auf der Straße zurück.", "waves": 11, "id": 61, "rank": 1.98448, "firstReward": 130, "repeatReward": 55, "layoutSeed": 12257, "original": false, "legacyId": null, "sector": 3, "orderInChapter": 62, "pressure": 1.123 }, { "title": "Die gebrochene Achse", "place": "Waldstraße", "date": "Juni 1941", "chapter": 0, "theme": "autumn", "map": 2, "weather": "rain", "trait": "convoy", "base": "Verteidige den Reparaturplatz", "quote": "„Nicht jede wertvolle Fracht passt auf eine Liste.“", "story": "Am letzten fahrbereiten Lastwagen bricht die Achse. Der Fahrer braucht Zeit, um aus zwei Wracks ein Fahrzeug zusammenzubauen. Bis zum nächsten Signal bleibt wenig Zeit. Die vorhandenen Kräfte müssen die Straße halten.", "objective": "Verteidige den Reparaturplatz.", "tip": "Lastwagen halten mehr aus als Infanterie. Schützen und Panzerabwehrkanonen stoppen sie.", "outro": "Sokolow erhält die Bestätigung: Menschen und Ladung sind sicher. Nina ergänzt die Geschichte der Kompanie um „Die gebrochene Achse“.", "letter": "„Die gebrochene Achse.“ Immer weniger Adressen im Heft sind ungeklärt. Eines Tages schließe ich es und schreibe ohne Eile einen Brief.", "waves": 11, "id": 62, "rank": 2.01702, "firstReward": 130, "repeatReward": 55, "legacyId": 9, "layoutSeed": 9, "original": true, "sector": 3, "orderInChapter": 63, "pressure": 1.125 }, { "title": "Holzkolonne · A-064", "place": "Waldstraße", "date": "Juni 1941", "chapter": 0, "theme": "autumn", "map": 19, "weather": "rain", "trait": "mud", "base": "Holzkolonne", "quote": "", "story": "Die Kompanie lernt noch, beim Rückzug eine Straße zu halten. Hinter jeder Kreuzung warten Menschen, die Zeit brauchen. Der Posten hört Motoren hinter den Bäumen. Für das Umladen bleibt keine Zeit. Sokolow hält Nachschub für Reparaturen zurück und prüft die letzte Kurve. Abschnitt A-064. Abschnittsbefehl: Baumaterial durch eine gefährliche Kurve geleiten.", "objective": "Baumaterial durch eine gefährliche Kurve geleiten.", "tip": "Flächenfeuer mit Panzerabwehr kombinieren. Beschädigte Stellungen zwischen den Wellen reparieren; bezahlte Unterstützung ist nicht erforderlich.", "outro": "Die Linie hält. Die Kolonne passiert den Abschnitt ohne Halt. Holzkolonne · A-064.", "letter": "Holzkolonne · A-064. Nina hat die Briefe wieder gezählt. Keiner blieb auf der Straße zurück.", "waves": 12, "id": 63, "rank": 2.04955, "firstReward": 130, "repeatReward": 55, "layoutSeed": 12331, "original": false, "legacyId": null, "sector": 3, "orderInChapter": 64, "pressure": 1.127 }, { "title": "Kurierroute · A-065", "place": "Waldstraße", "date": "Juni 1941", "chapter": 0, "theme": "autumn", "map": 5, "weather": "rain", "trait": "scarcity", "base": "Kurierroute", "quote": "", "story": "Die Kompanie lernt noch, beim Rückzug eine Straße zu halten. Hinter jeder Kreuzung warten Menschen, die Zeit brauchen. Der Posten hört Motoren hinter den Bäumen. Für das Umladen bleibt keine Zeit. Sokolow hält Nachschub für Reparaturen zurück und prüft die letzte Kurve. Abschnitt A-065. Abschnittsbefehl: Den Weg für Kuriere und Feldpost offen halten.", "objective": "Den Weg für Kuriere und Feldpost offen halten.", "tip": "Flächenfeuer mit Panzerabwehr kombinieren. Beschädigte Stellungen zwischen den Wellen reparieren; bezahlte Unterstützung ist nicht erforderlich.", "outro": "Die Linie hält. Die Funker melden: Die Route funktioniert wieder. Kurierroute · A-065.", "letter": "Kurierroute · A-065. Nina hat die Briefe wieder gezählt. Keiner blieb auf der Straße zurück.", "waves": 12, "id": 64, "rank": 2.08208, "firstReward": 131, "repeatReward": 55, "layoutSeed": 12368, "original": false, "legacyId": null, "sector": 3, "orderInChapter": 65, "pressure": 1.129 }, { "title": "Wasserpumpe · A-066", "place": "Waldstraße", "date": "Juni 1941", "chapter": 0, "theme": "autumn", "map": 15, "weather": "rain", "trait": "none", "base": "Wasserpumpe", "quote": "", "story": "Die Kompanie lernt noch, beim Rückzug eine Straße zu halten. Hinter jeder Kreuzung warten Menschen, die Zeit brauchen. Der Posten hört Motoren hinter den Bäumen. Für das Umladen bleibt keine Zeit. Sokolow hält Nachschub für Reparaturen zurück und prüft die letzte Kurve. Abschnitt A-066. Abschnittsbefehl: Das Beladen der Wasserwagen an der Pumpe ermöglichen.", "objective": "Das Beladen der Wasserwagen an der Pumpe ermöglichen.", "tip": "Flächenfeuer mit Panzerabwehr kombinieren. Beschädigte Stellungen zwischen den Wellen reparieren; bezahlte Unterstützung ist nicht erforderlich.", "outro": "Die Linie hält. Die Funker melden: Die Route funktioniert wieder. Wasserpumpe · A-066.", "letter": "Wasserpumpe · A-066. Die Müdigkeit kommt nach dem Kampf. Solange die Kolonne hinter uns fährt, spüren wir sie kaum.", "waves": 11, "id": 65, "rank": 2.11461, "firstReward": 131, "repeatReward": 55, "layoutSeed": 12405, "original": false, "legacyId": null, "sector": 3, "orderInChapter": 66, "pressure": 1.131 }, { "title": "Reparaturhof · A-067", "place": "Waldstraße", "date": "Juni 1941", "chapter": 0, "theme": "autumn", "map": 1, "wea