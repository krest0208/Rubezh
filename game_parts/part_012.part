, { "title": "Route à dégager · E-172", "place": "Berlin", "date": "Mai 1945", "chapter": 4, "theme": "ruins", "map": 18, "weather": "ash", "trait": "mud", "base": "Route à dégager", "quote": "", "story": "Le sac postal s'allège, mais les convois ont toujours besoin d'une route sûre. La compagnie tient sa promesse du premier jour. Un petit pont a cédé sous la charge. Belov y laisse une équipe de réparation. Nina range les lettres dans une housse étanche : elles ont encore besoin d'une route sûre. Secteur E-172. Ordres du secteur: Gagner du temps pour dégager la route.", "objective": "Gagner du temps pour dégager la route.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Les transmetteurs annoncent que l'itinéraire fonctionne à nouveau. Route à dégager · E-172.", "letter": "Route à dégager · E-172. La fatigue vient après le combat. Tant que le convoi passe derrière nous, nous la sentons à peine.", "waves": 45, "id": 971, "rank": 31.58909, "firstReward": 419, "repeatReward": 201, "layoutSeed": 45927, "original": false, "legacyId": null, "sector": 8, "orderInChapter": 172, "pressure": 2.959 }, { "title": "Les pavés après la pluie", "place": "Berlin", "date": "Mai 1945", "chapter": 4, "theme": "industrial", "map": 5, "weather": "ash", "trait": "scouts", "base": "Couvrir la colonne sanitaire", "quote": "« Après chaque virage, quelqu'un attend notre aide. »", "story": "Les pierres mouillées reflètent les phares des ambulances. Belov place ses servants au virage et leur ouvre la voie. La compagnie fortifie la route. Chaque minute gagnée aide à accomplir la mission.", "objective": "Couvrir la colonne sanitaire.", "tip": "Le ravitaillement initial est accru. Couvrez plusieurs secteurs avant d'améliorer les positions.", "outro": "Les servants ne partent qu'après le signal de fin. Belov marque « Les pavés après la pluie » sur la carte du trajet.", "letter": "« Les pavés après la pluie. » Nous avons encore gardé l'espoir d'autrui. Le chemin du retour se compose peut-être de ces petits gestes.", "waves": 50, "id": 972, "rank": 31.62162, "firstReward": 439, "repeatReward": 211, "legacyId": 145, "layoutSeed": 145, "original": true, "sector": 8, "orderInChapter": 173, "pressure": 2.961 }, { "title": "Virage du poste médical · E-174", "place": "Berlin", "date": "Mai 1945", "chapter": 4, "theme": "industrial", "map": 2, "weather": "ash", "trait": "none", "base": "Virage du poste médical", "quote": "", "story": "Le sac postal s'allège, mais les convois ont toujours besoin d'une route sûre. La compagnie tient sa promesse du premier jour. Un petit pont a cédé sous la charge. Belov y laisse une équipe de réparation. Nina range les lettres dans une housse étanche : elles ont encore besoin d'une route sûre. Secteur E-174. Ordres du secteur: Tenir la route pour les ambulances.", "objective": "Tenir la route pour les ambulances.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Les sapeurs retirent les obstacles pour laisser passer les véhicules amis. Virage du poste médical · E-174.", "letter": "Virage du poste médical · E-174. La fatigue vient après le combat. Tant que le convoi passe derrière nous, nous la sentons à peine.", "waves": 50, "id": 973, "rank": 31.65415, "firstReward": 439, "repeatReward": 211, "layoutSeed": 46001, "original": false, "legacyId": null, "sector": 8, "orderInChapter": 174, "pressure": 2.963 }, { "title": "Caisses au bord du chemin · E-175", "place": "Berlin", "date": "Mai 1945", "chapter": 4, "theme": "industrial", "map": 12, "weather": "ash", "trait": "none", "base": "Caisses au bord du chemin", "quote": "", "story": "Le sac postal s'allège, mais les convois ont toujours besoin d'une route sûre. La compagnie tient sa promesse du premier jour. Ce virage est mal indiqué sur la carte. Les éclaireurs vérifient la route juste avant le combat. Nina range les lettres dans une housse étanche : elles ont encore besoin d'une route sûre. Secteur E-175. Ordres du secteur: Protéger le déchargement des munitions près du chemin.", "objective": "Protéger le déchargement des munitions près du chemin.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Les sapeurs retirent les obstacles pour laisser passer les véhicules amis. Caisses au bord du chemin · E-175.", "letter": "Caisses au bord du chemin · E-175. La fatigue vient après le combat. Tant que le convoi passe derrière nous, nous la sentons à peine.", "waves": 50, "id": 974, "rank": 31.68669, "firstReward": 439, "repeatReward": 211, "layoutSeed": 46038, "original": false, "legacyId": null, "sector": 8, "orderInChapter": 175, "pressure": 2.965 }, { "title": "Convoi de bois · E-176", "place": "Berlin", "date": "Mai 1945", "chapter": 4, "theme": "industrial", "map": 22, "weather": "ash", "trait": "scouts", "base": "Convoi de bois", "quote": "", "story": "Le sac postal s'allège, mais les convois ont toujours besoin d'une route sûre. La compagnie tient sa promesse du premier jour. Ce virage est mal indiqué sur la carte. Les éclaireurs vérifient la route juste avant le combat. Les servants occupent leurs positions familières. Chacun connaît le tronçon à couvrir. Secteur E-176. Ordres du secteur: Faire passer les matériaux de construction dans un virage dangereux.", "objective": "Faire passer les matériaux de construction dans un virage dangereux.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Les sapeurs retirent les obstacles pour laisser passer les véhicules amis. Convoi de bois · E-176.", "letter": "Convoi de bois · E-176. Nous apprenons à économiser le ravitaillement, mais aussi le temps des autres.", "waves": 48, "id": 975, "rank": 31.71922, "firstReward": 432, "repeatReward": 207, "layoutSeed": 46075, "original": false, "legacyId": null, "sector": 8, "orderInChapter": 176, "pressure": 2.967 }, { "title": "Itinéraire des courriers · E-177", "place": "Berlin", "date": "Mai 1945", "chapter": 4, "theme": "industrial", "map": 8, "weather": "ash", "trait": "supplies", "base": "Itinéraire des courriers", "quote": "", "story": "Le sac postal s'allège, mais les convois ont toujours besoin d'une route sûre. La compagnie tient sa promesse du premier jour. Ce virage est mal indiqué sur la carte. Les éclaireurs vérifient la route juste avant le combat. Les servants occupent leurs positions familières. Chacun connaît le tronçon à couvrir. Secteur E-177. Ordres du secteur: Garder le passage ouvert aux courriers et à la poste de campagne.", "objective": "Garder le passage ouvert aux courriers et à la poste de campagne.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Le dernier camion klaxonne derrière le virage. Itinéraire des courriers · E-177.", "letter": "Itinéraire des courriers · E-177. Nous apprenons à économiser le ravitaillement, mais aussi le temps des autres.", "waves": 48, "id": 976, "rank": 31.75175, "firstReward": 432, "repeatReward": 207, "layoutSeed": 46112, "original": false, "legacyId": null, "sector": 8, "orderInChapter": 177, "pressure": 2.969 }, { "title": "Pompe à eau · E-178", "place": "Berlin", "date": "Mai 1945", "chapter": 4, "theme": "industrial", "map": 18, "weather": "ash", "trait": "armor", "base": "Pompe à eau", "quote": "", "story": "Le sac postal s'allège, mais les convois ont toujours besoin d'une route sûre. La compagnie tient sa promesse du premier jour. Le dernier camion n'est pas encore arrivé : il est trop tôt pour quitter la position. Les servants occupent leurs positions familières. Chacun connaît le tronçon à couvrir. Secteur E-178. Ordres du secteur: Laisser les camions-citernes terminer leur chargement à la pompe.", "objective": "Laisser les camions-citernes terminer leur chargement à la pompe.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Le dernier camion klaxonne derrière le virage. Pompe à eau · E-178.", "letter": "Pompe à eau · E-178. Nous apprenons à économiser le ravitaillement, mais aussi le temps des autres.", "waves": 46, "id": 977, "rank": 31.78428, "firstReward": 424, "repeatReward": 203, "layoutSeed": 46149, "original": false, "legacyId": null, "sector": 8, "orderInChapter": 178, "pressure": 2.971 }, { "title": "Le sac au fil rouge", "place": "Berlin", "date": "Mai 1945", "chapter": 4, "theme": "ruins", "map": 8, "weather": "ash", "trait": "supplies", "base": "Défendre le nœud de transmissions de campagne", "quote": "« Une bonne position économise plus d'obus qu'une caisse pleine. »", "story": "Le même sac postal est posé près de la radio. Nina vérifie le dernier paquet non envoyé. Sokolov choisit les positions, Nina établit les liaisons et Belov répartit les munitions.", "objective": "Défendre le nœud de transmissions de campagne.", "tip": "Les camions résistent mieux que l'infanterie. Tireurs et canons antichars aident à les arrêter.", "outro": "Sokolov reçoit confirmation : personnes et cargaison sont en sécurité. Nina ajoute « Le sac au fil rouge » à l'histoire de la compagnie.", "letter": "« Le sac au fil rouge. » Belov dit qu'une route se souvient de ceux qui l'ont réparée. J'espère qu'elle se souvient aussi des sauvés.", "waves": 46, "id": 978, "rank": 31.81682, "firstReward": 424, "repeatReward": 203, "legacyId": 146, "layoutSeed": 146, "original": true, "sector": 8, "orderInChapter": 179, "pressure": 2.973 }, { "title": "Carrefour des champs · E-180", "place": "Berlin", "date": "Mai 1945", "chapter": 4, "theme": "ruins", "map": 14, "weather": "ash", "trait": "armor", "base": "Carrefour des champs", "quote": "", "story": "Le sac postal s'allège, mais les convois ont toujours besoin d'une route sûre. La compagnie tient sa promesse du premier jour. Le dernier camion n'est pas encore arrivé : il est trop tôt pour quitter la position. Les servants occupent leurs positions familières. Chacun connaît le tronçon à couvrir. Secteur E-180. Ordres du secteur: Empêcher une percée vers le carrefour des champs.", "objective": "Empêcher une percée vers le carrefour des champs.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Le dernier camion klaxonne derrière le virage. Carrefour des champs · E-180.", "letter": "Carrefour des champs · E-180. Nous apprenons à économiser le ravitaillement, mais aussi le temps des autres.", "waves": 50, "id": 979, "rank": 31.84935, "firstReward": 440, "repeatReward": 211, "layoutSeed": 46223, "original": false, "legacyId": null, "sector": 8, "orderInChapter": 180, "pressure": 2.975 }, { "title": "Fil à travers le bois · E-181", "place": "Berlin", "date": "Mai 1945", "chapter": 4, "theme": "ruins", "map": 1, "weather": "ash", "trait": "bridgehead", "base": "Fil à travers le bois", "quote": "", "story": "Le sac postal s'allège, mais les convois ont toujours besoin d'une route sûre. La compagnie tient sa promesse du premier jour. Les conducteurs changent une roue sur le bas-côté en masquant leurs lampes. Les servants occupent leurs positions familières. Chacun connaît le tronçon à couvrir. Secteur E-181. Ordres du secteur: Couvrir la pose d'une nouvelle ligne téléphonique.", "objective": "Couvrir la pose d'une nouvelle ligne téléphonique.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Une route défendue de plus est notée dans le journal de la compagnie. Fil à travers le bois · E-181.", "letter": "Fil à travers le bois · E-181. Aujourd'hui, nous gardions non pas un point sur une carte, mais la chance de quelqu'un de rentrer chez lui.", "waves": 50, "id": 980, "rank": 31.88188, "firstReward": 440, "repeatReward": 212, "layoutSeed": 46260, "original": false, "legacyId": null, "sector": 9, "orderInChapter": 181, "pressure": 2.977 }, { "title": "Patrouille de sapeurs · E-182", "place": "Berlin", "date": "Mai 1945", "chapter": 4, "theme": "ruins", "map": 11, "weather": "ash", "trait": "none", "base": "Patrouille de sapeurs", "quote": "", "story": "Le sac postal s'allège, mais les convois ont toujours besoin d'une route sûre. La compagnie tient sa promesse du premier jour. Les conducteurs changent une roue sur le bas-côté en masquant leurs lampes. Les servants occupent leurs positions familières. Chacun connaît le tronçon à couvrir. Secteur E-182. Ordres du secteur: Tenir la route pendant que les sapeurs vérifient le prochain tronçon.", "objective": "Tenir la route pendant que les sapeurs vérifient le prochain tronçon.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Une route défendue de plus est notée dans le journal de la compagnie. Patrouille de sapeurs · E-182.", "letter": "Patrouille de sapeurs · E-182. Aujourd'hui, nous gardions non pas un point sur une carte, mais la chance de quelqu'un de rentrer chez lui.", "waves": 50, "id": 981, "rank": 31.91441, "firstReward": 441, "repeatReward": 212, "layoutSeed": 46297, "original": false, "legacyId": null, "sector": 9, "orderInChapter": 182, "pressure": 2.979 }, { "title": "Route du moulin · E-183", "place": "Berlin", "date": "Mai 1945", "chapter": 4, "theme": "ruins", "map": 21, "weather": "ash", "trait": "convoy", "base": "Route du moulin", "quote": "", "story": "Le sac postal s'allège, mais les convois ont toujours besoin d'une route sûre. La compagnie tient sa promesse du premier jour. Les conducteurs changent une roue sur le bas-côté en masquant leurs lampes. Sokolov répartit les secteurs de tir tandis que Belov vérifie les abris. Secteur E-183. Ordres du secteur: Protéger la livraison de farine et de provisions.", "objective": "Protéger la livraison de farine et de provisions.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Une route défendue de plus est notée dans le journal de la compagnie. Route du moulin · E-183.", "letter": "Route du moulin · E-183. Aujourd'hui, nous gardions non pas un point sur une carte, mais la chance de quelqu'un de rentrer chez lui.", "waves": 50, "id": 982, "rank": 31.94695, "firstReward": 441, "repeatReward": 212, "layoutSeed": 46334, "original": false, "legacyId": null, "sector": 9, "orderInChapter": 183, "pressure": 2.981 }, { "title": "Point de rassemblement · E-184", "place": "Berlin", "date": "Mai 1945", "chapter": 4, "theme": "ruins", "map": 7, "weather": "ash", "trait": "supplies", "base": "Point de rassemblement", "quote": "", "story": "Le sac postal s'allège, mais les convois ont toujours besoin d'une route sûre. La compagnie tient sa promesse du premier jour. La sentinelle entend des moteurs derrière les arbres. Il ne reste plus de temps pour déplacer le chargement. Sokolov répartit les secteurs de tir tandis que Belov vérifie les abris. Secteur E-184. Ordres du secteur: Garder ouvert le passage du point de rassemblement vers l'arrière.", "objective": "Garder ouvert le passage du point de rassemblement vers l'arrière.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Une route défendue de plus est notée dans le journal de la compagnie. Point de rassemblement · E-184.", "letter": "Point de rassemblement · E-184. Aujourd'hui, nous gardions non pas un point sur une carte, mais la chance de quelqu'un de rentrer chez lui.", "waves": 49, "id": 983, "rank": 31.97948, "firstReward": 437, "repeatReward": 210, "layoutSeed": 46371, "original": false, "legacyId": null, "sector": 9, "orderInChapter": 184, "pressure": 2.983 }, { "title": "Poste d'observation · E-185", "place": "Berlin", "date": "Mai 1945", "chapter": 4, "theme": "ruins", "map": 17, "weather": "ash", "trait": "mud", "base": "Poste d'observation", "quote": "", "story": "Le sac postal s'allège, mais les convois ont toujours besoin d'une route sûre. La compagnie tient sa promesse du premier jour. La sentinelle entend des moteurs derrière les arbres. Il ne reste plus de temps pour déplacer le chargement. Sokolov répartit les secteurs de tir tandis que Belov vérifie les abris. Secteur E-185. Ordres du secteur: Défendre les accès au poste d'observation.", "objective": "Défendre les accès au poste d'observation.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Le convoi traverse le secteur sans s'arrêter. Poste d'observation · E-185.", "letter": "Poste d'observation · E-185. Aujourd'hui, nous gardions non pas un point sur une carte, mais la chance de quelqu'un de rentrer chez lui.", "waves": 49, "id": 984, "rank": 32.01201, "firstReward": 437, "repeatReward": 210, "layoutSeed": 46408, "original": false, "legacyId": null, "sector": 9, "orderInChapter": 185, "pressure": 2.985 }, { "title": "L'adresse de retour", "place": "Berlin", "date": "Mai 1945", "chapter": 4, "theme": "village", "map": 11, "weather": "ash", "trait": "armor", "base": "Protéger la route du transport postal", "quote": "« Peu importe la longueur du chemin, s'il mène chez nous. »", "story": "Sokolov écrit l'adresse de sa compagnie sur une enveloppe. Pour la première fois depuis longtemps, il croit qu'une réponse pourra les retrouver. Se replier maintenant laisserait des gens sans protection. La compagnie accepte le combat ici.", "objective": "Protéger la route du transport postal.", "tip": "Croisez les zones de tir. Gardez une place pour les sapeurs près du virage chargé.", "outro": "Le dernier véhicule passe le virage. Au dos de la carte, Belov écrit le nom de cette journée : « L'adresse de retour ».", "letter": "« L'adresse de retour. » Nous avons gagné une minute de calme. Je l'ai utilisée pour terminer ces lignes.", "waves": 47, "id": 985, "rank": 32.04454, "firstReward": 429, "repeatReward": 206, "legacyId": 147, "layoutSeed": 147, "original": true, "sector": 9, "orderInChapter": 186, "pressure": 2.987 }, { "title": "Dépôt de vivres · E-187", "place": "Berlin", "date": "Mai 1945", "chapter": 4, "theme": "village", "map": 13, "weather": "ash", "trait": "none", "base": "Dépôt de vivres", "quote": "", "story": "Le sac postal s'allège, mais les convois ont toujours besoin d'une route sûre. La compagnie tient sa promesse du premier jour. La compagnie voisine demande de tenir le passage encore un moment. Sokolov répartit les secteurs de tir tandis que Belov vérifie les abris. Secteur E-187. Ordres du secteur: Tenir la route du dépôt de vivres.", "objective": "Tenir la route du dépôt de vivres.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Le convoi traverse le secteur sans s'arrêter. Dépôt de vivres · E-187.", "letter": "Dépôt de vivres · E-187. Belov dit qu'une bonne position commence par le souci de l'équipe voisine.", "waves": 47, "id": 986, "rank": 32.07708, "firstReward": 430, "repeatReward": 206, "layoutSeed": 46482, "original": false, "legacyId": null, "sector": 9, "orderInChapter": 187, "pressure": 2.989 }, { "title": "Accès au pont · E-188", "place": "Berlin", "date": "Mai 1945", "chapter": 4, "theme": "village", "map": 23, "weather": "ash", "