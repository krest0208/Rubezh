egacyId": null, "sector": 3, "orderInChapter": 75, "pressure": 1.553 }, { "title": "Белая веха", "place": "Волоколамское направление", "date": "Ноябрь 1941", "chapter": 1, "theme": "snow", "map": 2, "weather": "snow", "trait": "scouts", "base": "Оборонять подходы к переезду", "quote": "«За каждым поворотом дороги кто-то ждёт нашей помощи».", "story": "Ночью у переезда ставят заметный столб. Он должен показать дорогу тем, кто ещё не вернулся к своим. Рота разворачивает укрепления у дороги. Каждая выигранная минута помогает выполнить задачу.", "objective": "Оборонять подходы к переезду.", "tip": "Не тратьте весь запас сразу. Сочетайте улучшения с постройкой позиций на следующем участке.", "outro": "Дорога снова принадлежит колонне. Нина проверяет письма, а Соколов благодарит расчёты за удержанный рубеж «Белая веха».", "letter": "«Белая веха». Сегодня мы опять охраняли чужую надежду. Наверное, именно из таких небольших дел и складывается дорога домой.", "waves": 22, "id": 275, "rank": 8.94645, "firstReward": 207, "repeatReward": 94, "legacyId": 41, "layoutSeed": 41, "original": true, "sector": 3, "orderInChapter": 76, "pressure": 1.555 }, { "title": "Лесовозная колонна · B-077", "place": "Волоколамское направление", "date": "Ноябрь 1941", "chapter": 1, "theme": "snow", "map": 23, "weather": "snow", "trait": "convoy", "base": "Лесовозная колонна", "quote": "", "story": "Теперь расчёты действуют сообща. Каждая новая позиция должна дать соседнему подразделению возможность закрепиться. На карте этот поворот отмечен неверно. Разведчики уточняют маршрут прямо перед боем. Расчёты занимают проверенные позиции. На этот раз каждый знает, какую часть дороги он прикрывает. Участок B-077. Задача участка: Провести колонну со стройматериалами через опасный поворот.", "objective": "Провести колонну со стройматериалами через опасный поворот.", "tip": "Сочетайте огонь по площади с противотанковыми орудиями. Между волнами чините повреждённые позиции; платная поддержка не обязательна.", "outro": "Рубеж удержан. Колонна проходит участок без остановки. Лесовозная колонна · B-077.", "letter": "Лесовозная колонна · B-077. Белов говорит, что хорошая позиция начинается с заботы о соседнем расчёте.", "waves": 22, "id": 276, "rank": 8.97898, "firstReward": 207, "repeatReward": 94, "layoutSeed": 20212, "original": false, "legacyId": null, "sector": 3, "orderInChapter": 77, "pressure": 1.557 }, { "title": "Курьерский маршрут · B-078", "place": "Волоколамское направление", "date": "Ноябрь 1941", "chapter": 1, "theme": "snow", "map": 9, "weather": "snow", "trait": "armor", "base": "Курьерский маршрут", "quote": "", "story": "Теперь расчёты действуют сообща. Каждая новая позиция должна дать соседнему подразделению возможность закрепиться. На карте этот поворот отмечен неверно. Разведчики уточняют маршрут прямо перед боем. Соколов распределяет сектора огня, а Белов проверяет укрытия расчётов. Участок B-078. Задача участка: Сохранить проход для курьеров и полевой почты.", "objective": "Сохранить проход для курьеров и полевой почты.", "tip": "Сочетайте огонь по площади с противотанковыми орудиями. Между волнами чините повреждённые позиции; платная поддержка не обязательна.", "outro": "Рубеж удержан. Колонна проходит участок без остановки. Курьерский маршрут · B-078.", "letter": "Курьерский маршрут · B-078. Белов говорит, что хорошая позиция начинается с заботы о соседнем расчёте.", "waves": 24, "id": 277, "rank": 9.01151, "firstReward": 215, "repeatReward": 98, "layoutSeed": 20249, "original": false, "legacyId": null, "sector": 3, "orderInChapter": 78, "pressure": 1.559 }, { "title": "Водокачка · B-079", "place": "Волоколамское направление", "date": "Ноябрь 1941", "chapter": 1, "theme": "snow", "map": 19, "weather": "snow", "trait": "armor", "base": "Водокачка", "quote": "", "story": "Теперь расчёты действуют сообща. Каждая новая позиция должна дать соседнему подразделению возможность закрепиться. Последний грузовик ещё не пришёл, и отходить с позиции рано. Соколов