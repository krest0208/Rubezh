map": 11, "weather": "snow", "trait": "elite", "base": "保卫维修棚", "quote": "“我们坚守，不是为了地图上的标记。”", "story": "机械师从几辆坏车中拼出两辆能开的车辆，敌人却正逼近维修棚。 身后的人需要安静与时间，前方的道路则不能任敌通行。", "objective": "保卫维修棚。", "tip": "这条路需要交叉火力。记得在敌人密集的弯道旁为工兵留位置。", "outro": "最后一辆车驶过转弯。别洛夫在地图背面写下这一天的名字：“八个完好的轮子”。", "letter": "“八个完好的轮子”。我会记住的不是枪炮声，而是及时穿过我们防线的车灯。", "waves": 21, "id": 269, "rank": 8.75125, "firstReward": 202, "repeatReward": 91, "legacyId": 40, "layoutSeed": 40, "original": true, "sector": 3, "orderInChapter": 70, "pressure": 1.543 }, { "title": "野战炊事点 · B-071", "place": "沃洛科拉姆斯克方向", "date": "1941年11月", "chapter": 1, "theme": "village", "map": 23, "weather": "snow", "trait": "supplies", "base": "野战炊事点", "quote": "", "story": "各炮组已能协同行动。每处新阵地都要为友邻部队争取构筑工事的时间。 一队伤员正在撤往后方，他们无法走得更快。 炮组进入熟悉的阵地，每个人都知道自己要掩护哪段道路。 防区 B-071. 防区命令: 保持通往野战炊事点的道路畅通。", "objective": "保持通往野战炊事点的道路畅通。", "tip": "将范围火力与反坦克炮搭配使用。在波次间修理受损阵地，付费支援并非必需。", "outro": "防线守住了。 最后一辆卡车在弯道后鸣笛。 野战炊事点 · B-071.", "letter": "野战炊事点 · B-071. 今天我们守的不是地图上的一个点，而是某个人回家的机会。", "waves": 21, "id": 270, "rank": 8.78378, "firstReward": 202, "repeatReward": 91, "layoutSeed": 19990, "original": false, "legacyId": null, "sector": 3, "orderInChapter": 71, "pressure": 1.545 }, { "title": "补给中转站 · B-072", "place": "沃洛科拉姆斯克方向", "date": "1941年11月", "chapter": 1, "theme": "village", "map": 9, "weather": "snow", "trait": "fog", "base": "补给中转站", "quote": "", "story": "各炮组已能协同行动。每处新阵地都要为友邻部队争取构筑工事的时间。 一队伤员正在撤往后方，他们无法走得更快。 炮组进入熟悉的阵地，每个人都知道自己要掩护哪段道路。 防区 B-072. 防区命令: 防守补给中转基地。", "objective": "防守补给中转基地。", "tip": "将范围火力与反坦克炮搭配使用。在波次间修理受损阵地，付费支援并非必需。", "outro": "防线守住了。 最后一辆卡车在弯道后鸣笛。 补给中转站 · B-072.", "letter": "补给中转站 · B-072. 今天我们守的不是地图上的一个点，而是某个人回家的机会。", "waves": 23, "id": 271, "rank": 8.81632, "firstReward": 210, "repeatReward": 95, "layoutSeed": 20027, "original": false, "legacyId": null, "sector": 3, "orderInChapter": 72, "pressure": 1.547 }, { "title": "清理路障 · B-073", "place": "沃洛科拉姆斯克方向", "date": "1941年11月", "chapter": 1, "theme": "village", "map": 19, "weather": "snow"