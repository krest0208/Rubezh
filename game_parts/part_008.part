re": 2.013 }, { "title": "通往修理厂", "place": "斯大林格勒外围", "date": "1942年11月", "chapter": 2, "theme": "snow", "map": 8, "weather": "snow", "trait": "elite", "base": "保护维修车队", "quote": "“我们坚守，不是为了地图上的标记。”", "story": "几辆发动机故障的车辆正被拖行。为了让它们通过，连队在转弯处迎战。 身后的人需要安静与时间，前方的道路则不能任敌通行。", "objective": "保护维修车队。", "tip": "卡车比步兵更耐打，步枪队和反坦克炮能帮助拦截。", "outro": "索科洛夫收到确认：人员和货物均已安全。妮娜为连队故事添上一页“通往修理厂”。", "letter": "“通往修理厂”。我会记住的不是枪炮声，而是及时穿过我们防线的车灯。", "waves": 30, "id": 503, "rank": 16.36386, "firstReward": 278, "repeatReward": 130, "legacyId": 75, "layoutSeed": 75, "original": true, "sector": 5, "orderInChapter": 104, "pressure": 2.015 }, { "title": "补给中转站 · C-105", "place": "斯大林格勒外围", "date": "1942年11月", "chapter": 2, "theme": "snow", "map": 9, "weather": "snow", "trait": "scouts", "base": "补给中转站", "quote": "", "story": "补给线成了连接前线与后方的细线。哪怕一条小小的绕行路也不能无人守卫。 司机在路边换轮胎，用雨布遮住灯光。 妮娜把信件装进防水袋，今天它们仍需要一条安全的路。 防区 C-105. 防区命令: 防守补给中转基地。", "objective": "防守补给中转基地。", "tip": "将范围火力与反坦克炮搭配使用。在波次间修理受损阵地，付费支援并非必需。", "outro": "防线守住了。 最后一辆卡车在弯道后鸣笛。 补给中转站 · C-105.", "letter": "补给中转站 · C-105. 妮娜又数了一遍信件，没有一封落在路上。", "waves": 30, "id": 504, "rank": 16.3964, "firstReward": 278, "repeatReward": 130, "layoutSeed": 28648, "original": false, "legacyId": null, "sector": 5, "orderInChapter": 105, "pressure": 2.017 }, { "title": "清理路障 · C-106", "place": "斯大林格勒外围", "date": "1942年11月", "chapter": 2, "theme": "snow", "map": 19, "weather": "snow", "trait": "convoy", "base": "清理路障", "quote": "", "story": "补给线成了连接前线与后方的细线。哪怕一条小小的绕行路也不能无人守卫。 哨兵听见树林后的引擎声，已经来不及转移货物。 炮组进入熟悉的阵地，每个人都知道自己要掩护哪段道路。 防区 C-106. 防区命令: 为清理道路障碍争取时间。", "objective": "为清理道路障碍争取时间。", "tip": "将范围火力与反坦克炮搭配使用。在波次间修理受损阵地，付费支援并非必需。", "outro": "防线守住了。 最后一辆卡车在弯道后鸣笛。 清理路障 · C-106.", "letter": "清理路障 · C-106. 疲倦总在战斗结束后到来。只要身后的车队还在前进，我们几乎察觉不到。", "waves": 32, "id": 505, "rank": 16.42893, "firstReward": 287, "repeatReward": 134, "layoutSeed": 28685, "original": false, "legacyId": null, "sector": 5, "orderInChapter": 106, "pressure": 2.019 }, { "title": "无线电静默 · C-107", "place": "