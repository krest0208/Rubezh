, "map": 5, "weather": "rain", "trait": "mud", "base": "路边掩蔽所", "quote": "", "story": "连队仍在学习如何在撤退中守住道路。每个路口后面，都有人需要更多时间。 一座小桥被货物压塌，别洛夫留下一支抢修队。 妮娜把信件装进防水袋，今天它们仍需要一条安全的路。 防区 A-197. 防区命令: 掩护路边的临时掩蔽所。", "objective": "掩护路边的临时掩蔽所。", "tip": "将范围火力与反坦克炮搭配使用。在波次间修理受损阵地，付费支援并非必需。", "outro": "防线守住了。 连队日志上又记下一条守住的道路。 路边掩蔽所 · A-197.", "letter": "路边掩蔽所 · A-197. 我们学着节约的不只是补给，还有彼此的时间。", "waves": 19, "id": 196, "rank": 6.37638, "firstReward": 181, "repeatReward": 81, "layoutSeed": 17252, "original": false, "legacyId": null, "sector": 9, "orderInChapter": 197, "pressure": 1.395 }, { "title": "野战炊事点 · A-198", "place": "维亚济马方向", "date": "1941年10月", "chapter": 0, "theme": "mud", "map": 15, "weather": "rain", "trait": "none", "base": "野战炊事点", "quote": "", "story": "连队仍在学习如何在撤退中守住道路。每个路口后面，都有人需要更多时间。 一座小桥被货物压塌，别洛夫留下一支抢修队。 妮娜把信件装进防水袋，今天它们仍需要一条安全的路。 防区 A-198. 防区命令: 保持通往野战炊事点的道路畅通。", "objective": "保持通往野战炊事点的道路畅通。", "tip": "将范围火力与反坦克炮搭配使用。在波次间修理受损阵地，付费支援并非必需。", "outro": "防线守住了。 连队日志上又记下一条守住的道路。 野战炊事点 · A-198.", "letter": "野战炊事点 · A-198. 我们学着节约的不只是补给，还有彼此的时间。", "waves": 20, "id": 197, "rank": 6.40891, "firstReward": 185, "repeatReward": 83, "layoutSeed": 17289, "original": false, "legacyId": null, "sector": 9, "orderInChapter": 198, "pressure": 1.397 }, { "title": "补给中转站 · A-199", "place": "维亚济马方向", "date": "1941年10月", "chapter": 0, "theme": "mud", "map": 1, "weather": "rain", "trait": "none", "base": "补给中转站", "quote": "", "story": "连队仍在学习如何在撤退中守住道路。每个路口后面，都有人需要更多时间。 地图上的弯道位置有误，侦察兵在战斗前重新确认路线。 妮娜把信件装进防水袋，今天它们仍需要一条安全的路。 防区 A-199. 防区命令: 防守补给中转基地。", "objective": "防守补给中转基地。", "tip": "将范围火力与反坦克炮搭配使用。在波次间修理受损阵地，付费支援并非必需。", "outro": "防线守住了。 连队日志上又记下一条守住的道路。 补给中转站 · A-199.", "letter": "补给中转站 · A-199. 我们学着节约的不只是补给，还有彼此的时间。", "waves": 20, "id": 198, "rank": 6.44144, "firstReward": 186, "repeatReward": 83, "layoutSeed": 17326, "original": false, "legacyId": null, "sector": 9, "orderInChapter": 199, "pressure": 1.399 }, { "title": "林间休整", "place": "维亚济马方向", "date": "1941年10月", "chapter": 0, "theme": "forest", "map": 2, "weather": "rain", "trait": "convoy", "base": "保卫夜间营地", "quote": "“并非所有重要的货物都能写进清单。”", "story": "连队终于能休息一小时。索科洛夫派出前哨，却很快收到他们带回的警报。 下次信号即将到来，必须用现有兵力守住道路。", "objective": "保卫夜间营地。", "tip": "不要一次花光补给。升级与在后续地段建造新阵地应当兼顾。", "outro": "道路重新交还车队。妮娜检查信件，索科洛夫感谢炮组守住了“林间休整”。", "letter": "“林间休整”。笔记里未辨明的地址越来越少。总有一天，我会合上它，不慌不忙地写封信。", "waves": 18, "id": 199, "rank": 6.47397, "firstReward": 178, "repeatReward": 79, "legacyId": 29, "layoutSeed": 29, "original": true, "sector": 9, "orderInChapter": 200, "pressure": 1.401 }, { "title": "秋季防线", "place": "莫扎伊斯克方向", "date": "1941年10月", "chapter": 1, "theme": "mud", "map": 6, "weather": "rain", "trait": "mud", "base": "防御指挥部", "quote": "“铁锹成了我们的第一件武器。”", "story": "年轻工兵补入连队，与当地居民一起在道路旁挖掘阵地。索科洛夫教他们计算争取到的时间，而不是射出的弹药。泥泞拖慢了来敌，但新的攻势仍不断穿过湿透的田野。", "objective": "掩护防御指挥部展开。", "tip": "泥泞让地面敌军减速8%，利用这段时间升级阵地。", "outro": "指挥部恢复稳定联络。许久以来，电台里第一次不是请求撤退，而是确认：“守住了。”", "letter": "我曾以为勇敢就是不害怕。别洛夫说，重要的是不要让同伴独自面对恐惧。", "waves": 18, "id": 200, "rank": 6.50651, "firstReward": 178, "repeatReward": 79, "legacyId": 30, "layoutSeed": 30, "original": true, "sector": 0, "orderInChapter": 1, "pressure": 1.403 }, { "title": "林间电话线 · B-002", "place": "莫扎伊斯克方向", "date": "1941年10月", "chapter": 1, "theme": "mud", "map": 16, "weather": "rain", "trait": "bridgehead", "base": "林间电话线", "quote": "", "story": "各炮组已能协同行动。每处新阵地都要为友邻部队争取构筑工事的时间。 一座小桥被货物压塌，别洛夫留下一支抢修队。 妮娜在地图上标出安全弯道，传达简短命令。 防区 B-002. 防区命令: 掩护新的电话线铺设。", "objective": "掩护新的电话线铺设。", "tip": "将范围火力与反坦克炮搭配使用。在波次间修理受损阵地，付费支援并非必需。", "outro": "防线守住了。 通信兵报告，路线已恢复运转。 林间电话线 · B-002.", "letter": "林间电话线 · B-002. 别洛夫说，好的阵地首先要照顾旁边的炮组。", "waves": 19, "id": 201, "rank": 6.53904, "firstReward": 182, "repeatReward": 81, "layoutSeed": 17437, "original": false, "legacyId": null, "sector": 0, "orderInChapter": 2, "pressure": 1.405 }, { "title": "工兵巡逻 · B-003", "place": "莫扎伊斯克方向", "date": "1941年10月", "chapter": 1, "theme": "mud", "map": 2, "weather": "rain", "trait": "scouts", "base": "工兵巡逻", "quote": "", "story": "各炮组已能协同行动。每处新阵地都要