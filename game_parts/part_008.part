 }, { "title": "医疗站弯道 · B-055", "place": "沃洛科拉姆斯克方向", "date": "1941年11月", "chapter": 1, "theme": "snow", "map": 6, "weather": "snow", "trait": "bridgehead", "base": "医疗站弯道", "quote": "", "story": "各炮组已能协同行动。每处新阵地都要为友邻部队争取构筑工事的时间。 备用路线被堵住，所有车辆都必须经过这道防线。 别洛夫把备用弹药箱放在火炮旁，提醒大家不要过早开火。 防区 B-055. 防区命令: 为救护车守住道路。", "objective": "为救护车守住道路。", "tip": "将范围火力与反坦克炮搭配使用。在波次间修理受损阵地，付费支援并非必需。", "outro": "防线守住了。 连队日志上又记下一条守住的道路。 医疗站弯道 · B-055.", "letter": "医疗站弯道 · B-055. 别洛夫说，好的阵地首先要照顾旁边的炮组。", "waves": 19, "id": 254, "rank": 8.26326, "firstReward": 191, "repeatReward": 86, "layoutSeed": 19398, "original": false, "legacyId": null, "sector": 2, "orderInChapter": 55, "pressure": 1.512 }, { "title": "给机车的煤", "place": "沃洛科拉姆斯克方向", "date": "1941年11月", "chapter": 1, "theme": "frostwood", "map": 5, "weather": "snow", "trait": "armor", "base": "掩护燃料运输", "quote": "“路长一点没关系，只要通向家。”", "story": "一列火车耗尽燃料后勉强到站。别洛夫组织人手，从被毁的仓库搬运煤炭。 此刻撤退就意味着让人们失去掩护。连队决定在这里迎战。", "objective": "掩护燃料运输。", "tip": "初始补给较多。先覆盖几个地段，再升级阵地。", "outro": "炮组等到工作结束的信号后才撤收。别洛夫在行军图上标记“给机车的煤”。", "letter": "“给机车的煤”。我们又多得了平静的一分钟，我用它写完给你的这几行字。", "waves": 21, "id": 255, "rank": 8.2958, "firstReward": 199, "repeatReward": 90, "legacyId": 38, "layoutSeed": 38, "original": true, "sector": 2, "orderInChapter": 56, "pressure": 1.514 }, { "title": "木材车队 · B-057", "place": "沃洛科拉姆斯克方向", "date": "1941年11月", "chapter": 1, "theme": "frostwood", "map": 2, "weather": "snow", "trait": "convoy", "base": "木材车队", "quote": "", "story": "各炮组已能协同行动。每处新阵地都要为友邻部队争取构筑工事的时间。 备用路线被堵住，所有车辆都必须经过这道防线。 索科洛夫预留维修补给，检查最后一个弯道。 防区 B-057. 防区命令: 掩护建筑材料车队通过危险弯道。", "objective": "掩护建筑材料车队通过危险弯道。", "tip": "将范围火力与反坦克炮搭配使用。在波次间修理受损阵地，付费支援并非必需。", "outro": "防线守住了。 车队顺利通过防区。 木材车队 · B-057.", "letter": "木材车队 · B-057. 妮娜又数了一遍信件，没有一封落在路上。", "waves": 21, "id": 256, "rank": 8.32833, "firstReward": 200, "repeatReward": 90, "layoutSeed": 19472, "original": false, "legacyId": null, "sector": 2, "orderInChapter": 57, "pressure": 1.516 }, { "title": "信使路线 · B-058", "place": "沃洛科拉姆斯克方向", "date"