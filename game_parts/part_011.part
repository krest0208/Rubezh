yId": null, "sector": 8, "orderInChapter": 171, "pressure": 2.553 }, { "title": "Poste d'observation · D-172", "place": "Secteur de Kyiv", "date": "Novembre 1943", "chapter": 3, "theme": "ruins", "map": 12, "weather": "rain", "trait": "none", "base": "Poste d'observation", "quote": "", "story": "La compagnie revient sur des itinéraires familiers. Les anciennes routes doivent être déblayées et protégées des contre-attaques. Les éclaireurs ont vu du mouvement sur un chemin voisin : le détour n'est plus sûr. Sokolov garde du ravitaillement pour les réparations et vérifie le dernier virage. Secteur D-172. Ordres du secteur: Défendre les accès au poste d'observation.", "objective": "Défendre les accès au poste d'observation.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Le convoi traverse le secteur sans s'arrêter. Poste d'observation · D-172.", "letter": "Poste d'observation · D-172. Nina a encore compté les lettres. Aucune n'est restée sur la route.", "waves": 41, "id": 771, "rank": 25.08258, "firstReward": 368, "repeatReward": 175, "layoutSeed": 38527, "original": false, "legacyId": null, "sector": 8, "orderInChapter": 172, "pressure": 2.555 }, { "title": "Une maison numérotée", "place": "Secteur de Kyiv", "date": "Novembre 1943", "chapter": 3, "theme": "ruins", "map": 8, "weather": "rain", "trait": "elite", "base": "Couvrir le chemin du facteur militaire", "quote": "« Nous ne tenons pas pour un point sur la carte. »", "story": "Une plaque d'adresse subsiste sur un mur. Nina consulte son carnet : une lettre a enfin trouvé sa rue. Derrière, des gens ont besoin de calme et de temps. Devant, une route ne doit pas rester ouverte.", "objective": "Couvrir le chemin du facteur militaire.", "tip": "Mitrailleuses et mortiers retiennent les groupes serrés. Placez-les près d'un long virage.", "outro": "La ligne tient. Le journal indique : « Une maison numérotée — mission accomplie. » Nina le range près du sac postal.", "letter": "« Une maison numérotée. » Je me souviendrai non du combat, mais des phares du véhicule qui a franchi notre ligne.", "waves": 41, "id": 772, "rank": 25.11512, "firstReward": 369, "repeatReward": 175, "legacyId": 115, "layoutSeed": 115, "original": true, "sector": 8, "orderInChapter": 173, "pressure": 2.557 }, { "title": "Dépôt de vivres · D-174", "place": "Secteur de Kyiv", "date": "Novembre 1943", "chapter": 3, "theme": "ruins", "map": 8, "weather": "rain", "trait": "scouts", "base": "Dépôt de vivres", "quote": "", "story": "La compagnie revient sur des itinéraires familiers. Les anciennes routes doivent être déblayées et protégées des contre-attaques. Les éclaireurs ont vu du mouvement sur un chemin voisin : le détour n'est plus sûr. Sokolov garde du ravitaillement pour les réparations et vérifie le dernier virage. Secteur D-174. Ordres du secteur: Tenir la route du dépôt de vivres.", "objective": "Tenir la route du dépôt de vivres.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Les transmetteurs annoncent que l'itinéraire fonctionne à nouveau. Dépôt de vivres · D-174.", "letter": "Dépôt de vivres · D-174. Nina a encore compté les lettres. Aucune n'est restée sur la route.", "waves": 39, "id": 773, "rank": 25.14765, "firstReward": 361, "repeatReward": 171, "layoutSeed": 38601, "original": false, "legacyId": null, "sector": 8, "orderInChapter": 174, "pressure": 2.559 }, { "title": "Accès au pont · D-175", "place": "Secteur de Kyiv", "date": "Novembre 1943", "chapter": 3, "theme": "ruins", "map": 18, "weather": "rain", "trait": "supplies", "base": "Accès au pont", "quote": "", "story": "La compagnie revient sur des itinéraires familiers. Les anciennes routes doivent être déblayées et protégées des contre-attaques. Le premier véhicule est en panne et le convoi s'étire dans le virage. Sokolov garde du ravitaillement pour les réparations et vérifie le dernier virage. Secteur D-175. Ordres du secteur: Protéger l'accès au pont contre une contre-attaque.", "objective": "Protéger l'accès au pont contre une contre-attaque.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Les transmetteurs annoncent que l'itinéraire fonctionne à nouveau. Accès au pont · D-175.", "letter": "Accès au pont · D-175. Nina a encore compté les lettres. Aucune n'est restée sur la route.", "waves": 39, "id": 774, "rank": 25.18018, "firstReward": 361, "repeatReward": 171, "layoutSeed": 38638, "original": false, "legacyId": null, "sector": 8, "orderInChapter": 175, "pressure": 2.561 }, { "title": "Abri au bord du chemin · D-176", "place": "Secteur de Kyiv", "date": "Novembre 1943", "chapter": 3, "theme": "ruins", "map": 4, "weather": "rain", "trait": "fog", "base": "Abri au bord du chemin", "quote": "", "story": "La compagnie revient sur des itinéraires familiers. Les anciennes routes doivent être déblayées et protégées des contre-attaques. Le premier véhicule est en panne et le convoi s'étire dans le virage. Nina range les lettres dans une housse étanche : elles ont encore besoin d'une route sûre. Secteur D-176. Ordres du secteur: Couvrir l'abri provisoire au bord de la route.", "objective": "Couvrir l'abri provisoire au bord de la route.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Les transmetteurs annoncent que l'itinéraire fonctionne à nouveau. Abri au bord du chemin · D-176.", "letter": "Abri au bord du chemin · D-176. La fatigue vient après le combat. Tant que le convoi passe derrière nous, nous la sentons à peine.", "waves": 44, "id": 775, "rank": 25.21271, "firstReward": 381, "repeatReward": 182, "layoutSeed": 38675, "original": false, "legacyId": null, "sector": 8, "orderInChapter": 176, "pressure": 2.563 }, { "title": "Cuisine de campagne · D-177", "place": "Secteur de Kyiv", "date": "Novembre 1943", "chapter": 3, "theme": "ruins", "map": 14, "weather": "rain", "trait": "none", "base": "Cuisine de campagne", "quote": "", "story": "La compagnie revient sur des itinéraires familiers. Les anciennes routes doivent être déblayées et protégées des contre-attaques. Le premier véhicule est en panne et le convoi s'étire dans le virage. Nina range les lettres dans une housse étanche : elles ont encore besoin d'une route sûre. Secteur D-177. Ordres du secteur: Garder le chemin de la cuisine de campagne ouvert.", "objective": "Garder le chemin de la cuisine de campagne ouvert.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Les sapeurs retirent les obstacles pour laisser passer les véhicules amis. Cuisine de campagne · D-177.", "letter": "Cuisine de campagne · D-177. La fatigue vient après le combat. Tant que le convoi passe derrière nous, nous la sentons à peine.", "waves": 44, "id": 776, "rank": 25.24525, "firstReward": 381, "repeatReward": 182, "layoutSeed": 38712, "original": false, "legacyId": null, "sector": 8, "orderInChapter": 177, "pressure": 2.565 }, { "title": "Relais du ravitaillement · D-178", "place": "Secteur de Kyiv", "date": "Novembre 1943", "chapter": 3, "theme": "ruins", "map": 0, "weather": "rain", "trait": "armor", "base": "Relais du ravitaillement", "quote": "", "story": "La compagnie revient sur des itinéraires familiers. Les anciennes routes doivent être déblayées et protégées des contre-attaques. Le fil est coupé. En attendant le retour des communications, les servants suivent les fanions. Nina range les lettres dans une housse étanche : elles ont encore besoin d'une route sûre. Secteur D-178. Ordres du secteur: Défendre la base intermédiair