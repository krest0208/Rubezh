outSeed": 41080, "original": false, "legacyId": null, "sector": 2, "orderInChapter": 41, "pressure": 2.694 }, { "title": "别列津纳河渡口", "place": "白俄罗斯", "date": "1944年6月", "chapter": 4, "theme": "river", "map": 6, "weather": "rain", "trait": "convoy", "base": "补给桥梁", "quote": "“河流不记得你曾往哪个方向走。”", "story": "连队加固桥梁，供推进部队使用。撤退的敌军带车辆从支路接近。索科洛夫分开交通路线，用火力控制战斗通道，避免拥堵中断补给。", "objective": "保护桥梁，保持补给流动。", "tip": "运输车辆更多，使用范围伤害，同时保留火炮对付装甲护卫。", "outro": "别洛夫在桥上立起新限重牌。妮娜发现，这次用的是新木板，不是破箱板。", "letter": "我越来越常想，战后要造什么样的桥。愿上面只有普通公交车来往。", "waves": 46, "id": 841, "rank": 27.35986, "firstReward": 401, "repeatReward": 191, "legacyId": 126, "layoutSeed": 126, "original": true, "sector": 2, "orderInChapter": 42, "pressure": 2.696 }, { "title": "磨坊小路 · E-043", "place": "白俄罗斯", "date": "1944年6月", "chapter": 4, "theme": "river", "map": 0, "weather": "rain", "trait": "convoy", "base": "磨坊小路", "quote": "", "story": "邮袋越来越轻，但车队仍需要安全通道。连队继续履行第一天许下的承诺。 邻近连队请求再守住通道一会儿。 妮娜把信件装进防水袋，今天它们仍需要一条安全的路。 防区 E-043. 防区命令: 保护面粉与食品运输。", "objective": "保护面粉与食品运输。", "tip": "将范围火力与反坦克炮搭配使用。在波次间修理受损阵地，付费支援并非必需。", "outro": "防线守住了。 连队日志上又记下一条守住的道路。 磨坊小路 · E-043.", "letter": "磨坊小路 · E-043. 妮娜又数了一遍信件，没有一封落在路上。", "waves": 46, "id": 842, "rank": 27.39239, "firstReward": 401, "repeatReward": 191, "layoutSeed": 41154, "original": false, "legacyId": null, "sector": 2, "orderInChapter": 43, "pressure": 2.698 }, { "title": "集合点 · E-044", "place": "白俄罗斯", "date": "1944年6月", "chapter": 4, "theme": "river", "map": 10, "weather": "rain", "trait": "supplies", "base": "集合点", "quote": "", "story": "邮袋越来越轻，但车队仍需要安全通道。连队继续履行第一天许下的承诺。 邻近连队请求再守住通道一会儿。 妮娜把信件装进防水袋，今天它们仍需要一条安全的路。 防区 E-044. 防区命令: 保持集合点到后方的道路畅通。", "objective": "保持集合点到后方的道路畅通。", "tip": "将范围火力与反坦克炮搭配使用。在波次间修理受损阵地，付费支援并非必需。", "outro": "防线守住了。 连队日志上又记下一条守住的道路。 集合点 · E-044.", "letter": "集合点 · E-044. 妮娜又数了一遍信件，没有一封落在路上。", "waves": 44, "id": 843, "rank": 27.42492, "firstReward": 393, "repeatReward": 188, "layoutSeed": 41191, "original": false, "legacyId": null, "sector": 2, "orderInChapt