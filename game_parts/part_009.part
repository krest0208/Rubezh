ayoutSeed": 11739, "original": false, "legacyId": null, "sector": 2, "orderInChapter": 48, "pressure": 1.095 }, { "title": "L'enveloppe ouverte", "place": "Route forestière", "date": "Juin 1941", "chapter": 0, "theme": "forest", "map": 8, "weather": "rain", "trait": "scouts", "base": "Protéger le point de rassemblement du convoi", "quote": "« Une bonne position économise plus d'obus qu'une caisse pleine. »", "story": "Nina trouve une lettre sans adresse dans le camion. Elle reconnaît l'écriture d'un soldat de la pièce voisine. Sokolov choisit les positions, Nina établit les liaisons et Belov répartit les munitions.", "objective": "Protéger le point de rassemblement du convoi.", "tip": "Mitrailleuses et mortiers retiennent les groupes serrés. Placez-les près d'un long virage.", "outro": "La ligne tient. Le journal indique : « L'enveloppe ouverte — mission accomplie. » Nina le range près du sac postal.", "letter": "« L'enveloppe ouverte. » Belov dit qu'une route se souvient de ceux qui l'ont réparée. J'espère qu'elle se souvient aussi des sauvés.", "waves": 9, "id": 48, "rank": 1.56156, "firstReward": 128, "repeatReward": 54, "legacyId": 7, "layoutSeed": 7, "original": true, "sector": 2, "orderInChapter": 49, "pressure": 1.097 }, { "title": "Patrouille de sapeurs · A-050", "place": "Route forestière", "date": "Juin 1941", "chapter": 0, "theme": "forest", "map": 10, "weather": "rain", "trait": "fog", "base": "Patrouille de sapeurs", "quote": "", "story": "La compagnie apprend encore à tenir une route pendant la retraite. Derrière chaque carrefour, des gens ont besoin de temps. Un groupe de blessés rejoint l'arrière ; impossible de le presser. Nina marque les virages sûrs sur sa carte et transmet un ordre bref. Secteur A-050. Ordres du secteur: Tenir la route pendant que les sapeurs vérifient le prochain tronçon.", "objective": "Tenir la route pendant que les sapeurs vérifient le prochain tronçon.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Les sapeurs retirent les obstacles pour laisser passer les véhicules amis. Patrouille de sapeurs · A-050.", "letter": "Patrouille de sapeurs · A-050. Nous apprenons à économiser le ravitaillement, mais aussi le temps des autres.", "waves": 10, "id": 49, "rank": 1.59409, "firstReward": 128, "repeatReward": 54, "layoutSeed": 11813, "original": false, "legacyId": null, "sector": 2, "orderInChapter": 50, "pressure": 1.099 }, { "title": "Route du moulin · A-051", "place": "Route forestière", "date": "Juin 1941", "chapter": 0, "theme": "forest", "map": 20, "weather": "rain", "trait": "none", "base": "Route du moulin", "quote": "", "story": "La compagnie apprend encore à tenir une route pendant la retraite. Derrière chaque carrefour, des gens ont besoin de temps. Un groupe de blessés rejoint l'arrière ; impossible de le presser. Nina marque les virages sûrs sur sa carte et transmet un ordre bref. Secteur A-051. Ordres du secteur: Protéger la livraison de farine et de provisions.", "objective": "Protéger la livraison de farine et de provisions.", "tip": "Combinez le tir de zone et les canons antichars. Réparez les positions entre les vagues ; le soutien payant n'est pas indispensable.", "outro": "La ligne tient. Les sapeurs retirent les obstacles pour laisser passer les véhicules amis. Route du moulin · A-051.", "letter": "Route du moulin · A-051. Aujourd'hui, nous gardions non pas un point sur une carte, mais la chance de quelqu'un de rentrer chez lui.", "waves": 10, "id": 50, "rank": 1.62663, "firstReward": 128, "repeatReward": 54, "layoutSeed": 11850, "original": false, "legacyId": null, "sector": 2, "orderInChapter": 51, "pressure": 1.101 }, { "title": "Point de rassemblement · A-052", "place": "Route forestière", "date": "Juin 1941", "chapter": 0, "theme": "forest", "map": 6, "weather": "rain", "trait": "scarcity", "base": "Point de rassemblement", "quote": "", "story": "L