ure": 2.232 }, { "title": "零件卡车 · D-013", "place": "库尔斯克方向", "date": "1943年7月", "chapter": 3, "theme": "steppe", "map": 6, "weather": "dust", "trait": "none", "base": "零件卡车", "quote": "", "story": "连队沿熟悉的方向返回。旧路需要重新清理，也需要防备反击。 最后一辆卡车还没到，此时不能离开阵地。 妮娜把信件装进防水袋，今天它们仍需要一条安全的路。 防区 D-013. 防区命令: 掩护运送备用零件的卡车。", "objective": "掩护运送备用零件的卡车。", "tip": "将范围火力与反坦克炮搭配使用。在波次间修理受损阵地，付费支援并非必需。", "outro": "防线守住了。 通信兵报告，路线已恢复运转。 零件卡车 · D-013.", "letter": "零件卡车 · D-013. 今天我们守的不是地图上的一个点，而是某个人回家的机会。", "waves": 38, "id": 612, "rank": 19.90991, "firstReward": 329, "repeatReward": 155, "layoutSeed": 32644, "original": false, "legacyId": null, "sector": 0, "orderInChapter": 13, "pressure": 2.234 }, { "title": "口粮仓库 · D-014", "place": "库尔斯克方向", "date": "1943年7月", "chapter": 3, "theme": "steppe", "map": 16, "weather": "dust", "trait": "scouts", "base": "口粮仓库", "quote": "", "story": "连队沿熟悉的方向返回。旧路需要重新清理，也需要防备反击。 最后一辆卡车还没到，此时不能离开阵地。 妮娜把信件装进防水袋，今天它们仍需要一条安全的路。 防区 D-014. 防区命令: 守住通往口粮仓库的道路。", "objective": "守住通往口粮仓库的道路。", "tip": "将范围火力与反坦克炮搭配使用。在波次间修理受损阵地，付费支援并非必需。", "outro": "防线守住了。 通信兵报告，路线已恢复运转。 口粮仓库 · D-014.", "letter": "口粮仓库 · D-014. 今天我们守的不是地图上的一个点，而是某个人回家的机会。", "waves": 38, "id": 613, "rank": 19.94244, "firstReward": 329, "repeatReward": 155, "layoutSeed": 32681, "original": false, "legacyId": null, "sector": 0, "orderInChapter": 14, "pressure": 2.236 }, { "title": "瞄具箱", "place": "库尔斯克方向", "date": "1943年7月", "chapter": 3, "theme": "village", "map": 11, "weather": "dust", "trait": "supplies", "base": "保护装备车队", "quote": "“好的阵地比满箱炮弹更能节省弹药。”", "story": "备用瞄具送到连队。妮娜帮忙清点货物，侦察兵则不断传来警报。 索科洛夫选择阵地，妮娜建立通信，别洛夫为各炮组分配弹药。", "objective": "保护装备车队。", "tip": "初始补给较多。先覆盖几个地段，再升级阵地。", "outro": "炮组等到工作结束的信号后才撤收。别洛夫在行军图上标记“瞄具箱”。", "letter": "“瞄具箱”。别洛夫说，道路记得每个修补它的人。我希望它也记得那些被救走的人。", "waves": 36, "id": 614, "rank": 19.97497, "firstReward": 321, "repeatReward": 151, "legacyId": 92, "layoutSeed": 92, "original": true, "sector": 0, "orderInChapter": 15, "pressure": 2.238 }, { "title": "路边掩蔽所 · D-016", "place": "库尔斯克方向", "d