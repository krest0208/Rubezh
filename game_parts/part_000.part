    </div><div class="hud-controls"><button id="battleSound" class="icon-btn sound-button" aria-label="Включить или выключить звук"></button><button id="speedBtn" class="icon-btn speed-btn" title="Скорость игры">1×</button><button id="pauseBtn" class="icon-btn" data-icon="pause" aria-label="Пауза"></button></div></header>
    <div id="field" class="field"><button id="compactPause" class="icon-btn compact-pause" aria-label="Пауза">Ⅱ</button><canvas id="game" aria-label="Поле боя. Выберите укрепление, затем нажмите на круглую строительную позицию."></canvas><div id="fieldTag" class="field-tag"></div><div id="nextInfo" class="next-info"></div><div id="survivalLoot" class="survival-loot hidden"></div><div id="rotateTip" class="rotate-tip">На телефоне удобнее играть горизонтально</div><div id="tutorial" class="tutorial hidden"></div><div id="selectedPanel" class="selected-panel hidden"></div></div>
    <div class="commandbar"><button id="toggleHud" class="fold-btn" aria-label="Скрыть верхнюю панель" title="Свернуть сведения">▴</button><span id="miniStats" class="mini-stats hidden"></span><button id="waveBtn" class="wave-button primary">▶ В БОЙ</button><button id="autoWaveBtn" class="auto-wave" aria-pressed="true">АВТО: ВКЛ</button><button id="toggleDock" class="fold-btn" aria-label="Скрыть панель орудий" title="Свернуть орудия">▾</button></div><footer class="dock"><div id="towerShop" class="tower-shop"></div><div class="abilities"><button id="artilleryBtn" class="ability" title="Артподдержка: выберите точку на дороге"></button><button id="repairBtn" class="ability" title="Ремонт рубежа: +5 прочности за 80 снабжения"></button></div></footer>
