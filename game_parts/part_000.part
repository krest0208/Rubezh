@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}

#menu .hero #continueBtn{background:#aa4930;border:1px solid #773b28;box-shadow:inset 0 1px #f4bb7e77,0 3px 0 #713623;text-shadow:none;color:#fff5d8}
#menu .hero #continueBtn:hover{background:#bb583d}
#menu .hero .main-secondary .btn{font-size:18px;min-height:54px;overflow-wrap:normal}
@media(orientation:landscape) and (max-height:540px){#menu .hero .main-secondary .btn{font-size:14px;min-height:37px}}
@media(max-width:600px) and (orientation:portrait){#menu .hero .main-secondary .btn{font-size:17px;min-height:50px}}
@media(orientation:landscape) and (max-width:650px){#menu .hero .main-secondary .btn{font-size:12px;min-height:34px}}
@media(max-height:320px){#menu .hero .main-secondary .btn{font-size:12px;min-height:30px}}


/* 2026 scale update: keep the field-order look, but give the battlefield back to the player. */
#battle{--rack:382px}
#battle .topbar{top:8px;left:8px;right:8px;height:36px;min-height:36px}
#battle .hud-stats{height:36px}
#battle .hud-stat{min-width:66px;padding:3px 9px}
#battle .hud-stat span{font-size:7px}#battle .hud-stat strong{font-size:14px;line-height:1.2}
#battle .hud-controls{gap:4px}#battle .hud-controls .icon-btn{width:33px;height:33px;min-width:33px;padding:7px}
#battle #toggleHud{left:218px;top:8px;height:36px;width:23px;min-width:23px}
#battle.hud-folded #toggleHud{left:184px;height:34px}
#battle #miniStats{left:8px;top:8px;height:34px;min-width:160px;padding:5px 8px;font-size:10px;line-height:20px}
#battle .battle-name{top:47px;left:8px;max-width:330px}.battle-name .eyebrow{font-size:7px!important}.battle-name h2{font-size:10px!important;margin-top:1px!important}
#battle #nextInfo{top:8px;max-width:260px;font-size:9px;padding:4px 8px}
#battle #towerShop{left:10px;right:auto;transform:none;bottom:10px;width:var(--rack);height:74px;display:flex;grid-template-columns:none;gap:3px;padding:4px;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x proximity;overscroll-behavior-x:contain;scrollbar-width:thin;scrollbar-color:#9eaa78 #263923;touch-action:pan-x}
#battle #towerShop::-webkit-scrollbar{height:4px}#battle #towerShop::-webkit-scrollbar-thumb{background:#9eaa78}
#battle .tower-card{flex:0 0 72px;width:72px;height:64px;scroll-snap-align:start;padding:0 1px 3px}
#battle .tower-card canvas{width:50px;height:32px}#battle .tower-card .name{font-size:7px;line-height:1}#battle .tower-card .cost{font-size:9px;margin-top:1px}#battle .tower-card .key{display:none}
#battle #toggleDock{left:calc(10px + var(--rack));bottom:10px;height:74px;width:22px;min-width:22px}
#battle.dock-folded #toggleDock{left:10px;bottom:10px;height:34px;width:38px}
#battle .abilities{left:10px;bottom:91px;gap:4px}
#battle .ability{width:62px;height:40px;display:grid;grid-template-columns:18px 1fr;grid-template-rows:1fr 1fr;column-gap:4px;padding:3px 5px;text-align:left}
#battle .ability svg{width:17px;height:17px;grid-row:1/3}.ability span{font-size:7px!important}.ability small{font-size:8px!important}
#battle #waveBtn{right:10px;bottom:10px;width:128px;height:38px;min-height:38px;font-size:11px;padding:5px}
#battle #autoWaveBtn{right:10px;bottom:54px;width:128px;height:27px;min-height:27px;font-size:9px;padding:3px}
#battle #mapControls{right:10px;top:48px;gap:3px}#battle #mapControls button{width:30px;height:27px;min-height:27px;font-size:15px}
#battle #minimap{left:142px;bottom:91px;width:132px;height:46px}
#battle #selectedPanel{top:50px;right:48px;width:244px;max-height:calc(100% - 142px);padding:9px}
#battle #tutorial{left:10px;top:72px;width:260px;max-height:calc(100% - 175px);padding:10px}
#toast{bottom:91px}
@media(max-width:760px){
 #battle{--rack:258px}
 #battle #towerShop{width:var(--rack);height:65px;bottom:6px;left:6px;padding:3px}
 #battle .tower-card{flex-basis:62px;width:62px;height:57px}#battle .tower-card canvas{width:44px;height:29px}
 #battle #toggleDock{left:calc(6px + var(--rack));bottom:6px;height:65px}
 #battle .abilities{left:6px;bottom:76px}.ability{width:52px!important;height:34px!important;padding:2px 3px!important}.ability svg{width:14px!important;height:14px!important}.ability span{font-size:6px!important}.ability small{font-size:7px!important}
 #battle #waveBtn{right:6px;bottom:6px;width:105px;height:34px;min-height:34px;font-size:10px}
 #battle #autoWaveBtn{right:6px;bottom:45px;width:105px;height:25px;min-height:25px;font-size:8px}
 #battle #minimap{left:118px;bottom:76px;width:104px;height:36px}
 #battle #nextInfo{display:none}
 #battle .battle-name{display:none}
 #battle #selectedPanel{top:45px;right:42px;width:218px;max-height:calc(100% - 125px)}
}
@media(max-width:600px) and (orientation:portrait){
 #battle{--rack:226px}
 #battle #towerShop{left:6px;width:var(--rack);height:62px;bottom:6px}
 #battle .tower-card{flex-basis:57px;width:57px;height:54px}.tower-card canvas{width:41px!important;height:27px!important}
 #battle #toggleDock{left:calc(6px + var(--rack));right:auto;bottom:6px;height:62px}
 #battle .abilities{left:6px;bottom:73px}
 #battle #waveBtn{right:6px;bottom:6px;width:101px}#battle #autoWaveBtn{right:6px;bottom:44px;width:101px}
 #battle #minimap{left:112px;bottom:73px;width:98px;height:34px}
 #battle .topbar{top:6px;left:6px;right:6px}.hud-stat{min-width:55px!important;padding:3px 5px!important}.hud-stat strong{font-size:12px!important}
 #battle #toggleHud{left:174px;top:6px}.hud-controls .icon-btn{width:29px!important;height:31px!important;min-width:29px!important}
 #battle #miniStats{left:6px;top:6px;min-width:145px;height:31px;font-size:9px}
 #battle.hud-folded #toggleHud{left:158px}
}

</style>
</head>
<body>
<div id="app">
  <canvas id="backdrop" aria-hidden="true"></canvas><div id="veil"></div>

  <section id="menu" class="screen">
    <div class="menu-top">
      <div class="brandmark"><span id="brandIcon"></span><span>РУБЕЖ<span class="brand-sub">ПОЛЕВОЙ ШТАБ</span></span></div>
      <div class="menu-top-right"><div id="menuWallet" class="wallet"></div><button id="menuSound" hidden tabindex="-1" class="icon-btn" aria-label="Включить или выключить звук"></button><button id="settingsBtn" class="icon-btn" aria-label="Настройки"></button></div>
    </div>
    <div class="hero">
      <div class="eyebrow hero-kicker"><i></i> ИСТОРИЯ ПРОДОЛЖАЕТСЯ</div>
      <div class="title-overline">1941 — 1945</div><h1>РУБЕЖ</h1>
      <div class="hero-subtitle">Сохраните дорогу. Сдержите обещание.</div>
      <p class="hero-copy">Сохраните дорогу. Сдержите обещание.</p>
      <div class="hero-actions">
        <button id="continueBtn" class="btn primary">▶ ИГРАТЬ</button><div id="playCaption" class="play-caption">Продолжить кампанию</div>
        <div class="menu-button-row main-secondary"><button id="survivalBtn" class="btn secondary">Выживание</button><button id="researchBtn" class="btn quiet">Арсенал</button></div><button id="skinStoreBtn" class="btn store-main-btn" type="button"></button>
      </div>
      <div hidden aria-hidden="true" class="legacy-menu">
        <button id="campaignBtn" tabindex="-1">Кампания</button>
        <button id="marketBtn" tabindex="-1">Изумруды</button>
        <button id="trainingBtn" tabindex="-1">Обучение</button>
        <button id="journalBtn" tabindex="-1">Письма</button>
        <button id="helpBtn" tabindex="-1">Справка</button>
        <select id="difficulty" tabindex="-1"><option value="story">Сюжетная</option><option value="normal">Обычная</option><option value="veteran">Ветеран</option></select>
        <input id="pureMode" type="checkbox" tabindex="-1">
      </div>
      <div id="menuProgress" class="menu-progress"></div>
    </div>
    <div class="menu-bottom"><span class="campaign-era">СОВЕТСКАЯ КАМПАНИЯ <i></i> ОФЛАЙН</span><label class="language-control" data-no-i18n><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18M5 7h14M5 17h14"/></svg><select id="languageSelect" class="language-select" aria-label="Language"></select></label></div>
  </section>

  <section id="campaign" class="screen page hidden">
    <div class="page-head"><div class="page-heading"><button class="icon-btn back-menu" aria-label="Главное меню" data-icon="back"></button><div><div class="eyebrow">Дорога длиною в четыре года</div><h2>Карта операций</h2></div></div><div class="campaign-head-actions"><span id="campaignProgress" class="tag"></span><button id="campaignLetters" class="icon-btn" aria-label="Письма" data-icon="book"></button></div></div>
    <div id="chapterTabs" class="chapter-tabs"></div><div id="campaignContent" class="scroll"></div>
  </section>
  <section id="brief" class="screen hidden">
    <div class="brief-card"><div class="brief-left">
      <div class="paper-meta"><span>ПОЛЕВОЕ РАСПОРЯЖЕНИЕ</span><span id="briefNumber"></span></div>
      <h2 id="briefTitle"></h2><div id="briefPlace" class="brief-place"></div><p id="briefQuote" class="brief-quote"></p><p id="briefStory" class="brief-story"></p>
      <div class="brief-disclaimer">Художественная история. Рота, её герои, маршруты и конкретные боевые задачи вымышлены.</div>
    </div><div class="brief-right">
      <div class="brief-map-wrap"><canvas id="briefMap"></canvas><div class="map-caption">СХЕМА ОБОРОНИТЕЛЬНОГО УЧАСТКА</div></div>
      <div class="brief-orders"><h3>БОЕВАЯ ЗАДАЧА</h3><p id="briefObjective"></p><div id="briefStats" class="brief-stats"></div><p id="briefTip" class="brief-tip"></p></div><div class="brief-actions"><button id="briefBack" class="btn quiet">Назад</button><button id="deployBtn" class="btn primary">▶ ИГРАТЬ</button></div>
    </div></div>
  </section>
  <section id="battle" class="screen hidden">
    <header class="topbar"><div class="battle-name"><div id="battlePlace" class="eyebrow"></div><h2 id="battleTitle"></h2></div><div class="hud-stats">
      <div class="hud-stat money"><span>СНАБЖЕНИЕ</span><strong id="money">350</strong></div>
      <div id="healthStat" class="hud-stat"><span>РУБЕЖ</span><strong id="health">20 / 20</strong></div>
