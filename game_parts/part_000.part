}
@media(max-height:640px){.hero h1{font-size:65px}.hero-subtitle{font-size:19px;margin-bottom:8px}.hero-kicker,.hero-copy{display:none}.hero-actions{gap:6px}.hero{padding:4px 0}.menu-progress{font-size:9px}.menu-bottom{margin-top:8px}#continueBtn{min-height:49px}.brief-map-wrap{height:110px}}
@media(max-height:480px){
 #menu{padding-top:8px;padding-bottom:8px;gap:2px}.menu-top{min-height:30px}.menu-top .icon-btn{height:32px;min-width:32px;padding:7px}.menu-top .wallet-chip{padding:6px 9px;font-size:10px}.hero{margin:auto;max-width:350px;padding:0}.hero h1{font-size:40px;letter-spacing:3px}.hero-subtitle{font-size:15px;margin:1px 0 6px}.hero-actions{gap:5px}.hero-actions #continueBtn{min-height:42px;font-size:16px;padding:8px}.play-caption{font-size:8px;margin:0}.menu-button-row .btn{min-height:35px;padding:5px 8px;font-size:11px}.menu-button-row .secondary span{display:none}.menu-button-row.three .btn{min-height:30px;font-size:9px}.difficulty-line{margin-top:6px;font-size:9px;gap:6px}.difficulty-line select{min-height:28px;font-size:10px;padding:4px}.menu-progress,.menu-bottom{display:none}
 .topbar{height:42px;min-height:42px;padding:3px 10px}.hud-stat strong{font-size:17px}.hud-stat span{font-size:7px}.hud-controls .icon-btn{height:34px;min-width:34px}.battle-name h2{font-size:12px}.battle-name .eyebrow{font-size:7px}.commandbar{height:44px;min-height:44px;padding:4px 10px}.commandbar .wave-button b,.auto-wave b{font-size:10px}.auto-wave small{font-size:8px}
 .dock{height:68px;min-height:68px;flex-wrap:nowrap;padding:4px 8px;gap:7px}.tower-shop{flex:1;gap:5px;width:auto}.tower-card canvas{width:50px;height:32px}.tower-card .name{font-size:8px}.tower-card .cost{font-size:9px}.abilities{flex:0 0 auto;width:auto;height:auto;border-left:1px solid var(--line);padding-left:8px;gap:5px}.ability{flex:0 0 auto;min-width:54px;flex-direction:column;padding:3px;gap:1px}.ability svg{height:17px}.ability span,.ability small{font-size:8px}
 .selected-panel{top:48px;right:8px;width:247px;max-height:calc(var(--app-height,100vh) - 100px);padding:10px}.hud-folded .selected-panel{top:7px}.selected-values{margin:6px 0}.level-track{margin:7px 0}.selected-panel .btn{min-height:37px}.selected-panel details{margin-top:3px}.selected-panel summary{padding:5px 0}.tutorial{max-width:250px;font-size:10px;padding:9px;top:6px;max-height:calc(100% - 12px)}.tutorial b{font-size:12px}.tutorial .guide-close{font-size:9px;padding:4px 0;min-height:25px}
 #brief{padding:8px}.brief-card{display:grid;grid-template-columns:1.1fr 1fr;height:100%;max-height:100%}.brief-left{max-height:100%;padding:16px;overflow:auto}.brief-right{min-height:0;display:flex}.brief-map-wrap{display:none}.brief-orders{padding:14px;overflow:auto}.brief-actions{padding:8px 14px}.brief-actions .btn{min-height:39px}.brief-actions #deployBtn{min-height:42px}.brief-left h2{font-size:27px}.brief-quote{font-size:13px}.brief-story{font-size:11px}.branch-card canvas{height:70px}.branch-grid{gap:9px;margin:9px 0}.branch-card{padding:10px}.branch-card>strong{font-size:20px;margin:5px 0}.modal-box{padding:18px}.modal-box h2{font-size:25px;margin:7px 0}.modal-box p{font-size:11px;line-height:1.6;margin:8px 0}.branch-card>span:last-child{font-size:10px}#toast{bottom:120px;font-size:10px;padding:9px 14px}
}
@media(max-height:330px){.hero h1,.hero-subtitle{display:none}.hero-actions{gap:4px}.hero{padding-top:5px}.hero-actions #continueBtn{min-height:39px}.play-caption{display:none}.menu-button-row.three .btn{min-height:28px}.menu-button-row .btn{min-height:31px}.difficulty-line{margin-top:4px}}
.compact-pause{display:none;position:absolute;left:8px;top:8px;z-index:7;height:36px;min-width:36px;padding:5px;font-size:20px;background:#173d49d9}.hud-folded .compact-pause{display:flex}

.screen,#veil,#backdrop,.mask{top:0;right:0;bottom:0;left:0}
.brief-card{width:1050px;max-width:100%}.brief-right,.brief-left{min-width:0}
@media(max-width:650px) and (orientation:portrait){
 .brief-card{display:flex;flex-direction:column;width:100%;height:100%;max-height:750px}
 .brief-left{max-height:38%;flex:0 1 38%;min-height:0;overflow:auto}
 .brief-right{display:flex;flex-direction:column;flex:1 1 62%;min-height:0;width:100%;overflow:hidden}
 .brief-orders{flex:1;min-height:0;overflow:auto}.brief-actions{flex:0 0 auto;display:flex;min-width:0}.brief-actions .primary{min-width:0}
}
@media(max-width:650px) and (max-height:600px){.brief-map-wrap{display:none}.brief-left h2{font-size:24px}.brief-left{padding:15px}.brief-orders{padding:13px}.brief-actions{padding:9px 13px}}
</style>
<style>

/* Rubezh: field-command interface. Self-contained, no borrowed game assets. */
:root{--ink:#171d18;--panel:#293126;--cream:#f3eddc;--muted:#bec3ac;--gold:#e6c77f;--red:#dd8b66;--green:#b7d184;--blue:#c3cfb5;--line:#d1c59a40;--shadow:0 12px 45px #070c08a8}
html,body{background:#171d18;font-family:Arial,"Noto Sans","Noto Sans CJK SC","Noto Sans CJK JP",sans-serif}
button{background:#323c30;border-color:#8b927756;transition:background .12s,border-color .12s,transform .12s}
button:hover{background:#485542;border-color:#e7d396}button:disabled{opacity:.44}
button:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid #f5dd9d;outline-offset:2px}
#backdrop{filter:saturate(.7) sepia(.16)}
#veil{background:linear-gradient(90deg,#111a1480,#131b149c 25%,#131b14e6 45%,#131b14e6 55%,#131b149c 75%,#111a1480),linear-gradient(0deg,#10160fe6,transparent 40%,#10160f99)}
#veil:after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent 0 3px,#16201610 3px 4px);pointer-events:none}
.btn,.icon-btn,.tag,.wallet-chip,.chapter-tab,.mission-card,.brief-card,.modal-box,.help-card,.setting-card,.research-card,.market-card,.arsenal-card,.selected-panel,.tutorial,.survival-banner,.survival-panel,.letter-card{border-radius:2px}
.btn{min-height:45px;padding:10px 17px;font-size:13px;letter-spacing:.15px;box-shadow:inset 0 1px #ffffff14,0 2px 0 #0b120eb0;font-weight:bold}
.btn.primary,.wave-button.primary{background:linear-gradient(#89995a,#687b42);border:1px solid #bed393;color:#fff5d6;box-shadow:inset 0 1px #eefbd13b,0 3px 0 #1e2917;text-shadow:0 1px #233216}
.btn.primary:hover,.wave-button.primary:hover{background:linear-gradient(#a4b768,#849850);color:#fffbe9;border-color:#f1e2b7}
.btn.quiet{background:linear-gradient(#3e4838,#2c372c);border-color:#77846580;color:#eae5d4}
.btn.quiet:hover{background:#4a5940;border-color:#ddcf9e}.icon-btn{background:#263026e8;border:1px solid #7e896d7a;min-width:42px;height:42px;padding:10px}
.secondary{background:#454d37;border-color:#92947499;color:#ede7ce}.secondary:hover{background:#566144}
.eyebrow{color:#d5c086;letter-spacing:1.3px}.tag{background:#171f18;border-color:#7680658c;color:#d4ceaf;font-size:10px;letter-spacing:.8px}
h1,h2,h3,h4{overflow-wrap:anywhere}.page-head h2,.modal-box h2{font-family:Georgia,"Times New Roman","Noto Serif CJK SC",serif;letter-spacing:-.3px}
#menu{padding:18px 26px 13px;gap:0;overflow:auto}
.menu-top{min-height:46px;flex:none;border-bottom:1px solid #c9bc8640;padding-bottom:12px}
.brandmark{gap:8px}.brandmark>span{font-size:11px;letter-spacing:2px}.brand-sub{font-size:8px;letter-spacing:1px;color:#c2c3a6}.brandmark svg{color:#ceb574;width:23px;height:25px}
.version-chip,.hero-kicker,.hero-copy,.title-dot{display:none!important}
.menu-top-right{gap:8px}.wallet{gap:5px}.wallet-chip{background:#202b22dd;padding:8px 11px;border:1px solid #8b947358;box-shadow:inset 0 1px #ffffff0c;font-size:14px;color:#e8c877;gap:6px}.wallet-chip.gems{color:#a8d88a}
.hero{width:430px;max-width:100%;margin:auto;flex:0 0 auto;padding:22px 0 18px;position:relative}
.title-overline{font-size:10px;letter-spacing:5px;color:#c8c6a7;margin:0 0 9px;display:flex;align-items:center;gap:13px;width:100%;justify-content:center}
.title-overline:before,.title-overline:after{content:"";height:1px;width:60px;background:#a7aa785f}
.hero h1{font-family:Impact,"Arial Black",Arial,sans-serif;font-size:94px;line-height:1.03;letter-spacing:7px;color:#f0e4bd;text-shadow:0 3px 0 #525741,0 10px 24px #030902;margin:0 0 8px}
.hero-subtitle{font-family:Georgia,serif;font-style:normal;letter-spacing:1px;font-size:14px;color:#c5c6a5;margin:0 0 27px}
.hero-actions{width:350px;max-width:100%;gap:8px}
#continueBtn{position:relative;min-height:59px;font-size:22px;letter-spacing:1.7px;border-color:#bac985}
#continueBtn svg{width:21px;height:21px}
.play-caption{margin:0 0 6px;font-size:10px;color:#b0b799;line-height:1.4}
.menu-button-row{gap:8px}.menu-button-row .btn{font-size:13px;min-height:47px;padding:8px 10px}
.menu-button-row .secondary{display:flex;flex-direction:row;gap:8px}.menu-button-row .secondary span{font-size:10px;font-weight:normal;color:#c7c9a5;letter-spacing:0}
.menu-button-row.three{margin-top:4px;gap:0;border-top:1px solid #8c967356}
.menu-button-row.three .btn{background:none;box-shadow:none;border:0;border-right:1px solid #8c967337;min-height:34px;font-size:11px;padding:4px}.menu-button-row.three .btn:last-child{border-right:0}
.difficulty-line{margin-top:17px;font-size:10px;gap:9px;align-items:center}
.difficulty-line select,select{border-radius:2px;background:#253024;color:#eee8ce;border:1px solid #89947785;min-height:37px;font-size:12px;padding:7px 9px}
.check-label input{accent-color:#a6b96b}.menu-progress{color:#b5bea1;margin-top:13px;font-size:10px;letter-spacing:0}
.menu-bottom{border-top:1px solid #c9bc862e;padding-top:11px;font-size:9px;letter-spacing:1.2px;align-items:center;margin:0;min-height:44px}
.menu-bottom .campaign-era{color:#c0c2a5}.language-control{display:inline-flex;gap:7px;align-items:center;letter-spacing:0;color:#c7cdb4}
.language-control svg{width:17px;height:17px}.language-select{min-width:119px;max-width:185px;min-height:34px;padding:5px 27px 5px 9px;font-size:12px;background:#1b261bbd;border-color:#7382658f}
.title-ruler{width:36px;height:3px;background:#c4b179;margin:0 0 21px;box-shadow:50px 0 #c4b17922,-50px 0 #c4b17922}
.page{background:linear-gradient(110deg,#232e21f5,#161f18f9),repeating-linear-gradient(90deg,#adb38616 0 1px,transparent 1px 32px);padding:18px 3vw;gap:15px}
.page-head{padding-bottom:13px;border-bottom:1px solid #bcc1a74a}.page-head h2{font-size:29px;color:#f1e7ca;margin:5px 0 0}.page-head .eyebrow{font-size:9px}
.scroll{scrollbar-color:#778466 #20291e;padding:0 3px 22px}
.chapter-tabs{gap:5px;padding:2px 0 7px}.chapter-tab{background:#2e3928;font-size:11px;border:1px solid #83946a70;padding:10px 15px;min-height:42px;box-shadow:inset 0 2px #cad3980a}
.chapter-tab.active{background:#b6b98c;border-color:#e4d5a1;color:#202a20;font-weight:bold}
.chapter-head{margin-bottom:13px;gap:12px}.chapter-head h3{font-family:Georgia,serif;font-size:22px;color:#efe5c7}.chapter-head p{font-size:11px}
.campaign-note{font-size:12px;line-height:1.7;color:#bcc7ab}
.operation-board{position:relative;max-width:1110px;margin:0 auto;padding:26px 30px 33px;background:#c9c5a0;border:1px solid #e0dab0;box-shadow:0 6px 0 #11190f,0 15px 38px #0005;color:#313e2a;overflow:hidden}
.operation-board:before{position:absolute;content:"";inset:0;background:linear-gradient(90deg,#8d997e25 1px,transparent 1px),linear-gradient(#8d997e25 1px,transparent 1px);background-size:27px 27px;pointer-events:none}
.operation-map-art{position:absolute;inset:0;width:100%;height:100%;opacity:.43;pointer-events:none}
.operation-map-art path{vector-effect:non-scaling-stroke}.map-meta{position:relative;display:flex;justify-content:space-between;color:#556346;font:10px monospace;letter-spacing:1.5px;margin-bottom:21px;text-transform:uppercase}
.route-grid{position:relative;display:grid;grid-template-columns:repeat(6,1fr);gap:17px 20px;z-index:1}
.route-node{position:relative;min-height:65px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:4px;border:0;background:transparent;color:#4d5840;border-radius:0;padding:2px;isolation:isolate}
.route-node:before{content:"";position:absolute;left:-15px;right:-15px;top:24px;height:2px;background:#53674570;z-index:-2}
.route-node:nth-child(6n):after{content:"";position:absolute;right:50%;width:50%;top:24px;height:83px;border-right:2px solid #53674570;z-index:-2}
.route-node:last-child:after{display:none}
.route-node .node-number{width:45px;height:43px;background:#d3ceb0;border:2px solid #858e73;outline:3px solid #c9c5a0;display:flex;align-items:center;justify-content:center;box-shadow:1px 3px 0 #7c846563;font-size:20px;font-weight:bold;color:#6a745c;border-radius:3px}
.route-node.current .node-number{background:#947845;color:#fff7d4;border-color:#f3e4a3;outline:3px solid #736537;box-shadow:0 0 0 6px #79633038}
.route-node.completed .node-number{background:#5b704b;color:#f4ebcc;border-color:#d9d8ac}.route-node:hover{background:#f7edbc35;border-color:transparent}.route-node:hover .node-number{border-color:#1d4428;transform:translateY(-2px)}
.route-node .node-stars{font-size:10px;letter-spacing:1px;height:12px;color:#69714c}.route-node.completed .node-stars{color:#795c25}
.route-node.locked .node-number{opacity:.55}.route-node.current .node-stars{color:#4b4b27;font-size:8px;letter-spacing:.1px;font-weight:bold}
.operations-key{position:relative;display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:25px;padding-top:15px;border-top:1px solid #68785457;color:#4b573a;font-size:11px}
.operations-key b{font-size:13px}.operations-key .btn{min-width:154px}
#brief{background:#10180fc2;backdrop-filter:none;padding:22px}.brief-card{border:1px solid #ded6ad;box-shadow:0 12px 40px #0009;border-radius:2px}
.brief-left{background:repeating-linear-gradient(0deg,transparent,transparent 29px,#8b93610d 30px),#e5dfc4;color:#273626;padding:30px}
.brief-left:after{position:absolute;content:"";width:50px;height:9px;background:#9eab8070;left:50%;top:0;transform:translateX(-50%)}
.paper-meta{color:#7b7149;font-size:9px}.brief-left h2{color:#35412e;font-size:35px;margin:25px 0 13px}.brief-quote{color:#797147}.brief-place{color:#606b51}.brief-story{font-size:14px;color:#303c2c}.brief-disclaimer{color:#73745d}
.brief-right{background:#273424}.brief-orders h3{color:#e0ce91}.brief-orders p{color:#d5dcc5}.brief-stats{border-color:#b0bf8454}.brief-stats strong{color:#f0e7c3}.brief-actions{background:#202d20;border-top:1px solid #a5b58138;padding:15px 22px}
.map-caption{background:#172618e6;color:#e2d4a0;border-radius:0}
#battle{background:#192319}.topbar{background:linear-gradient(#354131,#253323);border:0;border-bottom:2px solid #727d53;box-shadow:0 2px 9px #07120855;height:56px;min-height:56px;padding:6px 16px}
.battle-name h2{font-family:Georgia,serif;font-size:15px;color:#eee7c7}.battle-name .eyebrow{font-size:9px;letter-spacing:.5px;max-width:390px}
.hud-stat strong{font-weight:bold;font-family:Arial,sans-serif;font-size:22px;color:#f4ebca}.hud-stat span{font-size:8px;color:#b1c09a;letter-spacing:.8px}.hud-stat.money strong{color:#edcf86}.hud-stats{gap:29px}.hud-controls{gap:5px}
.field{min-height:0}.field-tag{left:10px;top:10px;background:#263323cd;padding:7px 10px;color:#dcdebe;border:1px solid #b8c29a45;border-radius:1px;font-size:8px;letter-spacing:.7px;max-width:60%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.field-tag span{color:#f0ddab}.next-info{background:#1d2b1de8;border:1px solid #bdc7a54f;border-radius:1px;color:#e4e6cc;font-size:10px;padding:8px 11px;max-width:70%}
.commandbar{height:47px;min-height:47px;padding:5px 10px;gap:8px;background:linear-gradient(#34432d,#293624);border-top:2px solid #929e72;border-bottom:1px solid #111e14}
.commandbar .wave-button{border-radius:2px;min-width:180px;max-width:310px;box-shadow:0 2px 0 #172313;padding:5px 14px;gap:9px;flex:1}
.commandbar .wave-button b{font-size:12px;letter-spacing:.7px}.commandbar .wave-button span{font-size:9px;color:#e3eac4}
.fold-btn{height:35px;min-width:37px;border-radius:1px;background:#1c2a1d;border:1px solid #8e9c72;box-shadow:inset 0 1px #ffffff13;color:#d9d9b7;font-size:22px}
.mini-stats{font-size:12px;color:#f0ddb1;min-width:170px;letter-spacing:.2px;font-weight:bold}
.auto-wave{background:#253025;border:1px solid #708265;min-width:145px;border-radius:2px;color:#b8c5a3;padding:3px 10px}.auto-wave.on{background:#535f39;color:#f7f0c8;border-color:#a9b276;box-shadow:inset 0 1px #cfddb338}
.auto-wave b{font-size:12px;letter-spacing:.8px}.auto-wave small{font-size:9px;margin-top:2px}
.dock{height:102px;min-height:102px;background:linear-gradient(#283525,#1b281d);border:0;box-shadow:inset 0 -4px #0b170d;padding:7px 12px;gap:14px}
.tower-shop{gap:5px;max-width:970px;flex:1}.tower-card{background:#34452e;border:1px solid #6d7b5677;border-bottom:3px solid var(--type-color);border-radius:1px;padding:4px;box-shadow:inset 0 1px #f4fbd211;min-width:0}
.tower-card:hover{background:#4a5a3c;border-color:#b9c48c}.tower-card.active{background:#59633d;outline:2px solid #e1cf86;outline-offset:-2px}
.tower-card .name{font-size:10px;color:#f2efda;text-shadow:0 1px #182716;white-space:normal;line-height:1.1}.tower-card .cost{font-size:11px;background:#1a281baa;color:#e7cd84;border-radius:1px;min-width:25px;padding:1px 4px}
.tower-card canvas{width:68px;height:43px;max-width:100%}.tower-card .key{font:9px monospace;color:#abb99a;opacity:.8;top:3px;left:5px}
.abilities{border-left:1px solid #82936870;padding-left:12px;gap:6px}.ability{border-radius:1px;min-width:77px;background:#293a27;border:1px solid #8291688c;padding:5px;box-shadow:inset 0 1px #ecf4c710}.ability span{font-size:10px}.ability small{font-size:10px;color:#e0c388}.ability svg{color:#e5d49d;width:24px;height:24px}
.ability.aiming{background:#796441;border-color:#ebc984}
.selected-panel{background:#263624f5;border:1px solid #b5bd8a;box-shadow:3px 5px 0 #07100870;top:12px;right:12px;width:266px;padding:13px;color:#d3ddbd}
.selected-head strong{font-size:14px}.selected-head .icon-btn{min-width:32px;height:32px;padding:4px}.selected-values{border-color:#acbb8050;font-size:10px}.selected-values b{color:#f0e3ba}.selected-panel details{color:#b7c6a2}.selected-panel p{font-size:11px}.selected-panel .btn{font-size:11px;min-height:41px}
.level-track{gap:3px}.level-track i{border-radius:0;height:7px;background:#48563d;border:1px solid #a0ac7944}.level-track .filled{background:#d4c888;box-shadow:none}.level-track .available{background:#536547}.level-track .sealed{background:#1d2c1e}
.tutorial{background:#eee6c8;color:#3e4930;border:2px solid #8f9469;border-radius:1px;box-shadow:0 5px 0 #14211666;font-size:12px;line-height:1.55;padding:14px;max-width:330px}
.tutorial .guide-label{color:#807143;font-size:9px}.tutorial b{color:#37452a;font-size:16px}.guide-close{color:#666a4d;border-color:#9ba478;font-size:10px}
.compact-pause{background:#21341fed;border-color:#a8b98b;left:auto;right:9px;top:9px;min-width:38px;height:38px}
.hud-folded .selected-panel{top:54px}.survival-loot{background:#253722e8;border:1px solid #c0c9995e;border-radius:1px;color:#efcf8c}
.rotate-tip{background:#253922dc;border-radius:1px;color:#e5e8c9;font-size:9px}.hud-folded .field-tag{display:none}
#toast{background:#ebe3c6;color:#334629;border:1px solid #919d70;border-radius:2px;box-shadow:0 4px 0 #15200f60;font-size:12px;bottom:165px;max-width:min(560px,90vw);text-align:center}
.mask{background:#0e180bd9;backdrop-filter:none}.modal-box{background:repeating-linear-gradient(0deg,transparent,transparent 31px,#bdd08f03 32px),#273525;border:1px solid #b6bd8b;border-top:4px solid #c7c393;box-shadow:0 12px 55px #000a;border-radius:2px}
.modal-box h2{color:#ede4c4}.modal-box p{color:#c0cbaa}.setting-row{border-color:#9bb17b33}.setting-row input[type=range]{accent-color:#c3cb92}
.branch-card{border-radius:1px;background:#34482e;border:1px solid #8ca16b;box-shadow:inset 0 2px #c3da8714;padding:17px}.branch-card:hover{background:#435a34;border-color:#e6d8a0}.branch-card>strong{color:#ecdfb9;font-family:Georgia,serif;font-size:25px}
.branch-card canvas{background:radial-gradient(#8b9e642a,transparent);border-radius:0}.branch-card>span:last-child{color:#d1ddba}
.branch-card .eyebrow{color:#bac798;letter-spacing:.7px;line-height:1.5}
.arsenal-grid{gap:14px}.arsenal-card{background:linear-gradient(135deg,#33482e,#223021);border:1px solid #94a1756b;border-top:2px solid #9baa75;box-shadow:0 3px 0 #0e1a13;padding:18px}
.arsenal-heading canvas{background:radial-gradient(#adc07924,transparent);width:154px;height:103px}.arsenal-title h3{font-family:Georgia,serif;font-size:28px;color:#ebe3be}.arsenal-title p{color:#aab995}.branch-summary{background:#1c2c1d;border-radius:1px;border-color:#8c9c6c4f}.branch-summary b{color:#e1dbb1}.branch-summary span{color:#b7c5a4}
.research-card,.setting-card,.help-card,.market-card{background:linear-gradient(135deg,#32452d,#233422);border:1px solid #869b6680;box-shadow:0 3px 0 #102015;padding:21px}
.research-card h3,.help-card h3,.setting-card h3,.market-card h3{color:#e2dfbb}.help-card p,.setting-card p,.market-card p{color:#bfceaf}.skill-level{color:#d2cd95}.skill-pips i{border-radius:1px}
.arsenal-tabs{gap:5px;margin-bottom:16px}.arsenal-tabs .btn{box-shadow:none;min-height:42px}
.survival-panel{border:1px solid #92a6716b;background:#283f25;box-shadow:0 4px 0 #102213}.survival-banner{background:linear-gradient(100deg,#293e24,#294324e0)}.survival-banner h3{font-family:Georgia,serif;color:#eae3bf}.survival-banner p{color:#bdcda8}.survival-stats{border-color:#8fa5714d}.survival-stats b{color:#ded6a4}.survival-stats span{color:#aebd90}.survival-options select{background:#253521;color:#e9e7ca;border-color:#8ca27180}
.market-hero{border:1px solid #93a97779;background:#2e4528;border-radius:1px}.market-hero h3{color:#e3e3c0}.market-hero p{color:#bdceab}.demo-label{background:#132519;color:#c4ceaa;border-radius:1px;border-color:#82956b}.large-icon{color:#bfce89}.swatches i{border-radius:1px}
.ad-demo{background:#314d29;border-radius:1px;border-color:#93a97766}.ad-progress{background:#192b1b;border-radius:0}.ad-progress i{background:#b6c983;border-radius:0}
.letter-card{background:repeating-linear-gradient(0deg,transparent,transparent 26px,#6e764411 27px),#e7dfc0;border:1px solid #acb28b;box-shadow:0 3px 0 #09160880;color:#394831;padding:22px}
.letter-card h3{color:#3c4e2f}.letter-card .eyebrow{color:#858253}.letter-card p{color:#5e654b}.letter-card.locked{background:#34452d;border-color:#90a47760}.letter-card.locked h3,.letter-card.locked p{color:#a9b59a}.journal-intro{color:#d4d6b1}
.settings-wrap{max-width:960px}.settings-language{display:flex;align-items:center;justify-content:space-between;gap:15px}.settings-language .language-select{max-width:240px;min-width:160px}
[lang=zh] .eyebrow,[lang=ja] .eyebrow{letter-spacing:1px}[lang=zh] .btn,[lang=ja] .btn{letter-spacing:.5px}
[lang=de] .menu-button-row .btn{font-size:12px}[lang=de] .auto-wave b{font-size:11px}
@media(min-width:1500px){.hero{padding:35px 0}.hero h1{font-size:116px}.hero-actions{width:380px}.hero-subtitle{margin-bottom:33px}#continueBtn{min-height:66px}}
@media(max-width:900px){.route-grid{gap:16px 12px}.operation-board{padding:23px 19px}.chapter-tabs .chapter-tab{font-size:10px;padding:9px 11px}.battle-name{max-width:260px}.battle-name .eyebrow{max-width:230px}.hud-stats{gap:17px}.commandbar .wave-button{min-width:145px}.arsenal-grid{grid-template-columns:repeat(2,1fr)}.arsenal-heading{gap:5px}.arsenal-heading canvas{width:120px;height:85px}.arsenal-title h3{font-size:23px}}
