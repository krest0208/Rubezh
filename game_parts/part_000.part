@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

/* Front page: one primary action, two secondary actions, no button wall. */
[hidden],.legacy-menu{display:none!important}
#menu{display:flex;flex-direction:column;min-height:0;height:var(--app-height,100dvh);padding:16px 24px 10px;overflow:auto}
#menu .menu-top{flex:0 0 auto;min-height:45px;padding-bottom:9px}
#menu .hero{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1 0 auto;min-height:0;width:430px;max-width:100%;margin:0 auto;padding:20px 0}
#menu .hero-actions{width:340px;display:flex;flex-direction:column;gap:8px;max-width:100%}
#menu .hero h1{font-size:clamp(45px,7vw,91px);margin:0 0 9px;line-height:1.06;letter-spacing:5px}
#menu .hero-subtitle{font-size:13px;margin:0 0 26px;line-height:1.5}
#menu #continueBtn{background:linear-gradient(#889b57,#677d3e);color:#fff5da;border:1px solid #d2d5a0;box-shadow:inset 0 1px #f8ffd940,0 4px 0 #182610,0 9px 18px #0005;min-height:56px;text-shadow:0 2px #273516}
#menu #continueBtn:hover{background:linear-gradient(#a0b362,#7d9349)}
#menu .main-secondary{display:grid;grid-template-columns:1fr 1fr;gap:8px;width:100%}
#menu .main-secondary .btn{min-width:0;min-height:45px;line-height:1.2;overflow-wrap:anywhere}
#menu .menu-progress{font-size:11px;margin-top:17px;letter-spacing:1px}
#menu .menu-bottom{flex:0 0 auto;min-height:41px;padding-top:9px}
#menu .wallet-button{cursor:pointer;min-height:42px;min-width:52px;font-family:inherit;display:inline-flex;align-items:center;justify-content:center;padding:8px 10px}
#menu .wallet-button small{border-left:1px solid #a8d88a55;margin-left:4px;padding-left:7px;font-size:17px;color:#d1e9ad;line-height:1}
#menu .wallet-button:hover{background:#46543b;border-color:#c8ce9b}
#menu .wallet-button:focus-visible{outline:2px solid #f5dd9d}
.campaign-head-actions{display:flex;align-items:center;gap:8px}
.settings-language{display:flex;align-items:center;justify-content:space-between;gap:18px}
.settings-language p{margin-bottom:0}.settings-language select{flex-shrink:0}
#settingsPure,#settingsHints{width:22px;height:22px;accent-color:#889b57}
#battle>.tutorial{position:relative;inset:auto;display:flex;align-items:center;gap:15px;flex:0 0 auto;width:100%;max-width:none;max-height:130px;overflow:hidden;border:0;border-bottom:1px solid #9c9e73;border-radius:0;padding:9px max(12px,env(safe-area-inset-right)) 9px max(12px,env(safe-area-inset-left));background:#2e3929;box-shadow:0 3px 0 #11190f70;pointer-events:auto;z-index:4;margin:0}
#battle>.tutorial.hidden{display:none}
.context-tip-copy{flex:1;min-width:0;max-height:108px;overflow:auto;text-align:left}
#battle>.tutorial .guide-label{font-size:8px;line-height:1.25;letter-spacing:1px;margin:0 0 3px;color:#b9c892}
#battle>.tutorial b{font-size:13px;line-height:1.3;letter-spacing:0;color:#f0dea9;margin:0 0 3px}
#battle>.tutorial p{font-size:11px;line-height:1.5;margin:0;color:#dbddc5}
.context-tip-actions{display:flex;flex-direction:column;align-items:stretch;gap:4px;min-width:130px;max-width:185px;flex-shrink:0}
#battle>.tutorial .context-tip-actions .btn{min-height:32px;padding:5px 9px;font-size:11px}
#battle>.tutorial .guide-close{font-size:10px;line-height:1.35;color:#d0d2b8;border:1px solid #bec39758;background:#202a20;border-radius:2px;padding:6px 8px;min-height:32px;cursor:pointer}
#battle>.tutorial .guide-close:hover{border-color:#e4d3a1;background:#424d35}
#battle .guide-focus{outline:2px solid #f5db91!important;outline-offset:-2px;box-shadow:inset 0 0 0 1px #312818!important}
@media(max-width:650px){
 #menu{padding:11px 12px 9px}#menu .menu-top{min-height:42px}#menu .brandmark>span{font-size:10px;letter-spacing:1px}
 #menu .brand-sub{font-size:7px}#menu .brandmark{gap:5px}#menu .brandmark svg{width:18px}
 #menu .menu-top-right{gap:5px}#menu .wallet-button{min-width:42px;padding:7px 8px;font-size:12px;min-height:39px}
 #menu .wallet-button svg{width:15px;height:15px}#menu .wallet-button small{font-size:13px;padding-left:5px;margin-left:1px}
 #menu .hero{padding:15px 0}#menu .hero-actions{width:310px}#menu .hero h1{font-size:clamp(46px,15vw,68px);letter-spacing:3px}
 #menu .hero-subtitle{font-size:12px;letter-spacing:.25px;margin-bottom:22px}#menu .title-overline{font-size:9px;letter-spacing:3px}
 #menu #continueBtn{min-height:54px;font-size:20px}#menu .main-secondary .btn{min-height:45px;font-size:12px}
 #menu .menu-bottom{min-height:43px;gap:8px}#menu .menu-bottom .campaign-era{font-size:7px;max-width:45%;line-height:1.5}
 #menu .language-select{min-height:35px;font-size:11px}
 .settings-language{flex-direction:column;align-items:stretch}
 .campaign-head-actions{gap:4px}.campaign-head-actions .tag{font-size:8px;letter-spacing:0;padding:5px}
 #battle>.tutorial{max-height:142px;padding:8px;gap:8px}
 .context-tip-copy{max-height:122px}#battle>.tutorial p{font-size:10px;line-height:1.45}#battle>.tutorial b{font-size:12px}
 .context-tip-actions{min-width:96px;max-width:112px}#battle>.tutorial .guide-close{font-size:9px}
}
@media(max-height:520px){
 #menu{padding:6px 13px}#menu .menu-top{min-height:34px;padding-bottom:5px}#menu .brand-sub{display:none}
 #menu .menu-top .icon-btn{height:33px;min-width:33px;padding:7px}
 #menu .wallet-button{min-height:32px;height:32px;padding:5px 9px}
 #menu .hero{padding:5px 0;flex:1 0 auto}#menu .hero h1{font-size:44px;letter-spacing:3px;margin-bottom:5px}
 #menu .title-overline{display:none}#menu .hero-subtitle{font-size:11px;margin-bottom:11px}
 #menu .hero-actions{gap:6px;width:300px}#menu #continueBtn{min-height:43px;font-size:18px}
 #menu .main-secondary .btn{min-height:37px;font-size:11px;padding:7px 10px}
 #menu .play-caption{font-size:9px;margin:0 0 3px}#menu .menu-progress{margin-top:9px;font-size:9px}
 #menu .menu-bottom{min-height:32px;padding-top:5px}#menu .language-select{min-height:27px;height:27px;font-size:10px}
 #battle>.tutorial{max-height:91px;padding:5px 10px;gap:12px}.context-tip-copy{max-height:79px}
 #battle>.tutorial .guide-label{display:none}#battle>.tutorial b{font-size:11px;margin-bottom:2px}#battle>.tutorial p{font-size:10px;line-height:1.35}
 .context-tip-actions{flex-direction:row;max-width:210px;min-width:150px}#battle>.tutorial .context-tip-actions .btn{min-height:32px;font-size:10px}
 #battle>.tutorial .guide-close{max-width:116px;font-size:9px;min-height:32px}
}
@media(max-height:350px){
 #menu .hero h1{font-size:34px}#menu .hero-subtitle,#menu .play-caption,#menu .menu-progress{display:none}
 #menu .hero-actions{gap:6px}#menu #continueBtn{min-height:40px}#menu .main-secondary .btn{min-height:35px}
 #menu .hero{padding:4px 0}#menu .menu-bottom .campaign-era{max-width:none}
}
/* Briefing: the deployment footer must never inherit a narrow text column. */
.brief-actions{min-width:0;align-items:stretch}
.brief-actions .btn{min-width:0;white-space:normal;line-height:1.2;overflow-wrap:anywhere}
.brief-actions #briefBack{flex:0 1 45%;max-width:45%}
.brief-actions #deployBtn{flex:1 1 55%;padding-left:10px;padding-right:10px}
@media(max-width:650px) and (min-height:431px){
 #brief{padding:9px}.brief-card{display:flex;flex-direction:column;height:100%;max-height:900px;grid-template-columns:none}
 .brief-left{flex:0 1 43%;max-height:43%;padding:18px;overflow:auto;min-height:0}
 .brief-left h2{font-size:28px;margin:13px 0 8px}.brief-place{margin-bottom:10px}
 .brief-right{flex:1 1 57%;display:flex;min-height:0}.brief-orders{padding:15px;gap:10px}
 .brief-map-wrap{height:95px;display:block}.brief-actions{padding:10px 14px;gap:9px}
 .brief-actions .btn{min-height:45px;font-size:12px}.brief-actions #deployBtn{font-size:17px;min-height:45px}
}
@media(max-width:650px) and (min-height:431px) and (max-height:620px){
 .brief-map-wrap{display:none}.brief-left{padding:14px}.brief-left h2{font-size:25px}.brief-orders{padding:13px;gap:8px}
 .brief-orders p{font-size:11px}.brief-stats{padding:8px 0}.brief-stats strong{font-size:21px}
}
@media(max-height:430px){
 .brief-actions{padding:7px 10px;gap:7px}.brief-actions .btn{font-size:11px;padding:7px;min-height:37px}
 .brief-actions #deployBtn{font-size:15px;min-height:37px}
}
@media(max-width:650px){
 .commandbar{display:grid;grid-template-columns:32px minmax(48px,.75fr) minmax(54px,1fr) minmax(80px,1.15fr) 32px;gap:4px;padding:4px;height:47px;min-height:47px;justify-content:stretch;align-items:center}
 .commandbar .fold-btn{width:32px;min-width:32px;height:36px;margin:0;padding:3px;display:flex;align-items:center;justify-content:center}
 #toggleHud{grid-column:1}#toggleDock{grid-column:5}
 .commandbar .mini-stats{grid-column:2;min-width:0;width:auto;max-width:100%;white-space:normal;text-align:center;font-size:8px;line-height:1.5}
 .commandbar .wave-button{grid-column:2 / 4;min-width:0!important;width:auto;padding:4px;min-height:36px;justify-content:center}
 .hud-folded .commandbar .wave-button{grid-column:3}
 .commandbar .wave-button svg,.commandbar .wave-button span{display:none!important}
 .commandbar .wave-button b{font-size:9px;line-height:1.2;white-space:normal;letter-spacing:0}
 .commandbar .auto-wave{grid-column:4;min-width:0!important;width:auto;min-height:36px;padding:3px;justify-content:center}
 .commandbar .auto-wave b{font-size:9px;line-height:1.15;white-space:normal;letter-spacing:0}
 .commandbar .auto-wave small{font-size:7px;white-space:normal;line-height:1.15}
}
@media(max-width:650px) and (min-height:431px){
 .dock{height:118px;min-height:118px;flex-wrap:wrap;padding:6px;gap:5px}
 .tower-shop{flex:1 1 100%;gap:4px;max-width:none}.tower-card canvas{width:45px;height:29px}
 .tower-card{padding:2px}.tower-card .name{font-size:7.5px;height:17px;display:flex;justify-content:center;align-items:center}
 .tower-card .cost{font-size:9px}.abilities{padding:0;border:0;gap:5px;flex:1;height:32px}
 .ability{flex:1;flex-direction:row;min-width:0;gap:7px;padding:4px 7px}.ability svg{width:18px;height:18px}.ability span,.ability small{font-size:10px}
}
/* Camera and support hotfix: no main-menu layout changes. */
#game{touch-action:none;background:#101419}
.map-controls{position:absolute;top:8px;right:8px;z-index:5;display:flex;gap:3px}
.map-controls button{width:32px;height:30px;padding:0;background:#28372ce8;color:#ece2bd;border:1px solid #b2b28470;font:20px Georgia;cursor:pointer;border-radius:2px;touch-action:manipulation}
.map-controls button:focus-visible{outline:2px solid #f0d17d;outline-offset:2px}
.patch-minimap{position:absolute;right:8px;bottom:8px;width:130px;height:45px;z-index:4;border:1px solid #adae8677;background:#101419;touch-action:none}
#selectedPanel{z-index:6}
.support-cost{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;margin:18px 0;padding:16px;border:1px solid #b7a96777}
.support-cost strong{color:#f5d47e}.support-note{font-size:13px;line-height:1.5}
.ability.unaffordable small{color:#e6a489}.tower-health-line{font-size:12px;padding:7px 0;color:#e5dca9}
#repairTower{margin-top:7px;width:100%;font-size:11px}
@media(max-height:340px){.map-controls{top:4px;right:4px}.map-controls button{height:26px;width:29px}.support-cost{padding:8px;margin:8px 0}.support-note{font-size:11px}}

/* Keep camera buttons and earned coins clear of the existing pause control. */
.map-controls{right:58px}
.survival-loot{right:172px;max-width:calc(100% - 182px)}
@media(max-height:340px){.map-controls{right:51px}.survival-loot{right:154px;max-width:calc(100% - 164px)}}

/* Restored field-order presentation: paper, olive panels and red actions. */
:root{--paper:#e5ddba;--paper-ink:#33382b;--classic-olive:#48583c;--classic-red:#aa4930;--rack:516px}
#backdrop{filter:saturate(.95) sepia(.04)}
#veil{background:linear-gradient(#31422b28,#31422b38);box-shadow:inset 0 0 150px #1f352948}
#veil:after{background:repeating-linear-gradient(90deg,transparent 0 99px,#e6e2b914 100px),repeating-linear-gradient(0deg,transparent 0 99px,#e6e2b914 100px)}
#menu{padding:0;gap:12px;overflow:auto;justify-content:space-between}
#menu .menu-top{width:100%;padding:12px 24px;background:#283e30e8;border:0;min-height:66px;box-sizing:border-box}
#menu .brandmark>span{font:700 21px Georgia,serif;letter-spacing:3px;color:#efe4bd}#menu .brandmark svg,.brand-sub{display:none}
#menu .menu-top-right{gap:12px}#menu .wallet-chip{box-shadow:none;background:none;border:0;border-left:1px solid #d4d6b733;padding:10px 14px;border-radius:0;font-weight:600}#menu .wallet-chip.gems{color:#a6d4a4}#menu .wallet-chip small{display:none}
#menu .menu-top .icon-btn{background:#465840a8;border-color:#b1b39465}
#menu .hero{width:410px;max-width:calc(100% - 36px);margin:auto;flex:none;padding:28px 43px 25px;background:repeating-linear-gradient(0deg,#ffffff03 0 1px,#554c2404 1px 3px),var(--paper);border:5px double #928d66;box-shadow:3px 7px 0 #20322255,0 12px 35px #18302028;color:var(--paper-ink)}
#menu .hero:before,#menu .hero:after{content:"";position:absolute;top:-8px;width:48px;height:17px;background:#b8b386aa;box-shadow:0 1px #9f9b7855;transform:rotate(-10deg)}#menu .hero:before{left:25px}#menu .hero:after{right:27px;transform:rotate(8deg)}
#menu .title-overline{font-size:0;letter-spacing:0;height:28px;margin:0 0 11px;line-height:28px}
#menu .title-overline:before{content:"\2605";font-size:25px;line-height:28px;color:var(--classic-red);background:none;width:auto;height:auto}
#menu .title-overline:after{display:none}
#menu .hero h1{font-family:Arial,sans-serif;font-weight:800;font-size:70px;line-height:1.12;letter-spacing:2px;color:#2c3425;text-shadow:none;margin:0 0 13px;overflow-wrap:normal}
#menu .hero-subtitle{font-family:Georgia,serif;font-size:14px;line-height:1.5;font-style:italic;color:#474c38;letter-spacing:0;margin:0 0 23px}
.title-ruler,#playCaption{display:none!important}
#menu .hero-actions{width:100%;max-width:none;gap:10px}#menu .hero .main-secondary{display:flex;flex-direction:column;gap:10px;width:100%}
#menu .hero .btn{min-height:54px;padding:11px 20px;font-size:18px;position:relative;justify-content:center;letter-spacing:0;text-shadow:none;border-radius:2px}
#menu .hero .btn svg{position:absolute;left:17px;width:21px;height:21px}#menu .hero #continueBtn{font-size:19px;min-height:56px;letter-spacing:0}
.btn.primary,.wave-button.primary{background:#aa4930;color:#fff5d8;border:1px solid #773b28;box-shadow:inset 0 1px #f4bb7e77,0 3px 0 #713623;text-shadow:none}
.btn.primary:hover,.wave-button.primary:hover{background:#bb583d;color:#fff8e9;border-color:#8e452f}
#menu .hero .secondary{background:#4a593b;color:#eee7bf;border-color:#32412b;box-shadow:inset 0 1px #b4bc8255,0 3px 0 #2c3b28}
#menu .hero .quiet{background:#e7deb7;color:#383e2c;border:1px solid #999368;box-shadow:inset 0 1px #fffbde,0 2px 0 #a09a72}
#menu .hero .quiet:hover{background:#f1e8c3}#menu .hero .secondary:hover{background:#5a6a47}
#menu .menu-progress{display:inline-block;flex:none;width:auto;max-width:100%;margin:23px auto 0;padding:6px 3px 5px;border-top:2px solid #a5a077;border-bottom:1px solid #a5a077;color:#7a7859;font-size:10px;font-weight:400;letter-spacing:1px;text-transform:uppercase}
#menu .menu-bottom{width:100%;border:0;padding:8px 23px;background:#31453178;min-height:38px;color:#e9e3c2;justify-content:space-between}
#menu .menu-bottom .campaign-era{color:#e9e3c2}#menu .language-control{color:#efe8cb}#menu .language-select{background:#34482fd9;border-color:#8c9d7599}
.page{background:#283e31df;gap:12px}.page-head{padding-bottom:10px}.page-head h2{color:#f1e7c5}
.page>.scroll{background:repeating-linear-gradient(0deg,#fff2 0 1px,transparent 1px 3px),var(--paper);color:var(--paper-ink);border:4px double #9c9670;border-radius:1px;padding:20px 24px;scrollbar-color:#889167 #d3cfaa}
.page .chapter-head h3,.page .chapter-head p,.page .chapter-index,.page .campaign-note{color:#444b35}
.chapter-tabs{flex:none;gap:6px}.chapter-tab{display:flex;align-items:center;justify-content:center;gap:12px;min-height:43px;flex:1;background:#415338;border-color:#91a17a88;color:#efe6c2;font-size:13px;padding:8px 10px}.chapter-tab small{font-size:10px;opacity:.8}.chapter-tab.active{background:var(--paper);color:#303c2b;border-color:#d9cea4;box-shadow:none}
.sheet-navigation{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin:6px 0 15px;color:#4b5139;font-size:12px}
.sheet-navigation .btn{min-height:38px;padding:6px 14px}.sheet-navigation select{min-height:38px;background:#f1e8c6;border:1px solid #a19b76;color:#3e472e;max-width:180px}.sheet-navigation .sheet-current{margin-left:auto}
.sheet-navigation label{font-size:11px}.page .sheet-navigation .btn.quiet{background:#536145;color:#f1e9c9;border-color:#394c30;box-shadow:0 2px 0 #36462c}
.operation-board{border:1px solid #899267;box-shadow:2px 4px 0 #949b7055}.map-meta{color:#3d5233}.route-grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:22px 32px;max-width:760px;margin:0 auto;padding:24px 36px 28px}
.route-node{min-width:0;min-height:73px}.route-node .node-number{font-size:23px}.route-node .node-stars{font-size:10px}.route-node.current{box-shadow:0 0 0 3px #b34d3699,0 5px 0 #475c34}.route-node.available{background:#b4bd87;color:#304427}.route-node:disabled{opacity:.54}
.operations-key{background:#e1d9b6eb;color:#38422f;border-top:1px solid #819062;padding:14px 18px}.operations-key b{color:#2e3929}.operations-key .btn{flex:none;min-width:130px}
.campaign-note{margin:13px 0 0;font-size:12px;line-height:1.5}.campaign-pressure{display:flex;gap:10px;flex-wrap:wrap;align-items:center;font-size:11px;color:#ddd5b0;margin:9px 0 3px}.campaign-pressure strong{margin-left:auto}.pressure-track{height:4px;width:100%;background:#202c2277}.pressure-track i{display:block;height:100%;background:#cc7953}
.brief-card{border:4px double #968963;border-radius:1px;box-shadow:4px 6px 0 #15261c55}.brief-left{background:repeating-linear-gradient(0deg,#fff1 0 1px,transparent 1px 3px),var(--paper)}.brief-actions{background:#354930}.brief-actions .btn.primary{min-width:145px}
.modal-box{background:repeating-linear-gradient(0deg,#fff1 0 1px,transparent 1px 3px),var(--paper);border:4px double #978d66;color:var(--paper-ink);box-shadow:4px 7px 0 #1b2e2455}
.modal-box h2,.modal-box h3,.modal-box p,.modal-box .eyebrow{color:#3b432f}.modal-actions{background:var(--paper);border-color:#a69e7866}.modal-box .setting-row,.modal-box .check-label{color:#3e4b31}.modal-box .result-numbers div{color:#4a5138}.modal-box .result-numbers strong{color:#3a452d}.result-stars{color:#b96b33}.reward-line{color:#735a29}.modal-box .support-cost{background:#d2c99f;color:#383f2d;border-color:#aa9f73}.support-cost strong,.support-note{color:#495439}.modal-box .branch-card{color:#eae5c9}
#auxContent .setting-card,#auxContent .help-card,#auxContent .research-card,#auxContent .arsenal-card,#auxContent .market-card{background:#d9d4af;color:#3b462e;border-color:#b0ab80;box-shadow:none}
#auxContent h3,#auxContent h4,#auxContent p,#auxContent .muted,#auxContent .eyebrow{color:#49533b}#auxContent .research-card .level{color:#3e4e30}#auxContent .letter-card{background:#eee6c6;color:#3a432e;border-color:#aea17b}.letter-card h3,.letter-card p,.letter-card .eyebrow{color:#3d452f}
/* Floating battle controls restore the older, field-first arrangement. */
#battle{display:block;position:absolute;inset:0;--rack:516px}
#battle #field{position:absolute;inset:0;min-height:0;display:block;padding:0;overflow:hidden}
#battle #game{position:absolute;inset:0;width:100%;height:100%;display:block}
#battle .topbar{position:absolute;top:12px;left:12px;right:12px;height:44px;min-height:44px;padding:0;background:none;border:0;display:flex!important;align-items:flex-start;z-index:13;pointer-events:none;box-shadow:none;transform:none;opacity:1}
#battle .hud-stats{display:flex;gap:0;pointer-events:auto;background:#334930ee;border:1px solid #b0b58288;box-shadow:2px 3px 0 #24342244;border-radius:2px}
#battle .hud-stat{padding:5px 13px;min-width:84px;border-right:1px solid #b7c49333;color:#efe9c2;gap:2px}
#battle .hud-stat span{font-size:8px;line-height:1.1;color:#ced8b1}#battle .hud-stat strong{font-size:18px;line-height:1.25;color:#f2e6b0}
#battle .hud-controls{position:absolute;right:0;top:0;pointer-events:auto;display:flex;gap:7px}
#battle .hud-controls .icon-btn{width:41px;height:41px;min-width:41px;padding:9px;background:#334930ed;border-color:#b0b58288}
#battle .battle-name{position:absolute;top:52px;left:0;max-width:440px;display:block;padding:0;pointer-events:none}
#battle .battle-name .eyebrow{color:#f4eed2;text-shadow:0 1px 3px #1d3123;font-size:9px}#battle .battle-name h2{font-size:13px;color:#f5efd4;text-shadow:0 1px 3px #1d3123;margin:3px 0 0}
#battle.hud-folded .hud-stats,#battle.hud-folded .battle-name{display:none}
#battle .commandbar,#battle .dock{display:contents!important;position:static;transform:none;border:0;background:none;min-height:0;height:0;padding:0}
#battle #waveBtn{position:absolute;right:16px;bottom:18px;width:150px;height:52px;min-height:52px;z-index:16;padding:8px 10px;font-size:14px}
#battle #autoWaveBtn{position:absolute;right:16px;bottom:79px;width:150px;min-height:34px;height:34px;z-index:16;background:#30462feb;color:#e9e6c5;border:1px solid #a7b38499;border-radius:2px;font-size:11px}
#battle #autoWaveBtn[aria-pressed="true"]{background:#547343;border-color:#bfce87;color:#f5f2d4}
#battle #towerShop{position:absolute;bottom:16px;left:50%;transform:translateX(-50%);width:var(--rack);max-width:none;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:2px;z-index:15;padding:6px;background:#2e432bec;border:1px solid #a5b082aa;border-radius:2px;box-shadow:2px 4px 0 #24362250;flex:none}
#battle .tower-card{width:auto;min-width:0;max-width:none;height:90px;padding:0 1px 5px;background:#64744b4a;border-color:transparent;border-radius:2px;display:flex;flex-direction:column;align-items:center;justify-content:center}
#battle .tower-card:hover{background:#82945b55}#battle .tower-card.selected{background:#afb87a66;border-color:#ecdc9c}#battle .tower-card .name{font-size:10px;color:#f1eacc}#battle .tower-card .cost{font-size:13px;color:#edd89e;margin-top:2px}#battle .tower-card canvas{width:72px;max-width:100%;height:48px}#battle .tower-card .key{font-size:8px;top:3px;left:4px;color:#d6d9b6}
#battle .abilities{position:absolute;left:16px;bottom:17px;display:flex;gap:7px;z-index:16;width:auto;padding:0;background:none;border:0}
#battle .ability{height:82px;width:64px;min-height:0;background:#334c31ec;color:#efead0;border:1px solid #a5b384;border-radius:2px;padding:7px 3px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:4px}
#battle .ability svg{width:23px;height:23px}#battle .ability span{font-size:9px}#battle .ability small{font-size:10px;color:#f1d392}#battle .ability.unaffordable{opacity:.67}
#battle #toggleHud{position:absolute;left:284px;top:12px;height:44px;width:27px;min-width:27px;z-index:17;background:#344a31ed;border:1px solid #adba8899;transform:none;border-radius:2px}
#battle #toggleDock{position:absolute;bottom:16px;left:calc(50% + var(--rack) / 2);height:104px;width:26px;min-width:26px;z-index:17;background:#344a31ed;border:1px solid #adba8899;transform:none;border-radius:0 2px 2px 0}
#battle.dock-folded #towerShop{display:none}#battle.dock-folded #toggleDock{left:calc(50% - 22px);height:39px;width:44px}
#battle #miniStats{position:absolute;left:12px;top:12px;z-index:16;height:39px;padding:8px 10px;background:#33492fee;border:1px solid #b0b58288;color:#eee5bc;line-height:22px;border-radius:2px;font-size:12px;gap:9px;pointer-events:auto;min-width:187px}
#battle.hud-folded #toggleHud{left:211px;height:39px}#battle #miniStats.hidden{display:none!important}
#compactPause{display:none!important}
#battle #fieldTag{display:none}#battle #nextInfo{position:absolute;left:50%;top:16px;transform:translateX(-50%);background:#243e25b8;color:#eee8c5;border:1px solid #9dad7255;max-width:340px;font-size:10px;padding:5px 11px;z-index:7;pointer-events:none}
#battle #survivalLoot{position:absolute;left:12px;top:96px;z-index:8;font-size:10px;background:#34492dc9;border:1px solid #a6b08377}
#battle #mapControls{position:absolute;right:16px;top:69px;z-index:18;display:flex;flex-direction:column;gap:4px}
#battle #mapControls button{height:32px;min-height:32px;width:36px;background:#334b31eb;border-color:#aab68488;border-radius:2px;font-size:18px;color:#efe7c3}
#battle #minimap{left:16px;bottom:116px;width:176px;height:61px;z-index:14;border:2px solid #b2b98899;background:#324a2fee}
#battle #selectedPanel{position:absolute;top:74px;right:66px;width:268px;max-height:calc(100% - 208px);overflow:auto;z-index:20;background:var(--paper);border:3px double #92895f;color:#333f2b;padding:13px;border-radius:2px;box-shadow:3px 4px #233a2844}
#battle #selectedPanel strong,#battle #selectedPanel p,#battle #selectedPanel small,#battle #selectedPanel .eyebrow,#battle #selectedPanel .selected-stats,#battle #selectedPanel .tower-health-line{color:#3d4a30}
#battle #selectedPanel .btn{font-size:12px;padding:8px 10px;min-height:38px}#battle #selectedPanel .selected-head .icon-btn{width:28px;height:28px;min-width:28px;padding:6px;background:#4d603c}
#battle #selectedPanel .selected-description{color:#526041}#battle #selectedPanel .selection-details{color:#485739}#battle #selectedPanel .selected-details{color:#485739}
#battle #tutorial{position:absolute;left:16px;top:112px;z-index:21;display:flex;flex-direction:column;max-width:calc(100% - 82px);width:302px;max-height:calc(100% - 249px);overflow:auto;padding:14px;background:#e8dfbdee;color:#38422c;border:3px double #9e946b;border-radius:2px;box-shadow:3px 5px #23362233}
#battle #tutorial.hidden{display:none!important}#battle #tutorial p,#battle #tutorial b,#battle #tutorial .guide-label{color:#3e4a2e}#battle #tutorial p{font-size:12px;line-height:1.45;margin:6px 0}.context-tip-actions{display:flex;flex-wrap:wrap;gap:7px}.context-tip-actions .btn{min-height:34px;font-size:11px}.context-tip-actions .guide-close{color:#5f5335;border-color:#97876066;font-size:10px;min-height:32px;background:transparent}
#toast{bottom:132px;z-index:70;border-radius:2px;background:#253e2cf0;color:#f3e9c7;border:1px solid #bdc79599}
@media(max-width:1100px){#battle{--rack:432px}#battle .tower-card{height:84px}#battle .tower-card canvas{height:44px;width:66px}#battle #toggleDock{height:98px}#battle #nextInfo{top:64px;max-width:250px}}
@media(orientation:landscape) and (max-height:540px){
