 #battle #nextInfo{top:9px;left:52%;max-width:235px;padding:4px 7px;font-size:9px}#battle #mapControls{right:10px;top:53px;gap:3px}#battle #mapControls button{height:28px;min-height:28px;width:30px;font-size:16px}#battle #selectedPanel{right:48px;top:54px;width:245px;max-height:calc(100% - 151px);padding:10px}#battle #tutorial{left:9px;top:79px;width:258px;padding:10px;max-height:calc(100% - 179px)}#battle #tutorial p{font-size:11px}#battle #tutorial .guide-label{font-size:8px}#battle #tutorial b{font-size:13px}.context-tip-actions .btn{min-height:29px;padding:5px 9px}#battle #minimap{left:9px;bottom:93px;width:140px;height:48px}#battle #survivalLoot{left:9px;top:70px;font-size:9px}#toast{bottom:94px;font-size:11px;padding:9px 13px}
