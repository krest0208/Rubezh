 .operation-board{padding:18px 13px 22px}.map-meta{font-size:8px;letter-spacing:.4px;margin-bottom:14px}.route-grid{gap:13px 5px}.route-node{min-height:58px}.route-node .node-number{width:36px;height:35px;font-size:16px;outline-width:2px}.route-node:before{top:19px;left:-6px;right:-6px}.route-node:nth-child(6n):after{top:19px;height:71px}.route-node .node-stars{font-size:8px;letter-spacing:0}.route-node.current .node-stars{font-size:6px}
 .operations-key{margin-top:16px;gap:10px;font-size:10px;align-items:stretch;flex-direction:column}.operations-key .btn{min-height:43px}.operations-key b{font-size:13px}.campaign-note{font-size:11px}
 .topbar{height:46px;min-height:46px;padding:4px 9px;gap:6px}.hud-stats{gap:14px;justify-content:space-around;flex:1}.hud-stat strong{font-size:18px}.hud-stat span{font-size:7px}.hud-controls .icon-btn{min-width:34px;height:34px;padding:7px}.hud-controls{gap:4px}.battle-name{display:none}
