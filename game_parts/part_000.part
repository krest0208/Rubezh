<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#293126"><meta name="description" content="Рубеж. Тактическая оборона. 1000 миссий и бесконечное выживание."><title>Рубеж</title><style>
:root{--ink:#112b36;--panel:#173846;--line:#b2d7cd30;--cream:#f5f4e5;--muted:#abc7ca;--gold:#ffd16b;--red:#ff9779;--green:#78e8bb;--shadow:0 22px 75px #00162388;--blue:#79dcf8}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--ink);color:var(--cream);font-family:"Trebuchet MS",Arial,sans-serif}
button,select,input,textarea{font:inherit}button{color:inherit;border:1px solid var(--line);cursor:pointer;background:#234757;transition:background .15s,transform .15s,border-color .15s;touch-action:manipulation}
button:hover{background:#315b69;border-color:#b8ddcc88}button:active{transform:translateY(1px)}button:focus-visible,select:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
button:disabled{opacity:.4;cursor:default;transform:none}button svg{pointer-events:none;flex-shrink:0}.hidden{display:none!important}
#app{position:relative;width:100%;height:100%;isolation:isolate}#backdrop{position:absolute;inset:0;width:100%;height:100%;z-index:-2}
#veil{position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 50% 48%,#082b3be6 0%,#102e3abb 27%,#13342d40 70%),linear-gradient(0deg,#0d2b37db,transparent 30%,transparent 75%,#0d2b37bd)}
.screen{position:absolute;inset:0}.eyebrow{font-size:10px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;color:var(--gold)}.muted{color:var(--muted)}.serif{font-family:Georgia,serif}
.primary{background:var(--gold);border-color:var(--gold);color:#19353b;font-weight:bold;box-shadow:0 4px 0 #bb91442b}.primary:hover{background:#ffdfa0;color:#17313a}
.icon-btn{display:inline-flex;align-items:center;justify-content:center;min-width:44px;height:44px;padding:11px;border-radius:12px;flex-shrink:0;background:#173b4bbd}.icon-btn svg{width:20px;height:20px}
.btn{min-height:49px;padding:13px 21px;border-radius:12px;display:inline-flex;gap:11px;align-items:center;justify-content:center;font-size:14px;font-weight:bold}.btn svg{width:18px;height:18px}.quiet{background:#143441ab}.secondary{background:#2c5b63d9}
.divider{height:1px;background:var(--line);margin:19px 0}.tag{font-size:11px;letter-spacing:1px;color:var(--gold);border:1px solid var(--line);padding:9px 12px;border-radius:10px;display:inline-block}
#menu{padding:22px 3vw 17px;display:flex;flex-direction:column;gap:10px;overflow-y:auto}
.menu-top{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-shrink:0}.brandmark{display:flex;align-items:center;gap:11px}.brandmark svg{width:25px;height:30px;color:var(--gold)}
.brandmark>span{font-size:13px;letter-spacing:2px;font-weight:bold}.brand-sub{display:block;font-size:8px;letter-spacing:1.5px;color:var(--muted);margin-top:4px}.version-chip{font-size:9px!important;border:1px solid #b6d5bc55;border-radius:6px;padding:5px;color:var(--green)}
.menu-top-right{display:flex;align-items:center;gap:7px}.wallet{display:flex;gap:8px}.wallet-chip{display:inline-flex;align-items:center;gap:7px;padding:10px 13px;background:#103442d9;border:1px solid #b1d3be36;border-radius:12px;font-size:14px;font-weight:bold;color:var(--gold)}
.wallet-chip svg{width:18px;height:18px}.wallet-chip.gems{color:var(--green)}
.hero{width:min(470px,100%);margin:auto;display:flex;flex-direction:column;align-items:center;text-align:center;padding:10px 0;flex-shrink:0}
.hero-kicker{font-size:9px;letter-spacing:3px;display:flex;gap:9px;align-items:center;margin-bottom:16px}.hero-kicker i{width:6px;height:6px;background:var(--green);border-radius:50%;box-shadow:0 0 15px #7edc9e}
h1{font-family:Impact,"Arial Narrow",Arial,sans-serif;font-size:clamp(67px,8.5vw,116px);letter-spacing:6px;line-height:1;margin:0 0 4px;font-weight:900;text-shadow:0 7px 30px #0d263c80}.title-dot{color:var(--gold);margin-left:-4px}.hero-subtitle{font-family:Georgia,serif;font-size:25px;font-style:italic;color:#fce6b3;margin:2px 0 15px}
.hero-copy{font-size:12px;line-height:1.6;color:#cce1d7;margin:0 0 25px}.hero-actions{display:flex;flex-direction:column;gap:9px;width:min(394px,100%)}
.menu-button-row{display:grid;grid-template-columns:1fr 1fr;gap:9px}.menu-button-row.three{grid-template-columns:repeat(3,1fr)}.menu-button-row .btn{padding:12px 10px}.secondary{flex-direction:column;gap:3px;font-size:13px}.secondary span{font-size:9px;color:#b9dfce;letter-spacing:.6px;font-weight:normal}.small-btn{font-size:11px;min-height:40px}
.difficulty-line{display:flex;align-items:center;justify-content:center;gap:9px;font-size:10px;color:var(--muted);margin-top:16px;flex-wrap:wrap}.difficulty-line select{background:#153643;color:var(--cream);border:1px solid var(--line);border-radius:7px;padding:7px;font-size:11px;min-height:35px}
.check-label{display:flex;align-items:center;gap:4px;cursor:pointer}.check-label input{accent-color:var(--gold);width:16px;height:16px}.menu-progress{font-size:10px;color:#afd1c3;margin-top:13px;letter-spacing:.5px}.menu-bottom{display:flex;align-items:center;justify-content:space-between;font-size:9px;letter-spacing:1.5px;color:#ccded0;gap:15px;flex-shrink:0}.menu-bottom i{display:inline-block;width:3px;height:3px;background:var(--gold);border-radius:50%;vertical-align:middle;margin:0 8px}
.page{background:linear-gradient(120deg,#193d4af7,#112f3df2);padding:22px 3.5vw;display:flex;flex-direction:column;gap:20px}.page-head{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-shrink:0}.page-heading{display:flex;align-items:center;gap:14px}.page-head h2{margin:4px 0 0;font-size:28px;font-weight:normal}.page-head .tag{white-space:nowrap}.scroll{overflow:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:#59828b #173541;min-height:0;padding:0 3px 25px;flex:1}
.chapter-tabs{display:flex;gap:8px;flex-shrink:0;overflow-x:auto;padding:3px 2px 6px}.chapter-tab{padding:12px 16px;border-radius:12px;white-space:nowrap;font-size:11px;min-height:44px;background:#1c4554}.chapter-tab.active{color:#183944;background:var(--gold);border-color:var(--gold)}
.chapter-head{display:flex;gap:14px;align-items:baseline;margin:0 0 18px;flex-wrap:wrap}.chapter-head h3{font-size:22px;font-weight:normal;margin:0}.chapter-head p{font-size:12px;color:var(--muted);margin:0 0 0 auto}.chapter-index{font-size:12px;color:var(--gold)}.campaign-note{font-size:12px;color:var(--muted);line-height:1.8;margin:0 0 19px}
.mission-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:15px}.mission-card{position:relative;border:1px solid #b7d4c237;border-radius:14px;overflow:hidden;text-align:left;min-height:177px;padding:0;background:#214452}
.mission-card canvas{width:100%;height:105px;display:block}.mission-card.locked canvas{opacity:.45;filter:saturate(.65)}.mission-card.locked .mission-card-body{opacity:.67}.mission-card-body{padding:12px 13px 15px}.mission-card .num{position:absolute;top:10px;left:10px;background:#123444e6;padding:5px 8px;border-radius:7px;font-size:12px;color:var(--cream)}
.mission-card .rating{position:absolute;top:10px;right:10px;font-size:10px;letter-spacing:1px;color:var(--gold);background:#123444e6;border-radius:7px;padding:6px}.mission-card h4{font-size:13px;margin:0 0 7px}.mission-card p{font-size:10px;margin:0;color:var(--muted);line-height:1.5}.mission-card.current{border:2px solid var(--gold);box-shadow:0 0 20px #ffd16b18}
#brief{display:flex;align-items:center;justify-content:center;padding:24px;background:#092838b3;backdrop-filter:blur(5px)}.brief-card{width:min(1050px,100%);max-height:100%;display:grid;grid-template-columns:1.2fr 1fr;background:#f1e8cc;color:#2d4042;border-radius:20px;overflow:hidden;box-shadow:var(--shadow);border:1px solid #f2e8c44d}.brief-left{padding:35px;overflow:auto;position:relative;background:repeating-linear-gradient(0deg,transparent,transparent 30px,#ad9a780a 31px),#f1e8cc}.paper-meta{display:flex;justify-content:space-between;font-size:9px;font-weight:bold;letter-spacing:1px;color:#857249;gap:12px}.brief-left h2{font-size:36px;line-height:1.16;margin:25px 0 10px;font-family:Georgia,serif;font-weight:normal}.brief-place{font-size:12px;color:#83704c;margin-bottom:21px}.brief-quote{font-family:Georgia,serif;font-size:17px;font-style:italic;line-height:1.6;color:#857148;margin:0 0 20px}.brief-story{font-size:14px;line-height:1.85;margin:0}.brief-disclaimer{font-size:10px;color:#877f66;line-height:1.6;margin-top:22px}
.brief-right{background:#1b4050;color:var(--cream);display:flex;flex-direction:column;min-height:0}.brief-map-wrap{height:200px;position:relative;overflow:hidden;flex-shrink:0;background:#367655}.brief-map-wrap canvas{width:100%;height:100%;display:block}.map-caption{position:absolute;bottom:11px;left:14px;font-size:9px;letter-spacing:1px;background:#173c4ce0;padding:7px 9px;border-radius:7px;color:var(--gold)}.brief-orders{padding:25px;display:flex;flex-direction:column;gap:16px;overflow:auto;flex:1}.brief-orders h3{font-size:10px;letter-spacing:2px;color:var(--gold);margin:0}.brief-orders p{font-size:12px;line-height:1.7;margin:0;color:#cce0d9}.brief-stats{display:flex;gap:23px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:14px 0}.brief-stats div{font-size:9px;color:var(--muted);letter-spacing:.5px}.brief-stats strong{display:block;font-size:25px;color:var(--cream);margin-bottom:4px;font-weight:normal}.brief-actions{display:flex;gap:9px;margin-top:auto}.brief-actions .primary{flex:1}.brief-tip{border-left:3px solid var(--gold);padding-left:12px}.no-perks-badge{font-size:10px;color:var(--green);padding:8px;border-radius:7px;background:#75e8b416}
#battle{display:flex;flex-direction:column;background:#143340}.topbar{height:65px;display:flex;align-items:center;padding:8px 18px;gap:20px;border-bottom:1px solid var(--line);background:#143747;z-index:2;flex-shrink:0}.battle-name{min-width:0;flex:1}.battle-name .eyebrow{font-size:9px;letter-spacing:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.battle-name h2{margin:5px 0 0;font-size:16px;font-weight:normal;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}.hud-stats{display:flex;gap:25px;align-items:center}.hud-stat{min-width:66px;display:flex;flex-direction:column;gap:3px}.hud-stat span{font-size:8px;color:var(--muted);letter-spacing:1px}.hud-stat strong{font-size:22px;letter-spacing:.5px;font-weight:bold;font-variant-numeric:tabular-nums}.hud-stat.money strong{color:var(--gold)}.hud-stat.danger strong{color:#ff8c78}.hud-controls{display:flex;gap:6px}.speed-btn{font-size:14px;font-weight:bold}
.field{position:relative;flex:1;min-height:0;overflow:hidden;background:#295148}#game{width:100%;height:100%;display:block;touch-action:none}.field-tag{position:absolute;top:12px;left:16px;pointer-events:none;font-size:9px;letter-spacing:1px;color:#f3f5db;text-shadow:0 1px 3px #193123;background:#174033c9;padding:7px 9px;border-radius:7px;max-width:72%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.field-tag span{color:#ffdd8a}
.next-info{position:absolute;bottom:10px;right:14px;color:#def1e5;font-size:10px;background:#173b44e0;border:1px solid #b9d0b52b;padding:8px 10px;border-radius:8px;pointer-events:none;max-width:75%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dock{display:flex;align-items:stretch;padding:10px 18px;gap:13px;height:115px;background:#143747;border-top:1px solid var(--line);z-index:3;flex-shrink:0}.tower-shop{display:flex;gap:8px;flex:1;min-width:0}.tower-card{position:relative;border-radius:11px;padding:3px 5px 7px;display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1;min-width:0;border-bottom:3px solid var(--type-color,var(--gold));background:#234a59}.tower-card canvas{width:78px;max-width:100%;height:51px;object-fit:contain;pointer-events:none}.tower-card .key{position:absolute;top:5px;left:7px;font-size:8px;color:#a7cbd0}.tower-card .name{font-size:11px;font-weight:bold;white-space:nowrap}.tower-card .cost{font-size:11px;color:var(--type-color,var(--gold));margin-top:3px}.tower-card.active{background:#4e746a;border-color:var(--gold);box-shadow:inset 0 0 0 1px var(--gold)}.tower-card.locked{opacity:.37}.tower-card.unaffordable:not(.locked){filter:saturate(.55)}.abilities{display:flex;gap:7px;padding-left:13px;border-left:1px solid var(--line)}.ability{min-width:78px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;border-radius:10px;padding:8px;background:#244b59}.ability svg{width:24px;height:24px;color:#a6ecd2}.ability span{font-size:10px}.ability small{font-size:10px;color:var(--gold)}.ability.aiming{border-color:var(--gold);background:#4a665c}.wave-button{border-radius:12px;min-width:150px;padding:10px 17px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px}.wave-button svg{width:24px;height:24px}.wave-button b{font-size:12px}.wave-button span{font-size:9px;font-weight:normal}
.selected-panel{position:absolute;right:14px;top:46px;width:257px;padding:17px;background:#143b4aed;border:1px solid #b4d9be58;border-radius:14px;box-shadow:var(--shadow);z-index:4}.selected-head{display:flex;align-items:center;justify-content:space-between;gap:7px}.selected-head strong{font-size:16px;color:var(--gold)}.selected-head .icon-btn{height:34px;min-width:34px;padding:8px}.selected-panel p{font-size:11px;color:#bcdbd3;line-height:1.65;margin:10px 0}.selected-values{display:flex;gap:13px;font-size:10px;color:var(--muted);margin:13px 0}.selected-values b{color:#f5f6dc}.selected-panel .btn{width:100%;min-height:43px;padding:10px;font-size:12px;margin-top:7px}.sell{color:#c5d5c9;background:transparent;font-weight:normal}
.tutorial{position:absolute;left:14px;top:48px;background:#123a4af2;border:1px solid #ffe19b;border-radius:14px;padding:16px;max-width:283px;font-size:12px;line-height:1.6;box-shadow:var(--shadow);z-index:5;pointer-events:none}.tutorial b{color:var(--gold);display:block;font-size:15px;margin-bottom:6px}.tutorial .guide-label{font-size:9px;letter-spacing:1px;color:var(--green);margin-bottom:8px}.tutorial .guide-close{pointer-events:auto;border:0;background:none;padding:8px 0 0;color:#bdcec6;font-size:10px;cursor:pointer}.guide-focus{outline:3px solid #ffe187!important;outline-offset:3px;box-shadow:0 0 20px #ffd16666!important}
.survival-loot{position:absolute;top:12px;right:14px;color:var(--gold);background:#173b44ed;padding:8px 11px;border-radius:8px;font-size:11px;display:flex;align-items:center;gap:6px}.survival-loot svg{width:17px;height:17px}.rotate-tip{display:none}
.mask{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:20px;background:#082938c9;backdrop-filter:blur(6px);z-index:20}.modal-box{width:min(630px,100%);max-height:100%;overflow:auto;background:#1a4050;border:1px solid #cae0c83c;border-radius:23px;padding:34px;box-shadow:var(--shadow)}.modal-box h2{font-size:34px;line-height:1.16;margin:12px 0 17px;font-weight:normal;font-family:Georgia,serif}.modal-box p{font-size:13px;line-height:1.8;color:#cce0d9;margin:12px 0}.modal-actions{display:flex;gap:10px;margin-top:24px;flex-wrap:wrap}.modal-actions .btn{flex:1;min-width:130px}.result-stars{font-size:34px;letter-spacing:6px;color:var(--gold);margin:14px 0}.result-numbers{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;border-block:1px solid var(--line);padding:18px 0;margin:20px 0}.result-numbers div{font-size:8px;letter-spacing:.7px;color:var(--muted);line-height:1.6}.result-numbers strong{display:block;font-size:24px;color:var(--cream);font-weight:normal}.reward-line{display:flex;gap:10px;align-items:center;padding:14px;background:#fed37114;border:1px solid #eac67a40;border-radius:13px;font-size:16px;color:var(--gold)}.reward-line svg{width:23px;height:23px}.reward-line .gem{color:var(--green);margin-left:12px}
.research-grid,.help-grid,.market-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.research-card,.help-card,.market-card{padding:24px;border:1px solid #bbd8c136;border-radius:17px;background:#214956}.research-card h3,.market-card h3{font-size:21px;font-weight:normal;margin:12px 0}.research-card p,.help-card p,.market-card p{font-size:12px;line-height:1.8;color:#c1d9d3;margin:10px 0 20px}.research-card .large-icon{height:40px;color:var(--gold)}.large-icon svg{width:34px;height:34px}.research-card .eyebrow{font-size:9px;margin-top:10px}.research-pips{display:flex;gap:5px;margin:20px 0}.research-pips i{height:6px;flex:1;background:#44626a;border-radius:3px}.research-pips i.on{background:var(--gold)}.research-card .btn{width:100%;font-size:12px}.help-grid{grid-template-columns:repeat(2,1fr)}.help-card h3{font-size:18px;color:var(--gold);margin:0 0 12px}.help-card p{margin:0 0 12px}.help-wide{grid-column:1/-1}.source-text{font-size:10px!important;word-break:break-word}.letters-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.journal-intro{font-family:Georgia,serif;font-size:23px;line-height:1.55;max-width:840px;margin:0 0 25px;color:#dfdcad}.letter-card{padding:22px;background:#efe7d0;color:#38494a;border-radius:13px;min-height:210px}.letter-card .eyebrow{font-size:9px;color:#9a8255}.letter-card h3{font-family:Georgia,serif;font-size:21px;font-weight:normal;margin:13px 0}.letter-card p{font-size:12px;line-height:1.9;margin:0}.letter-card.locked{background:#234957;color:#8caaa9}.letter-card.locked .eyebrow{color:#90a8a7}
.settings-wrap{max-width:750px;margin:0 auto;display:flex;flex-direction:column;gap:16px}.setting-card{padding:23px;background:#214956;border:1px solid var(--line);border-radius:16px}.setting-card h3{font-size:18px;color:var(--gold);margin:0 0 17px}.setting-row{display:flex;align-items:center;gap:15px;margin:17px 0;font-size:13px}.setting-row label{flex:1}.setting-row input[type=range]{width:45%;accent-color:var(--gold)}.setting-row output{width:40px;color:var(--green)}.setting-card p{font-size:12px;line-height:1.8;color:var(--muted)}textarea{width:100%;background:#122f3c;color:#d3ebdf;border:1px solid var(--line);border-radius:10px;padding:14px;font-family:monospace;font-size:11px;min-height:145px;resize:vertical}.settings-actions{display:flex;gap:10px;flex-wrap:wrap}.settings-actions .btn{font-size:11px}
.market-hero{background:linear-gradient(120deg,#225865,#32644f);border:1px solid #90e6b861;border-radius:19px;padding:30px;margin-bottom:22px;display:flex;gap:26px;align-items:center}.market-hero .large-icon{color:var(--green)}.market-hero .large-icon svg{width:64px;height:64px}.market-hero h3{font-size:23px;margin:0 0 12px;font-weight:normal}.market-hero p{font-size:12px;line-height:1.8;color:#c4ddd5;max-width:630px}.market-hero .btn{flex-shrink:0}.demo-label{display:inline-block;padding:6px 9px;border-radius:6px;color:#ffe6a1;border:1px solid #ffe6a151;font-size:9px;letter-spacing:1px}.swatches{display:flex;gap:8px;margin:20px 0}.swatches i{width:24px;height:24px;border-radius:7px;border:1px solid #ffffff66}.market-card .btn{width:100%;font-size:12px}.ad-demo{padding:27px;background:linear-gradient(140deg,#2a635a,#214956);border:1px solid #a4dac445;border-radius:16px;text-align:center;margin-top:20px}.ad-demo svg{width:55px;height:55px;color:var(--green)}.ad-progress{height:7px;border-radius:5px;overflow:hidden;background:#173941;margin-top:20px}.ad-progress i{display:block;height:100%;background:var(--green);width:0}.ad-count{font-size:13px;margin:12px;color:var(--gold)}
.survival-panel{max-width:920px;margin:0 auto}.survival-banner{padding:32px;background:linear-gradient(120deg,#245969,#396855);border:1px solid var(--line);border-radius:19px;margin-bottom:18px}.survival-banner h3{font-size:31px;margin:0 0 12px;font-weight:normal}.survival-banner p{font-size:13px;color:#cae2d5;line-height:1.8;max-width:650px}.survival-options{display:flex;gap:12px;flex-wrap:wrap;margin:20px 0}.survival-options select{color:var(--cream);padding:12px;background:#173b49;border:1px solid var(--line);border-radius:10px}.survival-preview{width:100%;height:auto;border-radius:13px;display:block}.survival-stats{display:flex;gap:22px;margin:20px 0;color:var(--gold)}.survival-stats b{display:block;font-size:28px}.survival-stats span{font-size:10px;color:var(--muted)}code{background:#0f3042;padding:3px 5px;border-radius:5px;color:var(--gold)}
#toast{position:absolute;bottom:130px;left:50%;transform:translateX(-50%);max-width:min(640px,90%);padding:13px 20px;border-radius:13px;background:#143b4af5;border:1px solid #bcd9c373;box-shadow:var(--shadow);color:#f1eed6;font-size:12px;line-height:1.6;text-align:center;z-index:30;pointer-events:none}
@media(min-width:1500px){.mission-grid{grid-template-columns:repeat(6,1fr)}.hero{transform:scale(1.05)}}
