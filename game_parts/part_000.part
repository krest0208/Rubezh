 .dock{height:113px;min-height:113px;padding:5px 7px;flex-wrap:wrap;gap:5px}.tower-shop{flex:1 1 100%;gap:4px}.tower-card{padding:2px;min-width:0}.tower-card canvas{width:50px;height:32px}.tower-card .name{font-size:8px}.tower-card .cost{font-size:9px}.abilities{border:0;flex:1;padding:0;gap:5px;height:32px}.ability{flex:1;min-width:0;flex-direction:row;padding:3px 6px;gap:7px}.ability svg{height:17px;width:17px}.ability span,.ability small{font-size:9px}
 .selected-panel{width:237px;top:56px;right:8px;max-height:calc(var(--app-height,100vh) - 185px)}.hud-folded .selected-panel{top:10px}.arsenal-grid{grid-template-columns:1fr}.arsenal-heading canvas{width:137px;height:91px}.arsenal-card{padding:16px}.arsenal-title h3{font-size:24px}.arsenal-title .eyebrow{font-size:9px}
 #brief{padding:9px}.brief-card{display:flex;flex-direction:column;width:100%;height:100%;max-height:750px;border-radius:14px}.brief-left{padding:18px;max-height:40%;flex:0 1 40%;overflow:auto}.brief-left h2{font-size:26px;margin:14px 0 8px}.brief-quote{font-size:13px;margin-bottom:10px}.brief-place{margin-bottom:9px}.brief-story{font-size:12px}.brief-disclaimer{margin-top:12px}.brief-right{display:flex;flex:1 1 60%;min-height:0}.brief-map-wrap{height:110px}.brief-orders{padding:14px;gap:10px;display:flex;overflow:auto}.brief-stats{padding:10px 0;gap:22px}.brief-actions{padding:10px 14px;gap:9px}.brief-actions .btn{font-size:13px}.brief-actions #deployBtn{font-size:16px;min-height:47px}
