/* V3 overrides: finite viewport, an always-present play CTA, independent panels. */
html,body,#app{height:100%;height:var(--app-height,100%);min-height:0}
#menu{padding:16px 24px;overflow:auto;overscroll-behavior:contain;padding-top:max(12px,env(safe-area-inset-top));padding-bottom:max(12px,env(safe-area-inset-bottom))}
.hero{width:100%;max-width:440px;margin:auto;padding:10px 0;transform:none;flex-shrink:0}
.hero-actions{width:100%;max-width:366px;gap:8px}.hero-kicker{margin-bottom:8px}.hero-copy{margin-bottom:16px}
#continueBtn{min-height:57px;width:100%;font-size:19px;letter-spacing:2px;border:1px solid #fff2b0;background:linear-gradient(110deg,#ffe290,#ffcb60);box-shadow:0 5px 0 #9a77482b,0 0 34px #efc37b24}
.play-caption{font-size:10px;color:#d3e8de;margin:0 0 4px;letter-spacing:.5px}
.hero h1{font-size:90px}.hero-subtitle{font-size:24px}.difficulty-line{margin-top:12px}.menu-progress{margin-top:9px}
.menu-button-row .btn{min-height:43px;padding:9px 10px;font-size:12px}.menu-button-row.three .btn{min-height:38px;font-size:10px}
.brief-card{height:auto;max-height:100%;min-height:0;overflow:hidden;grid-template-columns:1.1fr 1fr}
.brief-left{min-height:0;overflow:auto}.brief-right{min-height:0;overflow:hidden;display:flex;flex-direction:column}
.brief-orders{min-height:0;flex:1 1 auto;overflow:auto}.brief-actions{flex:0 0 auto;margin:0;padding:12px 20px;background:#163947;border-top:1px solid var(--line)}
#deployBtn{min-height:48px;font-size:16px;letter-spacing:1px}
#battle{min-height:0;padding-left:env(safe-area-inset-left);padding-right:env(safe-area-inset-right);padding-bottom:env(safe-area-inset-bottom)}
.topbar{height:52px;min-height:52px;flex:0 0 auto;padding:5px 16px}.hud-stats{gap:20px}.hud-stat strong{font-size:21px}.hud-stat span{font-size:8px}
.battle-name h2{font-size:15px}.battle-name .eyebrow{font-size:8px}.hud-controls .icon-btn{height:38px;min-width:38px}
.field{position:relative;min-height:0;flex:1 1 0;overflow:hidden}#game{width:100%;height:100%;touch-action:none}
.field-tag{display:none}.next-info{display:none}.rotate-tip{display:none}.survival-loot{top:8px;right:10px;font-size:10px;padding:5px 9px;pointer-events:none}
.commandbar{height:50px;min-height:50px;flex:0 0 auto;display:flex;align-items:stretch;justify-content:center;gap:8px;padding:5px 12px;background:#113442;border-top:1px solid #6c9c9a40;z-index:5}
.fold-btn{width:44px;min-width:44px;border-radius:9px;font-size:23px;line-height:1;background:#254e5c;padding:0}.fold-btn:hover{background:#396573}
.commandbar .wave-button{display:flex;flex-direction:row;align-items:center;justify-content:center;min-width:140px;max-width:230px;flex:1;padding:6px 15px;gap:8px;border-radius:9px}
.commandbar .wave-button b{font-size:11px;white-space:nowrap}.commandbar .wave-button svg{width:17px;height:17px}.commandbar .wave-button span{display:none}
.auto-wave{min-width:144px;max-width:210px;flex:1;padding:4px 12px;border-radius:9px;background:#284851;border-color:#6d8b903f;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px}.auto-wave b{font-size:11px;letter-spacing:.7px}.auto-wave small{font-size:9px;color:#c1d9d0}.auto-wave.on{background:#285c50;border-color:#83dca475;color:#b5f6c7}
.mini-stats{align-self:center;font-size:11px;color:#ffe1a0;white-space:nowrap;min-width:94px;text-align:center}
.dock{height:88px;min-height:0;flex:0 0 auto;padding:6px 12px;display:flex;flex-wrap:nowrap;gap:10px;justify-content:center;background:#163b48;border-top:1px solid #567e7e33}
.tower-shop{display:flex;flex:1;max-width:850px;min-width:0;gap:6px;width:auto}.tower-card{flex:1;min-width:0;padding:2px 2px 4px;border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center}.tower-card canvas{width:68px;height:44px}.tower-card .key{display:none}.tower-card .name{font-size:10px}.tower-card .cost{font-size:10px;margin-top:1px}.tower-card.active{box-shadow:0 0 0 2px var(--type-color);border-color:var(--type-color)}
.abilities{display:flex;padding-left:9px;flex:0 0 auto;gap:6px;width:auto}.ability{min-width:75px;flex:0 0 auto;display:flex;flex-direction:column;gap:2px;justify-content:center;padding:6px}.ability svg{height:21px;width:21px}.ability span,.ability small{font-size:9px}
#battle.hud-folded .topbar{display:none}#battle.dock-folded .dock{display:none}
.selected-panel{position:fixed;top:64px;right:max(12px,env(safe-area-inset-right));width:254px;max-height:calc(var(--app-height,100vh) - 162px);overflow:auto;z-index:9;padding:13px;border:1px solid #d2e6b970;background:#173e4bf5;box-shadow:0 10px 34px #03243270}
.selected-head strong{font-size:15px}.selected-head small{font-size:11px;color:#cfddd0}.selected-head .icon-btn{height:33px;min-width:33px;padding:3px;font-size:26px}.selected-values{display:flex;justify-content:space-between;font-size:9px;gap:6px;margin:10px 0}.selected-values b{display:block;font-size:11px;margin-top:3px}.selected-panel .btn{font-size:11px;min-height:42px;padding:9px 6px}.selected-panel details{font-size:11px;margin-top:10px}.selected-panel summary{cursor:pointer;color:#b3d0c9;padding:7px 0}.selected-panel details p{font-size:11px;line-height:1.6}.selected-panel details .btn{width:100%}
.level-track{display:flex;gap:4px;margin:10px 0}.level-track i{height:6px;background:#405b63;border-radius:3px;flex:1;border:1px solid #69887e44}.level-track .filled{background:var(--accent,#ffd77e);border-color:#fff0b177}.level-track .available{background:#819980}.level-track .sealed{background:#14303c}
.arsenal-tabs{display:flex;gap:8px;margin-bottom:17px}.arsenal-tabs .btn{min-height:44px;font-size:12px}.arsenal-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.arsenal-card{padding:18px;border-radius:17px;border:1px solid #9cbeb636;background:linear-gradient(120deg,#244c56,#1d414e);min-width:0}.arsenal-heading{display:flex;align-items:center;gap:8px}.arsenal-heading canvas{width:130px;height:86px;flex-shrink:0}.arsenal-title h3{font-size:21px;margin:7px 0;font-weight:normal}.arsenal-title .eyebrow{font-size:8px;letter-spacing:1px;color:var(--accent)}.arsenal-title p{font-size:9px;letter-spacing:1px;color:var(--muted)}.branch-intro{font-size:10px;color:#bcd4cd;margin:16px 0 10px}.branch-summary{display:flex;gap:8px;margin-bottom:18px}.branch-summary>div{background:#153a4799;border:1px solid #6b8e9133;border-radius:9px;flex:1;padding:10px}.branch-summary b{display:block;font-size:13px;color:var(--accent);font-weight:normal}.branch-summary span{display:block;font-size:9px;color:#b6cfc6;margin-top:4px;line-height:1.5}.arsenal-card>.btn{width:100%;font-size:11px}
.branch-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:15px 0}.branch-card{display:flex;flex-direction:column;align-items:flex-start;padding:15px;border:1px solid #c4ddaa69;border-radius:14px;text-align:left;background:#285460}.branch-card canvas{width:100%;height:95px;object-fit:contain}.branch-card>.eyebrow{font-size:8px;letter-spacing:.7px}.branch-card>strong{font-size:24px;color:#ffdc88;margin:8px 0}.branch-card>span:last-child{font-size:11px;line-height:1.6;color:#d8e7db}.branch-card:hover{border-color:var(--gold);background:#376575}.v3-guide{margin-bottom:25px}.v3-guide canvas{display:block;margin-bottom:10px}
.tutorial{top:8px;left:10px;max-height:calc(100% - 16px);overflow:auto;max-width:260px;padding:12px;z-index:8}.tutorial .guide-close{min-height:33px}.tutorial b{font-size:13px}.tutorial .guide-label{font-size:8px}
#toast{bottom:145px;max-width:90%;font-size:11px;line-height:1.6}#battle.dock-folded~#toast{bottom:58px}
.modal-box{width:100%;max-width:690px}.mask{padding:12px}.page{min-height:0}
@media(max-width:1100px){.arsenal-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.arsenal-heading canvas{width:110px;height:77px}.arsenal-title h3{font-size:19px}}
@media(max-width:650px){
 #menu{padding-left:12px;padding-right:12px}.hero{padding:12px 4px}.hero h1{font-size:80px}.hero-actions{max-width:352px}.hero-copy{margin-bottom:13px}.hero-subtitle{font-size:23px}.menu-top .wallet-chip{padding:7px;font-size:10px}.menu-top .brandmark>span{font-size:10px}.brand-sub{display:none}.menu-bottom{font-size:7px;letter-spacing:.4px}
 .topbar{height:46px;min-height:46px;padding:4px 9px;gap:6px}.hud-stat strong{font-size:17px}.hud-stat span{font-size:7px}.hud-stats{gap:12px;flex:1;justify-content:space-around}.hud-stat{min-width:40px}.hud-controls{gap:4px}.hud-controls .icon-btn{height:35px;min-width:34px;padding:8px}.sound-button{display:none}
