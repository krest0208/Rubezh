@media(max-width:600px) and (orientation:portrait){
 #menu{gap:7px}#menu .menu-top{padding:9px 12px;min-height:58px}#menu .menu-top-right{gap:4px}#menu .wallet-chip{font-size:12px;padding:9px 8px}#menu .brandmark>span{font-size:18px;letter-spacing:2px}#menu .menu-top .icon-btn{width:35px;height:35px;min-width:35px;padding:7px}#menu .hero{width:344px;padding:25px 27px 24px;max-width:calc(100% - 30px)}#menu .hero h1{font-size:59px}#menu .hero-subtitle{font-size:12px;margin-bottom:23px}#menu .hero .btn,#menu .hero #continueBtn{font-size:17px;min-height:50px}#menu .menu-progress{margin-top:23px;font-size:9px}#menu .menu-bottom{padding:7px 12px}#menu .menu-bottom .campaign-era{font-size:7px;letter-spacing:.5px;max-width:45%}#menu .language-select{max-width:135px;min-width:105px;font-size:11px}#menu .language-control{gap:4px}
 .page{padding:12px 10px;gap:10px}.page-head h2{font-size:23px}.page-head .tag{font-size:9px}.page>.scroll{padding:14px 12px;border-width:3px}.chapter-tabs{gap:3px;overflow:auto}.chapter-tab{min-width:60px;font-size:10px;padding:7px 4px;gap:3px;flex-direction:column}.chapter-tab small{font-size:8px}.chapter-head h3{font-size:24px}.chapter-head p{font-size:12px}.sheet-navigation{gap:5px}.sheet-navigation label{display:none}.sheet-navigation .btn{padding:6px 10px;min-height:36px}.sheet-navigation select{max-width:135px;min-height:36px;font-size:11px}.sheet-navigation .sheet-current{margin:0;flex:1;font-size:10px;padding:6px}.route-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:13px 11px;padding:18px 10px}.route-node{min-height:61px}.route-node .node-number{font-size:19px}.route-node .node-stars{font-size:8px}.map-meta{padding:9px 10px;font-size:9px}.operations-key{padding:12px 10px;font-size:10px;gap:10px}.operations-key .btn{min-width:87px;font-size:12px;padding:8px}.campaign-note{font-size:10px}.letters-grid{grid-template-columns:1fr}
 #battle{--rack:calc(100vw - 46px)}#battle .topbar{top:8px;left:8px;right:8px}.hud-controls #battleSound{display:none}#battle .hud-stat{min-width:61px;padding:6px 7px}#battle .hud-stat strong{font-size:14px}#battle .hud-stat span{font-size:7px}#battle .hud-controls{gap:4px}#battle .hud-controls .icon-btn{width:33px;height:37px;min-width:33px;padding:7px}#battle #toggleHud{left:199px;top:8px;height:41px;width:22px;min-width:22px}#battle #miniStats{left:8px;top:8px;min-width:163px;font-size:11px;gap:5px;height:37px;padding:7px}#battle.hud-folded #toggleHud{left:186px;height:37px}
 #battle .battle-name{top:50px;max-width:calc(100vw - 78px)}#battle .battle-name h2{font-size:11px}#battle .battle-name .eyebrow{font-size:8px}#battle #nextInfo{top:83px;left:9px;transform:none;max-width:calc(100% - 67px);font-size:9px;padding:5px 7px}
 #battle #towerShop{left:10px;right:auto;transform:none;bottom:10px;width:var(--rack);padding:4px;gap:0}#battle .tower-card{height:75px;padding:0 0 4px}#battle .tower-card canvas{width:49px;height:39px}#battle .tower-card .name{font-size:7px}#battle .tower-card .cost{font-size:10px}#battle .tower-card .key{display:none}#battle #toggleDock{left:auto;right:10px;bottom:10px;height:85px;width:24px;min-width:24px}#battle.dock-folded #toggleDock{left:calc(50% - 20px);right:auto;height:36px}
 #battle .abilities{left:10px;bottom:109px;gap:6px}#battle .ability{width:53px;height:67px}#battle .ability span{font-size:8px}#battle .ability small{font-size:9px}#battle #waveBtn{right:10px;bottom:109px;width:143px;height:42px;min-height:42px;font-size:12px}#battle #autoWaveBtn{right:10px;bottom:159px;width:143px;height:30px;min-height:30px;font-size:10px}
